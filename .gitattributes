# Capture.xcodeproj/project.pbxproj is generated by
# apps/mobile/Capture/scripts/generate_project.rb (which rm -rf's the whole
# .xcodeproj) yet is tracked in git. Two branches that each add a Swift file
# produce two independently-hashed renderings whose PBXBuildFile/PBXFileReference
# blocks git will sometimes merge cleanly into an internally inconsistent file.
# -merge forces a loud conflict; resolution is ALWAYS regeneration, never a hand edit.
apps/mobile/Capture/Capture.xcodeproj/project.pbxproj -merge -diff
