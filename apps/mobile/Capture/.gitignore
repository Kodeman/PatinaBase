# Secrets (real anon key) — copy Secrets.example.swift → Secrets.swift
Capture/App/Configuration/Secrets.swift

# Build-time secret (PostHog key etc.) — copy Secrets.xcconfig.example →
# Secrets.xcconfig. #include?d by the committed BuildSettings.xcconfig.
Capture/App/Configuration/Secrets.xcconfig

# Xcode user state / build
*.xcuserdatad
xcuserdata/
.build/
DerivedData/
*.xcscmblueprint
*.xccheckout

# Generated project is rebuilt by scripts/generate_project.rb; the implicit
# workspace is a build artifact. Its SwiftPM lockfile (Package.resolved) is NOT:
# it is tracked so Field builds against one dependency graph on every machine,
# and generate_project.rb carries it across the rebuild. Git cannot re-include a
# file under an ignored directory, hence the ignore-contents/re-include chain.
Capture.xcodeproj/project.xcworkspace/*
!Capture.xcodeproj/project.xcworkspace/xcshareddata/
Capture.xcodeproj/project.xcworkspace/xcshareddata/*
!Capture.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Capture.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Capture.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
