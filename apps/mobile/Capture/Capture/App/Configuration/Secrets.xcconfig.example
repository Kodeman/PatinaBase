//  Secrets.xcconfig.example
//  Capture
//
//  Optional. BuildSettings.xcconfig already commits the real public
//  PostHog project key, so a fresh checkout ships with analytics enabled
//  without this file. Copy this to Secrets.xcconfig (gitignored, same
//  directory) only if you want to override that key locally — e.g. to
//  point a build at a different PostHog project. BuildSettings.xcconfig
//  #include?s this file, so setting POSTHOG_API_KEY here makes it into
//  Info.plist (via its literal $(POSTHOG_API_KEY) entry) ->
//  AppConfiguration.postHogAPIKey in EVERY build, archives included — see
//  BuildSettings.xcconfig's header for why that matters (FC-R14).
//
//  This is a build-setting file, not Swift — no quotes around the value.

POSTHOG_API_KEY = phc_REPLACE_WITH_POSTHOG_PROJECT_KEY
