                </button>
              </div>
            </div>
          </li>
          <li
            class="border-b border-[var(--doc-ink-border)]"
          >
            <div
              class="flex items-center gap-2 py-2"
            >
              <button
                aria-describedby="DndDescribedBy-0"
                aria-disabled="false"
                aria-label="Reorder Terms"
                aria-roledescription="sortable"
                class="cursor-grab px-1 font-mono text-[12px] text-[var(--text-faint)] disabled:cursor-default"
                role="button"
                tabindex="0"
                type="button"
              >
                ⠿
              </button>
              <button
                class="flex-1 text-left text-[var(--color-mocha)]"
                type="button"
              >
                <span
                  class="block font-mono text-[10.5px] uppercase tracking-[0.1em] text-[var(--ink-subtle)]"
                >
                  Clause
                </span>
                <span
                  class="block text-[13px]"
                >
                  Terms
                  <span
                    aria-label="Required"
                    class="ml-1.5 text-[var(--color-clay-ink)]"
                    title="Required"
                  >
                    ·
                  </span>
                </span>
              </button>
              <div
                class="relative"
              >
                <button
                  aria-expanded="false"
                  aria-label="Part options for Terms"
                  class="px-2 font-mono text-[13px] text-[var(--ink-subtle)]"
                  type="button"
                >
                  ⋯
                </button>
              </div>
            </div>
          </li>
        </ul>
        <div
          id="DndDescribedBy-0"
          style="display: none;"
        >
          
    To pick up a draggable item, press the space bar.
    While dragging, use the arrow keys to move the item.
    Press space again to drop the item in its new position, or press escape to cancel.
  
        </div>
        <div
          aria-atomic="true"
          aria-live="assertive"
          id="DndLiveRegion-0"
          role="status"
          style="position: fixed; top: 0px; left: 0px; width: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hidden; clip-path: inset(100%); white-space: nowrap;"
        />
        <div
          class="space-y-1"
        >
          <button
            class="type-btn-text inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[3px] cursor-pointer transition-all disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-primary)] focus-visible:ring-offset-1 bg-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] px-4 py-[0.45rem] text-[0.78rem]"
            type="button"
          >
            + Add a part
          </button>
          <button
            class="type-btn-text inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[3px] cursor-pointer transition-all disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-primary)] focus-visible:ring-offset-1 bg-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] px-4 py-[0.45rem] text-[0.78rem]"
            type="button"
          >
            Start from a template…
          </button>
          <div
            class="space-y-1"
          >
            <button
              class="type-btn-text inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[3px] cursor-pointer transition-all disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-primary)] focus-visible:ring-offset-1 bg-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] px-4 py-[0.45rem] text-[0.78rem]"
              type="button"
            >
              Save as template…
            </button>
          </div>
        </div>
      </nav>
      <div
        class="space-y-6"
      >
        <section
          aria-label="Services editor"
          class="space-y-4"
        >
          <header>
            <p
              class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--color-aged-oak)]"
            >
              Clause
            </p>
            <h2
              class="mt-1 font-heading text-[1.25rem] italic text-[var(--color-charcoal)]"
            >
              Services
            </h2>
          </header>
          <label
            class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--color-aged-oak)]"
          >
            Body
            <textarea
              class="flex w-full rounded-[3px] border border-[var(--border-default)] bg-[var(--bg-surface)] px-3 py-2 text-[0.85rem] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-primary)] focus:ring-1 focus:ring-[var(--accent-primary)] disabled:opacity-50 mt-2 min-h-40 normal-case tracking-normal"
              placeholder="The language the client reads and signs."
              style="font-family: var(--font-body);"
            >
              Interior design services.
            </textarea>
          </label>
        </section>
      </div>
      <aside
        class="space-y-6"
      >
        <section
          aria-label="Agreement readiness"
          class="border-t border-[var(--doc-ink-border)] pt-4"
        >
          <p
            class="font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--ink-subtle)]"
          >
            0
             of 
            5
             parts need attention
          </p>
        </section>
        <div
          class="hidden min-[1180px]:block"
        >
          <div
            class="sticky top-[82px] rounded-[8px] border border-[var(--doc-ink-border)] bg-white px-5 py-5"
          >
            <p
              class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--ink-subtle)]"
            >
              The client's copy · live
            </p>
            <div>
              Agreement preview
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
`;
