            >
              Allowances
            </h2>
          </header>
          <div
            class="border border-[var(--doc-ink-border)] px-4 py-3"
          >
            <p
              class="font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-aged-oak)]"
            >
