          </button>
          <button
            class="type-btn-text inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[3px] cursor-pointer transition-all disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-primary)] focus-visible:ring-offset-1 bg-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] px-4 py-[0.45rem] text-[0.78rem]"
            type="button"
          >
            Start from a template…
          </button>
          <div
            class="space-y-1"
          >
            <button
              class="type-btn-text inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[3px] cursor-pointer transition-all disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-primary)] focus-visible:ring-offset-1 bg-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] px-4 py-[0.45rem] text-[0.78rem]"
              type="button"
            >
