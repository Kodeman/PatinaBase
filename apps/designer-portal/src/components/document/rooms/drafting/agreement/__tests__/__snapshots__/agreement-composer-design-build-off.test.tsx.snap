            </button>
          </div>
        </div>
      </nav>
      <div
        class="space-y-6"
      >
        <section
          aria-label="Allowances editor"
          class="space-y-4"
        >
          <header>
            <p
              class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--color-aged-oak)]"
