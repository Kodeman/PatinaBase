{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patina-designer-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "minify": true,
  // esbuild keepNames wraps every function in __name() purely to preserve names that
  // webpack's server minification already mangled — pure size overhead. Disabling it
  // keeps the worker under Cloudflare's 62 MiB traversal limit (hit 2026-07-10).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // NEXT_PUBLIC_SUPABASE_STORAGE_KEY (below): pinned auth-cookie storage key
  // (Workstream D-B1). Without this pin, @supabase/ssr derives the cookie
  // name from NEXT_PUBLIC_SUPABASE_URL's host (`sb-<host-first-label>-auth-token`).
  // If that URL is ever repointed (e.g. to api.patina.cloud) while the
  // underlying Supabase project stays the same, the derived name would
  // silently change — logging out every session cookie in the wild and
  // breaking the extension's independent re-derivation. Value here is the
  // CURRENT derived value for this env's Supabase project.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://bkvcixdmuyejfzcijpdg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJrdmNpeGRtdXllamZ6Y2lqcGRnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgyNjg0MzIsImV4cCI6MjA4Mzg0NDQzMn0.SPl6jHaeTp9McfF-AmXJUDKTwRaXD7Qf0hlve72rVg0",
    "NEXT_PUBLIC_SUPABASE_STORAGE_KEY": "sb-bkvcixdmuyejfzcijpdg-auth-token",
    "SUPABASE_URL": "https://bkvcixdmuyejfzcijpdg.supabase.co",
    "NEXT_PUBLIC_APP_URL": "https://app.patina.cloud",
    "NEXT_PUBLIC_CLIENT_PORTAL_URL": "https://client.patina.cloud",
    "NEXT_PUBLIC_ENV": "production",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_D6Rf7ZYD5L7cTCgP1aBIV6kgANIFGnsbEgoYPXpsaNG",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "NEXT_PUBLIC_CAPTURE_EXTENSION_INSTALL_MODE": "under_review",
    "NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS": "apple",
    "ORDERS_SERVICE_URL": "https://patina-orders-worker.kody-be3.workers.dev",
    "MEDIA_SERVICE_URL": "https://patina-media-svc-worker.kody-be3.workers.dev",
    "PROJECTS_SERVICE_URL": "https://patina-projects-worker.kody-be3.workers.dev",
    // D-repoint wiring only — the browser Supabase-traffic repoint itself is
    // NOT active yet (that's SUPABASE_ORIGIN_RUNTIME, added at flip time).
    // This just gives the portal the edge-API host to point at once flipped.
    //
    // IMPORTANT: this is a wrangler-vars-only value — it is INVISIBLE to
    // `next build` (NEXT_PUBLIC_* is inlined at build time by reading
    // process.env / .env files, never wrangler.jsonc). The deploy
    // invocation must ALSO `export NEXT_PUBLIC_EDGE_API_URL=https://api.patina.cloud`
    // before running `infra/deploy-portal.sh designer production`, or the
    // build inlines an empty value and the read path below stays dark
    // despite this var being set here.
    //
    // Exporting it and deploying ACTIVATES the in-portal scan read path —
    // packages/supabase/src/hooks/use-splat-url.ts and use-render-shots.ts
    // gate on this exact var, so setting it makes those hooks go live
    // against api.patina.cloud (SCAN_ROUTES on the prod edge worker). That
    // activation is an INTENDED deliverable of this D-repoint deploy
    // (Kody-ruled scope), not an accidental side effect — see PR #34's
    // description.
    "NEXT_PUBLIC_EDGE_API_URL": "https://api.patina.cloud",
    // THE FLIP (D-B4 designer, activated 2026-08-25, Kody-GO'd): runtime-resolved
    // browser Supabase origin. The head script in layout.tsx reads this at request
    // time and sets globalThis.__PATINA_SUPABASE_ORIGIN, repointing all BROWSER
    // Supabase traffic (REST/auth/functions/realtime) through the edge worker.
    // STORAGE stays on the direct host via pinStorageDirect (packages/supabase).
    // ROLLBACK: delete this var + `npx wrangler deploy` of the same bundle
    // (drilled 2026-08-25: 36s wall including propagation + verification).
    "SUPABASE_ORIGIN_RUNTIME": "https://api.patina.cloud"
  },
  "services": [
    { "binding": "SVC_PROJECTS", "service": "patina-projects-worker" },
    { "binding": "SVC_ORDERS", "service": "patina-orders-worker" },
    { "binding": "SVC_MEDIA", "service": "patina-media-svc-worker" }
  ],
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://vuesoyhfrjabfxbrzekd.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ1ZXNveWhmcmphYmZ4YnJ6ZWtkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4NzYwNjYsImV4cCI6MjEwMjQ1MjA2Nn0.Fi64Lk7N6vo_t37NKo8ZGQtBko96BBPye-8zwbJWDh4",
        // Staging is a SEPARATE Supabase project (vuesoyhfrjabfxbrzekd), not a
        // repoint of prod — pin its own current derived value so staging auth
        // behavior is unchanged by D-B1 (see the top-level vars comment).
        "NEXT_PUBLIC_SUPABASE_STORAGE_KEY": "sb-vuesoyhfrjabfxbrzekd-auth-token",
        "SUPABASE_URL": "https://vuesoyhfrjabfxbrzekd.supabase.co",
        "NEXT_PUBLIC_APP_URL": "https://patina-designer-portal-staging.kody-be3.workers.dev",
        "NEXT_PUBLIC_CLIENT_PORTAL_URL": "https://patina-client-portal-staging.kody-be3.workers.dev",
        "NEXT_PUBLIC_ENV": "staging",
        "NEXT_PUBLIC_POSTHOG_KEY": "",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "NEXT_PUBLIC_CAPTURE_EXTENSION_INSTALL_MODE": "disabled",
        "NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS": "",
        "ORDERS_SERVICE_URL": "https://patina-orders-worker-staging.kody-be3.workers.dev",
        "MEDIA_SERVICE_URL": "https://patina-media-svc-worker-staging.kody-be3.workers.dev",
        "PROJECTS_SERVICE_URL": "https://patina-projects-worker-staging.kody-be3.workers.dev",
        // This is a wrangler-vars-only value — INVISIBLE to `next build` —
        // so the staging deploy invocation must also `export
        // NEXT_PUBLIC_EDGE_API_URL=...` for it to take effect (same
        // mechanism as the prod vars block above; see its comment for the
        // read-path-activation implications there).
        "NEXT_PUBLIC_EDGE_API_URL": "https://patina-edge-api-staging.kody-be3.workers.dev",
        // The R2 S3 endpoint the capability URLs are presigned against — must
        // match infra/edge-api-worker/wrangler.jsonc's SCAN_R2_ENDPOINT for the
        // same environment, or SPLAT is CSP-blocked (see next.config.js). Read
        // ONLY by next.config.js's connect-src at build time, so it must also be
        // exported on the build path; a wrangler-vars-only value is invisible to
        // `next build`, exactly as for NEXT_PUBLIC_EDGE_API_URL above.
        "NEXT_PUBLIC_SCAN_R2_ENDPOINT": "https://be3aaeed18a81b5d90ee2263b62219ea.r2.cloudflarestorage.com",
        // PostHog is disabled in staging (empty key, above) — the flag would
        // otherwise resolve fail-closed and hide Room View/Room File entirely.
        // Same override mechanism playwright.config.ts uses for CI.
        "NEXT_PUBLIC_FLAG_OVERRIDES": "room-file:true"
      },
      "services": [
        { "binding": "SVC_PROJECTS", "service": "patina-projects-worker-staging" },
        { "binding": "SVC_ORDERS", "service": "patina-orders-worker-staging" },
        { "binding": "SVC_MEDIA", "service": "patina-media-svc-worker-staging" }
      ]
    }
  }
}
