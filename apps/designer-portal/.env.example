# ============================================
# PATINA DESIGNER PORTAL - ENVIRONMENT VARIABLES
# ============================================
# SECURITY: Never commit .env files with real credentials to version control

# --------------------------------------------
# Supabase Configuration (Required)
# --------------------------------------------
# Public Supabase URL and anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side JWT-issuer scoping (required when the public URL is a proxy host).
# SUPABASE_PROJECT_REF is NOT set here — it is not consumed by this portal's
# own code (the auth cookie name is pinned via NEXT_PUBLIC_SUPABASE_STORAGE_KEY
# above, not derived from the project ref; Workstream D-B1).
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Pinned auth-cookie storage key (Workstream D-B1). Without this pin,
# @supabase/ssr derives the cookie name from NEXT_PUBLIC_SUPABASE_URL's host
# (`sb-<host-first-label>-auth-token`). If that URL is ever repointed (e.g.
# to api.patina.cloud) while the underlying Supabase project stays the same,
# the derived name would change and silently log out every session cookie in
# the wild (and break the extension's independent re-derivation). Value below
# is the CURRENT derived value for prod (bkvcixdmuyejfzcijpdg) — same literal
# is the in-code fallback in packages/supabase/src/client.ts, so this line is
# documentation, not required for local dev to function.
NEXT_PUBLIC_SUPABASE_STORAGE_KEY=sb-bkvcixdmuyejfzcijpdg-auth-token

# Production:
# NEXT_PUBLIC_SUPABASE_URL=https://api.patina.cloud
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_JWT_ISSUER=https://bkvcixdmuyejfzcijpdg.supabase.co/auth/v1

# Server-side only — service role key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------
# Backend Service URLs (Server-side Only)
# --------------------------------------------
# Used by Next.js API routes to proxy to retained NestJS services
# NOT exposed to the browser (no NEXT_PUBLIC_ prefix)
ORDERS_SERVICE_URL=http://localhost:3015
MEDIA_SERVICE_URL=http://localhost:3014
PROJECTS_SERVICE_URL=http://localhost:3016

# --------------------------------------------
# Application URLs
# --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3002

# Production:
# NEXT_PUBLIC_APP_URL=https://app.patina.cloud
# NEXT_PUBLIC_CLIENT_PORTAL_URL=https://client.patina.cloud

# --------------------------------------------
# PostHog Analytics (Optional)
# --------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Selected-designer Chrome extension beta. Leave unset to fail closed.
# Use "unpacked" with the hosted development ZIP, then switch to "webstore"
# after the unlisted Chrome Web Store beta is approved.
NEXT_PUBLIC_CAPTURE_EXTENSION_INSTALL_MODE=
NEXT_PUBLIC_CAPTURE_EXTENSION_INSTALL_URL=

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
NEXT_PUBLIC_ENABLE_TEACHING=true
NEXT_PUBLIC_ENABLE_CAMPAIGNS=true
NEXT_PUBLIC_ENABLE_ROOM_SCANS=true
NEXT_PUBLIC_ENABLE_INSIGHTS=true
NEXT_PUBLIC_ENABLE_MESSAGING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# --------------------------------------------
# Real-time Communication (Optional)
# --------------------------------------------
# Supabase Realtime is used by default for real-time features.
# WebSocket URL only needed for the projects NestJS service (Socket.IO)
NEXT_PUBLIC_WS_URL=ws://localhost:3016
NEXT_PUBLIC_ENABLE_REAL_TIME=true

# Production:
# NEXT_PUBLIC_WS_URL=wss://api.patina.cloud/projects

# --------------------------------------------
# Media & CDN (Optional)
# --------------------------------------------
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_MEDIA_BUCKET=media

# --------------------------------------------
# OAuth Providers
# --------------------------------------------
# Comma-separated list of enabled OAuth providers. Defaults to 'apple'.
# Set to 'apple,google' once the Google provider is properly configured in Supabase.
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=apple

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_ENV=development
