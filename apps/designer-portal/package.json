{
  "name": "@patina/designer-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Patina Designer Portal - Designer onboarding, catalog management, and project collaboration",
  "scripts": {
    "sync-pdf-worker": "node scripts/sync-pdf-worker.mjs",
    "predev": "pnpm run sync-pdf-worker",
    "prebuild": "pnpm run sync-pdf-worker",
    "dev": "next dev --webpack -p 3000",
    "dev:network": "HOST=0.0.0.0 next dev --webpack",
    "dev:network-setup": "../../scripts/setup-network-dev.sh && npm run dev:network",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:library": "playwright test e2e/library-configuration --project=chromium --workers=1",
    "clean": "rm -rf .next",
    "analyze": "ANALYZE=true next build --webpack"
  },
