{
  "name": "@patina/extension",
  "displayName": "Patina Capture",
  "version": "0.1.0",
  "description": "Capture furniture products for your Patina catalog",
  "author": "Patina",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@patina/catalog-ui": "workspace:*",
    "@patina/shared": "workspace:*",
    "@plasmohq/storage": "^1.15.0",
    "@supabase/supabase-js": "^2.43.0",
    "plasmo": "^0.90.5",
    "posthog-js": "^1.356.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vitest": "^4.0.17"
  },
  "alias": {
    "react": "./node_modules/react/index.js",
    "react-dom": "./node_modules/react-dom/index.js",
    "react/jsx-runtime": "./node_modules/react/jsx-runtime.js",
    "react/jsx-dev-runtime": "./node_modules/react/jsx-dev-runtime.js",
    "react-dom/client": "./node_modules/react-dom/client.js"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "cookies",
      "storage",
      "contextMenus",
      "scripting",
      "sidePanel",
      "alarms"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "commands": {
      "capture-product": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "Capture the current page with Patina"
      }
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "web_accessible_resources": [
      {
        "resources": ["tesseract/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }
}
