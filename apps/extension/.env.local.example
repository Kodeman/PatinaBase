PLASMO_PUBLIC_SUPABASE_URL=your-project-url
PLASMO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PLASMO_PUBLIC_PORTAL_URL=https://app.patina.cloud

# Pinned auth-cookie storage key (Workstream D-B1). The extension used to
# re-derive the portal's auth cookie name from PLASMO_PUBLIC_SUPABASE_URL's
# host (`sb-<host-first-label>-auth-token`) — a separate, independent
# re-derivation from the portals' own. If either URL were ever repointed
# without both sides changing in lockstep, portal-session pairing would
# silently break. Value below is the CURRENT derived value for prod
# (bkvcixdmuyejfzcijpdg) — same literal is the in-code fallback in
# apps/extension/src/lib/supabase.ts, so this line is documentation, not
# required for the extension to function.
PLASMO_PUBLIC_SUPABASE_STORAGE_KEY=sb-bkvcixdmuyejfzcijpdg-auth-token

# PostHog Analytics
PLASMO_PUBLIC_POSTHOG_KEY=
PLASMO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
