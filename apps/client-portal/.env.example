# ============================================
# PATINA CLIENT PORTAL - ENVIRONMENT VARIABLES
# ============================================
# SECURITY: Never commit .env files with real credentials to version control

# --------------------------------------------
# Supabase Configuration (Required)
# --------------------------------------------
# Public Supabase URL and anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Production:
# NEXT_PUBLIC_SUPABASE_URL=https://api.patina.cloud
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# Server-side only — service role key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------
# Backend Service URLs (Server-side Only)
# --------------------------------------------
# Used by Next.js API routes to proxy to retained NestJS services
# NOT exposed to the browser (no NEXT_PUBLIC_ prefix)
MEDIA_SERVICE_URL=http://localhost:3014
PROJECTS_SERVICE_URL=http://localhost:3016

# Coolify: Use container names for inter-service communication
# MEDIA_SERVICE_URL=http://media:3014
# PROJECTS_SERVICE_URL=http://projects:3016

# --------------------------------------------
# Application URLs
# --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=Patina Client Portal

# Production:
# NEXT_PUBLIC_APP_URL=https://client.patina.cloud

# --------------------------------------------
# QR Auth (Cross-origin to designer portal)
# --------------------------------------------
NEXT_PUBLIC_QR_AUTH_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_QR_AUTH_URL=https://app.patina.cloud

# --------------------------------------------
# WebSocket - Projects service (Socket.IO)
# --------------------------------------------
# DEPRECATED: project realtime now runs over Supabase Realtime (broadcast +
# presence on private `project:<id>` channels), not the projects Socket.io
# server. NEXT_PUBLIC_WS_URL is unused; the client uses NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_WS_URL=http://localhost:3016
NEXT_PUBLIC_WS_NAMESPACE=/projects

# Production:
# NEXT_PUBLIC_WS_URL=wss://api.patina.cloud/projects

# --------------------------------------------
# Media & CDN (Optional)
# --------------------------------------------
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_MEDIA_BUCKET=media

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_MEDIA_GALLERIES=true
NEXT_PUBLIC_ENABLE_APPROVAL_THEATER=true
NEXT_PUBLIC_ENABLE_MILESTONE_CELEBRATIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# --------------------------------------------
# OAuth Providers
# --------------------------------------------
# Comma-separated list of enabled OAuth providers. Defaults to 'apple'.
# Set to 'apple,google' once the Google provider is properly configured in Supabase.
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=apple

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_ENV=development
# Defaults to live Supabase reads. Set to "fixtures" only for an intentional
# local demo; query failures never fall back to sample projects.
NEXT_PUBLIC_CLIENT_PORTAL_DATA_MODE=live

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
