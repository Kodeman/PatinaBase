# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
coverage/
test-results/
playwright-report/

# Plasmo (extension)
.plasmo/

# Python
__pycache__/
*.pyc
venv/
.mypy_cache/

# Storybook
storybook-static/

# Supabase
supabase/.temp/

# Infrastructure secrets
infra/secrets.txt
infra/.env
infra/.env.swp
infra/coolify/.env.coolify

# iOS app local secrets (Secrets.example.swift is the committed template)
apps/mobile/Patina/Patina/App/Configuration/Secrets.swift

# iOS app generated build-stamp (rewritten by the "Stamp Git SHA" phase
# on every Debug build; Release builds leave sha empty)
apps/mobile/Patina/Patina/Generated/GitCommit.swift

# iOS xcuserdata — per-user Xcode state, not source of truth
apps/mobile/Patina/Patina.xcodeproj/project.xcworkspace/xcuserdata/
apps/mobile/Patina/Patina.xcodeproj/xcuserdata/

# Misc
*.log
npm-debug.log*
pnpm-debug.log*

infra/seed-credentials.md
infra/coolify/prod-env-snapshot.txt
infra/coolify/coolify-env-*.txt
infra/coolify/missing-coolify-vars.md

# Cloudflare Workers local dev secrets
*.dev.vars

# Local agent / scheduler state
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/runs/
.build/

# Recovery sidecars from git lost-found
.recovery/

# Mobile per-tool agent caches
apps/mobile/Patina/.agents/
apps/mobile/Patina/.blitz/
apps/mobile/Patina/.claude/
apps/mobile/Patina/.codex/

# Repo-root scratch
_tmp_*
_test_reports/

# Env backups (contain secrets — never commit)
*.env.bak*
infra/.env.bak*
infra/.env.env.bak*
infra/.env.*.bak*
