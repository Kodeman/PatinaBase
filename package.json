{
  "name": "patina-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Patina - Custom Home Furnishing Platform",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --concurrency=20",
    "dev:minimal": "turbo run dev --filter=@patina/designer-portal --filter=@patina/orders --filter=@patina/media --filter=@patina/projects",
    "dev:designer": "turbo run dev --filter=@patina/designer-portal --filter=@patina/orders --filter=@patina/media --filter=@patina/projects",
    "dev:admin": "turbo run dev --filter=@patina/admin-portal --filter=@patina/orders --filter=@patina/media",
    "dev:client": "turbo run dev --filter=@patina/client-portal --filter=@patina/orders --filter=@patina/projects",
    "dev:frontend": "turbo run dev --filter='@patina/*-portal'",
    "dev:backend": "turbo run dev --filter='./services/*'",
    "build": "turbo run build",
    "build:no-cache": "turbo run build --no-cache",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:skills": "node scripts/lint-skills.mjs",
    "verify:affected": "bash scripts/verify-affected.sh",
    "legacy:check": "node scripts/check-retired-deploy-references.mjs",
    "hooks:test": "node --test scripts/hooks/*.test.mjs",
    "hooks:policy": "node scripts/hooks/patina-hooks.mjs policy --staged --strict",
    "hooks:verify": "node scripts/hooks/patina-hooks.mjs verify --run",
    "hooks:audit": "node scripts/hooks/patina-hooks.mjs audit",
    "dev:seed-room-fixture": "node scripts/dev/seed-room-scan-fixture.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:cache": "turbo run clean && rm -rf .turbo node_modules",
    "db:generate": "pnpm --filter @patina/supabase generate",
    "db:push": "pnpm --filter @patina/supabase push",
    "db:studio": "pnpm --filter @patina/supabase studio",
    "supabase:start": "cd supabase && supabase start",
    "supabase:stop": "cd supabase && supabase stop",
    "supabase:reset": "cd supabase && supabase db reset",
    "supabase:migration:new": "cd supabase && supabase migration new",
    "prisma:generate": "pnpm --filter @patina/orders exec prisma generate && pnpm --filter @patina/media exec prisma generate && pnpm --filter @patina/projects exec prisma generate",
    "prisma:push": "pnpm --filter @patina/orders exec prisma db push && pnpm --filter @patina/media exec prisma db push && pnpm --filter @patina/projects exec prisma db push",
    "seed:fulfillment": "deno run -A scripts/seed-fulfillment-orders.ts",
    "test:library-config": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/library/product_configuration_test.sql",
    "test:boh-audit": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/functions/_tests/fulfillment_foundation.assert.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/functions/_tests/fulfillment_queue_bands.assert.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/functions/_tests/fulfillment_transmission.assert.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/functions/_tests/fulfillment_ledger_walk.assert.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/functions/_tests/fulfillment_exceptions.assert.sql && deno test --no-check -A --node-modules-dir=auto supabase/functions/_tests/fulfillment-*.test.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.107.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@react-email/render": "1.1.2",
      "next": "~16.2.6",
      "react@^19.0.0": "19.2.8",
      "react-dom@^19.0.0": "19.2.8",
      "three": "0.180.0",
      "@types/three": "0.180.0"
    }
  }
}
