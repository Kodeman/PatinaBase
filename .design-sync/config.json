    "Input": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" },
    "Flex": { "cardMode": "column" },
    "Grid": { "cardMode": "column" },
    "Breadcrumbs": { "cardMode": "column" },
    "Navbar": { "cardMode": "column" },
    "Pagination": { "cardMode": "column" },
    "Stepper": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
