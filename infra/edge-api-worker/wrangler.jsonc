{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "patina-edge-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // SUPABASE_ANON_KEY and health service-token values are Wrangler/.dev.vars
  // secrets. ACCESS_TEAM_DOMAIN and ACCESS_AUDIENCE are added with the Access app.
  "vars": {
    "SUPABASE_UPSTREAM_URL": "http://127.0.0.1:54321",
    "SUPABASE_JWT_ISSUER": "http://127.0.0.1:54321/auth/v1",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "SUPABASE_JWKS_URL": "http://127.0.0.1:54321/auth/v1/.well-known/jwks.json",
    "CATALOG_SOURCE": "legacy",
    "CATALOG_HYPERDRIVE_PERCENT": "0",
    "LEGACY_FETCH_TIMEOUT_MS": "3000",
    "COMPATIBILITY_FETCH_TIMEOUT_MS": "10000",
    "WEBSOCKET_HANDSHAKE_TIMEOUT_MS": "5000",
  },
  // Phase 1 Wave 2 inserts DB_FRESH and DB_PUBLIC_CACHE after Wrangler returns
  // the real Hyperdrive IDs. Empty bindings keep legacy compatibility mode
  // deployable. CATALOG_SOURCE may only leave "legacy" once both bindings are
  // listed here: config:check and validateRuntimeConfig both reject a promoted
  // source with an unprovisioned binding.
  "hyperdrive": [],
  "env": {
    "local": {
      "name": "patina-edge-api-local",
      "workers_dev": true,
      "vars": {
        "SUPABASE_UPSTREAM_URL": "http://127.0.0.1:54321",
        "SUPABASE_JWT_ISSUER": "http://127.0.0.1:54321/auth/v1",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "SUPABASE_JWKS_URL": "http://127.0.0.1:54321/auth/v1/.well-known/jwks.json",
        "CATALOG_SOURCE": "legacy",
        "CATALOG_HYPERDRIVE_PERCENT": "0",
        "LEGACY_FETCH_TIMEOUT_MS": "3000",
        "COMPATIBILITY_FETCH_TIMEOUT_MS": "10000",
        "WEBSOCKET_HANDSHAKE_TIMEOUT_MS": "5000",
      },
      // Add both real binding IDs here. Each local binding also gets
      // localConnectionString=postgresql://postgres:postgres@127.0.0.1:54322/postgres.
      // Promote CATALOG_SOURCE in the same edit that adds the IDs; a promoted
      // source with hyperdrive: [] now fails config:check and boots 503.
      "hyperdrive": [],
    },
    "staging": {
      "name": "patina-edge-api-staging",
      "workers_dev": true,
      "vars": {
        "SUPABASE_UPSTREAM_URL": "http://127.0.0.1:54321",
        "SUPABASE_JWT_ISSUER": "http://127.0.0.1:54321/auth/v1",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "SUPABASE_JWKS_URL": "http://127.0.0.1:54321/auth/v1/.well-known/jwks.json",
        "CATALOG_SOURCE": "legacy",
        "CATALOG_HYPERDRIVE_PERCENT": "0",
        "LEGACY_FETCH_TIMEOUT_MS": "3000",
        "COMPATIBILITY_FETCH_TIMEOUT_MS": "10000",
        "WEBSOCKET_HANDSHAKE_TIMEOUT_MS": "5000",
      },
      // Replace the local-only URLs and add both real staging Hyperdrive IDs
      // after the persistent branch is provisioned. No staging branch exists yet.
      // Promote CATALOG_SOURCE in the same edit that adds the IDs; a promoted
      // source with hyperdrive: [] now fails config:check and boots 503.
      "hyperdrive": [],
    },
    "production": {
      "name": "patina-edge-api",
      "workers_dev": true,
      "vars": {
        "SUPABASE_UPSTREAM_URL": "https://bkvcixdmuyejfzcijpdg.supabase.co",
        "SUPABASE_JWT_ISSUER": "https://bkvcixdmuyejfzcijpdg.supabase.co/auth/v1",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "SUPABASE_JWKS_URL": "https://bkvcixdmuyejfzcijpdg.supabase.co/auth/v1/.well-known/jwks.json",
        "CATALOG_SOURCE": "legacy",
        "CATALOG_HYPERDRIVE_PERCENT": "0",
        "LEGACY_FETCH_TIMEOUT_MS": "3000",
        "COMPATIBILITY_FETCH_TIMEOUT_MS": "10000",
        "WEBSOCKET_HANDSHAKE_TIMEOUT_MS": "5000",
      },
      // Add DB_FRESH=strata-prod-fresh and DB_PUBLIC_CACHE=strata-prod-public-cache
      // using the literal IDs returned by Cloudflare provisioning, then enable shadowing.
      // Promote CATALOG_SOURCE in the same edit that adds the IDs; a promoted
      // source with hyperdrive: [] now fails config:check and boots 503.
      "hyperdrive": [],
    },
  },
}
