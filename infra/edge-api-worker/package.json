{
  "name": "patina-edge-api-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare edge router and typed API for Patina",
  "scripts": {
    "config:check": "node scripts/validate-config.mjs",
    "config:check:provisioned": "node scripts/validate-config.mjs --provisioned",
    "deploy": "npm run config:check && wrangler deploy --env=\"\"",
    "dev": "wrangler dev --env local",
    "test": "vitest run --config vitest.config.mts",
    "test:workerd": "vitest run --config vitest.workerd.config.mts",
    "test:all": "npm test && npm run test:workerd",
    "type-check": "npm run types && tsc --noEmit",
    "types": "npm run config:check && wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars=false --include-runtime=false",
    "deploy:dry-run": "npm run config:check && wrangler deploy --dry-run --env=\"\""
  },
  "dependencies": {
    "jose": "^6.1.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260815.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.123.0"
  }
}
