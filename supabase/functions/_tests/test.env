# Fake, non-secret local keys for the edge-function test harness (stripe-rail).
# Consumed by: supabase functions serve --env-file supabase/functions/_tests/test.env
STRIPE_SECRET_KEY=sk_test_stripe_rail_fake_do_not_use
STRIPE_WEBHOOK_SECRET=whsec_test123
CLIENT_PORTAL_URL=http://localhost:3002
DESIGNER_PORTAL_URL=http://localhost:3000
# dry_run: sendCompliantEmail logs "[send-email:dry_run]" and returns success
# without hitting Resend (the bare value "true" resolves to "off", which throws
# on the missing RESEND_API_KEY). Lets the direct_order receipt/ops emails run
# as a clean dry-run without a live key.
EMAIL_DEV_MODE=dry_run
# Ops fulfillment heads-up recipient for paid direct orders (dry-run here).
OPS_NOTIFY_EMAIL=ops@example.test
