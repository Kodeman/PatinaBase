(pg_temp.uid(2),'f8941000-0000-4000-8000-000000000001','member','active'),
(pg_temp.uid(4),'f8941000-0000-4000-8000-000000000002','owner','active');
INSERT INTO public.user_roles(user_id,role_id,granted_by)
SELECT p.id,r.id,p.id FROM public.profiles p CROSS JOIN public.roles r
WHERE p.id::text LIKE 'f8940000-%' AND r.name='studio_owner';
