-- C4 household-card signer identity (00894, SQ-2352 / review SQ-2351 R1):
-- the profile a household card links to NOW lists the request, reads its
-- evidence and answers the card's slot, exactly like a profile signer. The
-- enclosing runner owns BEGIN/ROLLBACK.
--
-- Actors: studio A owner 1; client 5 (profile slot "client"); 6 linked to the
-- required "co_client" card; 8 linked to a household card that is no signer;
-- 9 a profile the co_client card is re-pointed to; 10 the would-be user of the
-- unlinked optional "guest" card. Reads and responses run as authenticated,
-- with respond granted here only (the activation path); link edits run as the
-- designer through studio_contacts RLS.
CREATE TEMP TABLE assertion_count(n integer NOT NULL);
INSERT INTO assertion_count VALUES (0);
GRANT ALL ON assertion_count TO authenticated;
CREATE FUNCTION pg_temp.assert_true(ok boolean, name text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',name; END IF;
  UPDATE assertion_count SET n=n+1;
  RAISE NOTICE 'PASS: %',name;
END $$;
CREATE FUNCTION pg_temp.expect_error(command text, state text, message text, name text)
RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
  BEGIN EXECUTE command;
  EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
  END;
  PERFORM pg_temp.assert_true(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
    name||format(' [expected %s/%s, got %s/%s]',state,message,actual_state,actual_message));
END $$;
-- A call that must succeed: its result, or the error it raised, so a refusal
-- fails a named assertion instead of aborting the run.
CREATE FUNCTION pg_temp.attempt(command text) RETURNS jsonb LANGUAGE plpgsql AS $$
DECLARE result jsonb; actual_state text; actual_message text;
BEGIN
  EXECUTE command INTO result;
  RETURN jsonb_build_object('ok',result);
EXCEPTION WHEN OTHERS THEN
  GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
  RETURN jsonb_build_object('error',actual_state,'message',actual_message);
END $$;
CREATE FUNCTION pg_temp.uid(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
  SELECT ('f8940000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.card(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
  SELECT ('f8946000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claim.sub',CASE WHEN n IS NULL THEN '' ELSE pg_temp.uid(n)::text END,true);
  PERFORM set_config('request.jwt.claims',CASE WHEN n IS NULL THEN '' ELSE jsonb_build_object('sub',pg_temp.uid(n),
    'role','authenticated')::text END,true);
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.assert_true(boolean,text),pg_temp.expect_error(text,text,text,text),
  pg_temp.attempt(text),pg_temp.actor(integer),pg_temp.uid(integer),pg_temp.card(integer) TO authenticated;

-- Fixture: studio A (1 owner, 2 member), studio B (4 owner); client 5; six
-- person cards in the client's household (co_client card linked to 6, the
-- guest card unlinked, another member's card linked to 8).
SELECT pg_temp.assert_true(NOT EXISTS(SELECT 1 FROM auth.users WHERE id::text LIKE 'f8940000-%'),'fixture starts absent');
SET LOCAL session_replication_role=replica;
INSERT INTO auth.users(id,email,encrypted_password,email_confirmed_at,created_at,updated_at,aud,role)
SELECT pg_temp.uid(n),'household-identity-'||n||'@test.invalid','',now(),now(),now(),'authenticated','authenticated'
FROM generate_series(1,10) n;
INSERT INTO public.profiles(id,email,full_name,is_designer)
SELECT id,email,'Household identity fixture',true FROM auth.users WHERE id::text LIKE 'f8940000-%';
INSERT INTO public.organizations(id,type,name,slug,status) VALUES
('f8941000-0000-4000-8000-000000000001','design_studio','Household A','household-identity-a','active'),
('f8941000-0000-4000-8000-000000000002','design_studio','Household B','household-identity-b','active');
