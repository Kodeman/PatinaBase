(pg_temp.card(1),'f8941000-0000-4000-8000-000000000001','person','client','Client',pg_temp.uid(5)),
(pg_temp.card(2),'f8941000-0000-4000-8000-000000000001','person','client','Co-client',pg_temp.uid(6)),
(pg_temp.card(3),'f8941000-0000-4000-8000-000000000001','person','client','Guest card',NULL),
(pg_temp.card(4),'f8941000-0000-4000-8000-000000000001','person','client','Other member',pg_temp.uid(8)),
(pg_temp.card(5),'f8941000-0000-4000-8000-000000000001','person','client','Spare card',NULL),
(pg_temp.card(6),'f8941000-0000-4000-8000-000000000001','person','client','Replacement card',NULL);
INSERT INTO public.client_households(id,organization_id,designer_id,display_name,member_person_ids) VALUES
('f8947000-0000-4000-8000-000000000001','f8941000-0000-4000-8000-000000000001',pg_temp.uid(1),'Identity household',
