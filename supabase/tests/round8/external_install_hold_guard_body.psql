(pg_temp.ih_id(301),'pkg.client','pkg.client','included','{"design":"studio","purchasing":"client","payer":"client","fabrication_contract":"none","installation":"client"}');
INSERT INTO public.designer_clients(id,designer_id,client_id,status)
VALUES(pg_temp.ih_id(901),pg_temp.ih_id(1),pg_temp.ih_id(7),'active');
INSERT INTO public.client_decisions(id,designer_client_id,designer_id,project_id,title,status,court,coordination_kind)
SELECT pg_temp.ih_id(600+n),pg_temp.ih_id(901),pg_temp.ih_id(1),pg_temp.ih_id(201),'IH evidence','pending','designer','submittal'
FROM generate_series(1,3)n;
INSERT INTO public.coordination_item_revisions(id,decision_id,rev_number,status)
SELECT pg_temp.ih_id(700+n),pg_temp.ih_id(600+n),1,'submitted' FROM generate_series(1,3)n;
INSERT INTO public.project_packages(id,project_id,package_kind,code,title,package_key,created_by,idempotency_key,request_hash)
VALUES(pg_temp.ih_id(801),pg_temp.ih_id(201),'cabinetry','IH','Fabrication','pkg.cabinets',pg_temp.ih_id(1),'ih','fixture');
INSERT INTO public.project_parties(id,project_id,profile_id,party_kind,stage,display_name,created_by)
VALUES(pg_temp.ih_id(811),pg_temp.ih_id(201),pg_temp.ih_id(7),'gc','active','IH seat',pg_temp.ih_id(1));
INSERT INTO public.plan_sheets(id,project_id,sheet_number,title) VALUES(pg_temp.ih_id(821),pg_temp.ih_id(201),'IH-1','Fabrication');
INSERT INTO public.plan_prints(id,sheet_id,batch_id,print_number,rev_letter,project_document_id,sha256)
VALUES(pg_temp.ih_id(822),pg_temp.ih_id(821),pg_temp.ih_id(823),1,'A',pg_temp.ih_id(824),repeat('a',64));
UPDATE public.plan_sheets SET current_print_id=pg_temp.ih_id(822),current_print_number=1 WHERE id=pg_temp.ih_id(821);
