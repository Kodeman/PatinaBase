-- Include-only. 00900 (RC7-E4-1): no external installation while a hold is
-- open, or while a contracted unit is uninstructed. All rows roll back.
-- BEGIN shared helpers
CREATE FUNCTION pg_temp.ih_assert(ok boolean,label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',label; END IF;
 RAISE NOTICE 'PASS: %',label;
END $$;
CREATE FUNCTION pg_temp.ih_error(command text,state text,message text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
 BEGIN EXECUTE command;
 EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
 END;
 PERFORM pg_temp.ih_assert(actual_state=state AND (message IS NULL OR actual_message=message),
 label||format(' expected %s/%s got %s/%s',state,message,actual_state,actual_message));
END $$;
CREATE FUNCTION pg_temp.ih_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
 SELECT ('e9a00000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.ih_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 PERFORM set_config('request.jwt.claim.sub',pg_temp.ih_id(n)::text,true);
 PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.ih_id(n),'role','authenticated')::text,true);
END $$;
-- END shared helpers
SELECT pg_temp.ih_assert(NOT (SELECT enabled FROM public.server_capabilities WHERE key='scope_editions'),'capability remains inactive');
DO $$ DECLARE signature text; BEGIN
 FOREACH signature IN ARRAY ARRAY['_external_install_blocker(uuid)','_external_refresh_status(uuid)',
 'record_external_fulfilment_event(uuid,text,jsonb,text[],text)','verify_external_fulfilment_event(uuid,text)'] LOOP
  PERFORM pg_temp.ih_assert(NOT has_function_privilege('anon','public.'||signature,'EXECUTE')
   AND NOT has_function_privilege('authenticated','public.'||signature,'EXECUTE')
   AND NOT has_function_privilege('service_role','public.'||signature,'EXECUTE')
   AND NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc WHERE oid=('public.'||signature)::regprocedure)) WHERE grantee=0 AND privilege_type='EXECUTE'),
   'inactive effective ACL '||signature);
 END LOOP;
END $$;
-- BEGIN shared fixture (fabrication_instruction_body's, plus a client-bought package)
SELECT pg_temp.ih_assert(NOT EXISTS(SELECT 1 FROM auth.users WHERE id::text LIKE 'e9a0%'),'fictional fixture namespace starts empty');
SET LOCAL session_replication_role=replica;
INSERT INTO auth.users(id,email,encrypted_password,email_confirmed_at,created_at,updated_at,aud,role)
SELECT pg_temp.ih_id(n),'ih-'||n||'@test.invalid','',now(),now(),now(),'authenticated','authenticated' FROM generate_series(1,7)n;
INSERT INTO public.profiles(id,email,full_name,is_designer) SELECT id,email,'00900 fictional fixture',true FROM auth.users WHERE id::text LIKE 'e9a0%';
INSERT INTO public.organizations(id,type,name,slug,status) VALUES(pg_temp.ih_id(101),'design_studio','IH A','e9a0-ih-a','active');
INSERT INTO public.organization_members(user_id,organization_id,role,status) VALUES
(pg_temp.ih_id(1),pg_temp.ih_id(101),'owner','active'),(pg_temp.ih_id(2),pg_temp.ih_id(101),'admin','active');
