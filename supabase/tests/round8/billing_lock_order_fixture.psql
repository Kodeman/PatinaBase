VALUES('f8826000-0000-4000-8000-000000000001','adhoc','Service retainer',1,2500,2500,
 '{"kind":"design_services_retainer","commercialDocumentId":"f8825000-0000-4000-8000-000000000003"}');
SET LOCAL session_replication_role = origin;
