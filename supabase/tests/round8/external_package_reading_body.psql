UPDATE public.evidence_manifest_members mm SET id=pg_temp.ep_id(6000-frozen.ord::integer)
 FROM public.evidence_manifests m,jsonb_array_elements(m.members) WITH ORDINALITY frozen(member,ord)
 WHERE m.id=mm.manifest_id AND m.id=pg_temp.ep_manifest('manifest-old')
 AND to_jsonb(mm)->>((member->>'kind')||'_id')=member->>'id';
SET LOCAL session_replication_role=origin;
SELECT public.create_evidence_manifest(pg_temp.ep_id(201),pg_temp.ep_id(801),'fabrication_instruction',pg_temp.ep_members(822),'manifest-new');
GRANT EXECUTE ON FUNCTION pg_temp.ep_id(integer),pg_temp.ep_actor(integer),pg_temp.ep_assert(boolean,text),pg_temp.ep_error(text,text,text) TO authenticated,anon;
CREATE TEMP TABLE ep_first_read AS SELECT public.get_project_external_fulfilments(pg_temp.ep_id(201)) AS value;
GRANT SELECT ON ep_first_read TO authenticated;
SET LOCAL ROLE authenticated;
SELECT pg_temp.ep_assert(jsonb_array_length(public.get_project_external_fulfilments(pg_temp.ep_id(201)))=2,'authorized owner reads only this project');
DO $$ DECLARE rows jsonb; item jsonb; events jsonb; m jsonb; BEGIN
 rows:=public.get_project_external_fulfilments(pg_temp.ep_id(201));
 SELECT value INTO item FROM jsonb_array_elements(rows) WHERE value->>'id'=pg_temp.ep_id(401)::text;
 events:=item->'reading'->'events';
 PERFORM pg_temp.ep_assert(jsonb_array_length(events)=6,'authoritative package includes complete ordered native evidence');
 PERFORM pg_temp.ep_assert((SELECT jsonb_array_length(value->'reading'->'events')=1002
  FROM jsonb_array_elements(rows) WHERE value->>'id'=pg_temp.ep_id(402)::text),
  'sibling evidence stays separate with no hidden thousand-row cap');
 PERFORM pg_temp.ep_assert(item->>'package_key'='pkg.cabinets' AND item->>'status'='planned'
  AND item->'reported_price_cents'='null'::jsonb AND item->'units'='["k-1","k-2"]', 'existing header facts preserved without inferred status');
 PERFORM pg_temp.ep_assert(item->>'client_request_id'='fulfilment-1' AND item->>'request_hash'='fixture'
  AND NOT (item ? 'reading_package_id'),'header preserves retry fields without internal package alias');
 PERFORM pg_temp.ep_assert(events->1->>'recorded_by'=pg_temp.ep_id(1)::text AND events->1->>'verified_by'=pg_temp.ep_id(2)::text
  AND events->1->'actor_id'='null'::jsonb AND events->5->>'actor_id'=pg_temp.ep_id(1)::text
  AND events->5->'verified_by'='null'::jsonb AND events->5->>'evidence_level'='reported','recorder actor verifier and reported instruction stay distinct');
 PERFORM pg_temp.ep_assert((SELECT array_agg((value->>'event_seq')::integer ORDER BY ordinality)=ARRAY[1,2,3,4,5,6]
  FROM jsonb_array_elements(events) WITH ORDINALITY),'event sequence order never timestamp order');
 PERFORM pg_temp.ep_assert(events->2->'affected_units'='["k-1"]'::jsonb AND events->3->'affected_units'='["k-2"]'::jsonb
  AND events->4->>'releases_event_id'=events->2->>'id' AND events->4->'affected_units'='null'::jsonb,'independent partial holds retain native release link');
 PERFORM pg_temp.ep_assert(jsonb_array_length(item->'reading'->'bindings')=1 AND jsonb_array_length(item->'reading'->'verifications')=2
  AND item->'reading'->'verifications'->0->>'verified_by'=events->1->>'verified_by','bindings and genuine verification receipt agree');
 PERFORM pg_temp.ep_assert(jsonb_array_length(item->'reading'->'manifests')=1,'only referenced manifest not newer live package evidence');
 m:=item->'reading'->'manifests'->0;
 PERFORM pg_temp.ep_assert(m->>'id'=events->5->>'manifest_id' AND m->>'manifest_hash'=events->5->>'manifest_hash'
  AND jsonb_array_length(m->'typed_members')=3 AND jsonb_array_length(m->'members')=3,'instruction retains exact immutable manifest members and hash');
 PERFORM pg_temp.ep_assert(EXISTS(SELECT 1 FROM jsonb_array_elements(m->'members') x WHERE x->>'kind'='plan_issue'
  AND x->>'id'=pg_temp.ep_id(821)::text AND x->>'sha256'=repeat('1',64)),'newer issue never replaces old pinned issue hash');
 PERFORM pg_temp.ep_assert(position('PRIVATE_BODY_NOT_FOR_READER' IN rows::text)=0
  AND NOT (events->0 ? 'request_hash') AND NOT (m ? 'idempotency_key'),'private body and retry metadata not projected');
 PERFORM pg_temp.ep_assert(events->0->>'id'>events->1->>'id'
  AND events->0->>'recorded_at'>events->1->>'recorded_at','event UUID and timestamp orders differ from sequence');
 PERFORM pg_temp.ep_assert(item->'reading'->'verifications'->0->>'event_id'=pg_temp.ep_id(1005)::text
  AND item->'reading'->'verifications'->1->>'event_id'=pg_temp.ep_id(1003)::text,
  'receipts follow verification sequence not event UUID');
 PERFORM pg_temp.ep_assert(NOT EXISTS(SELECT 1 FROM jsonb_array_elements(m->'members') WITH ORDINALITY frozen(member,ord)
  WHERE m->'typed_members'->(ord::integer-1)->>((member->>'kind')||'_id') IS DISTINCT FROM member->>'id'),
  'typed members follow frozen canonical member order');
END $$;
SELECT pg_temp.ep_assert(public.get_project_external_fulfilments(pg_temp.ep_id(201))=(SELECT value FROM ep_first_read),'deterministic order across separate statements');
SELECT pg_temp.ep_assert(public.get_project_external_fulfilments(pg_temp.ep_id(202))='[]'::jsonb,'real empty success remains empty');
