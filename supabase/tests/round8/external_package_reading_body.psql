-- Include-only fictional read fixture. No activation, public SQL stubs or financial rows.
-- The current reader is 00887, a verbatim copy of the 00884 body except the
-- authority conjunct (00887:74–75). Citations of 00884 line numbers name the
-- unchanged original bytes.
-- N2 redundant disjuncts in 00884_round8_external_package_reading.sql:
-- :59 f.reading_package_id IS NULL is subsumed by the package identity comparison
-- (00884:59): a missing package is reachable, but cannot decide refusal alone.
-- A fabrication manifest has a non-NULL package (00877_round8_evidence_manifests.sql:138,
-- 00884:60 purpose check; manifest FK 00879_round8_fabrication_instruction.sql:41–43).
-- :68 v.fulfilment_id IS DISTINCT FROM f.id duplicates receipt validation :104;
-- :69 v.verified_by IS DISTINCT FROM e.verified_by duplicates :105.
CREATE FUNCTION pg_temp.ep_assert(ok boolean,label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',label; END IF;
 RAISE NOTICE 'PASS: %',label;
END $$;
CREATE FUNCTION pg_temp.ep_error(command text,state text,message text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual text; actual_message text;
BEGIN
 BEGIN EXECUTE command; EXCEPTION WHEN OTHERS THEN
  GET STACKED DIAGNOSTICS actual=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
 END;
 PERFORM pg_temp.ep_assert(actual=state AND actual_message=message,
  label||format(' expected (%s, %s) got (%s, %s)',state,message,actual,actual_message));
END $$;
CREATE FUNCTION pg_temp.ep_success(command text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual text;
BEGIN
 BEGIN EXECUTE command; EXCEPTION WHEN OTHERS THEN actual=SQLSTATE; END;
 PERFORM pg_temp.ep_assert(actual IS NULL,label||coalesce(' got SQLSTATE '||actual,''));
END $$;
CREATE FUNCTION pg_temp.ep_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
 SELECT ('f8840000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.ep_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 PERFORM set_config('request.jwt.claim.sub',pg_temp.ep_id(n)::text,true);
 PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.ep_id(n),'role','authenticated')::text,true);
END $$;
INSERT INTO public.server_capabilities(key, enabled) VALUES ('scope_editions', false)
 ON CONFLICT (key) DO NOTHING;
SELECT pg_temp.ep_assert(NOT (SELECT enabled FROM public.server_capabilities WHERE key='scope_editions'),'writers remain inactive');
DO $$ DECLARE t text; signature text; BEGIN
 FOREACH t IN ARRAY ARRAY['project_external_fulfilments','project_external_fulfilment_events',
 'project_external_fulfilment_evidence_bindings','project_external_fulfilment_verifications','evidence_manifest_members'] LOOP
  PERFORM pg_temp.ep_assert(NOT has_table_privilege('authenticated','public.'||t,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE')
   AND NOT has_table_privilege('anon','public.'||t,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE'),'direct tables denied: '||t);
 END LOOP;
 FOREACH signature IN ARRAY ARRAY['record_external_fulfilment_event(uuid,text,jsonb,text[],text)',
 'record_fabrication_instruction(uuid,uuid,uuid,text[],jsonb,uuid)','verify_external_fulfilment_event(uuid,text)'] LOOP
  PERFORM pg_temp.ep_assert(NOT has_function_privilege('authenticated','public.'||signature,'EXECUTE')
   AND NOT has_function_privilege('service_role','public.'||signature,'EXECUTE'),'writers stay ungranted: '||signature);
 END LOOP;
 PERFORM pg_temp.ep_assert(has_function_privilege('authenticated','public.get_project_external_fulfilments(uuid)','EXECUTE')
  AND NOT has_function_privilege('anon','public.get_project_external_fulfilments(uuid)','EXECUTE')
  AND NOT has_function_privilege('service_role','public.get_project_external_fulfilments(uuid)','EXECUTE')
  AND NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc
   WHERE oid='public.get_project_external_fulfilments(uuid)'::regprocedure)) WHERE grantee=0 AND privilege_type='EXECUTE'),
  'reader retains authenticated-only execute');
 PERFORM pg_temp.ep_assert((SELECT prosecdef AND provolatile='s' AND 'search_path=public, pg_temp'=ANY(proconfig)
  FROM pg_proc WHERE oid='public.get_project_external_fulfilments(uuid)'::regprocedure),'stable definer path retained');
END $$;
SELECT pg_temp.ep_assert(NOT EXISTS(SELECT 1 FROM auth.users WHERE id::text LIKE 'f884%'),'fixture namespace starts empty');
-- Replica-mode SETUP bypasses proposal scope/plan composition/authority INSERT
-- guards (00869_round8_scope_execution.sql:2325;
-- 00871_round8_plan_composition.sql:87; 00878_round8_fabrication_authority.sql:98)
-- and the external INSERT guard (00875_round8_external_fulfilment.sql:174–189,
-- trigger at :376) for the project_external_fulfilments rows below.
-- It also suppresses FK triggers, not CHECKs: real agreement/proposal/product
-- targets are inserted here and asserted below (configuration FK 00403:195,198,200;
-- fulfilment FKs 00875:16,25,34). These are setup rows, not reader corruptions.
