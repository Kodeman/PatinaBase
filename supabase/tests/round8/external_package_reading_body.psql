UPDATE public.evidence_manifest_members mm SET id=pg_temp.ep_id(6000-frozen.ord::integer)
 FROM public.evidence_manifests m,jsonb_array_elements(m.members) WITH ORDINALITY frozen(member,ord)
 WHERE m.id=mm.manifest_id AND m.id=pg_temp.ep_manifest('manifest-old')
 AND to_jsonb(mm)->>((member->>'kind')||'_id')=member->>'id';
