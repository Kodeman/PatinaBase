-- Use the actual mint/immutable membership authority; no replacement SQL stub.
CREATE FUNCTION pg_temp.ep_members(issue integer) RETURNS jsonb LANGUAGE sql AS $$
 SELECT jsonb_build_array(
  jsonb_build_object('kind','plan_issue','id',i.id,'version',i.issue_number,'sha256',i.set_checksum),
  jsonb_build_object('kind','product_configuration','id',c.id,'version',c.version,'sha256',c.snapshot_hash),
  jsonb_build_object('kind','coordination_item_revision','id',r.id,'rev',r.rev_number,'sha256',
   encode(extensions.digest(public._plan_room_canonical_json(jsonb_build_object('decisionId',r.decision_id,
    'rev',r.rev_number,'attachments',r.attachments,'note',r.note)),'sha256'),'hex')))
 FROM public.plan_issues i,public.product_configurations c,public.coordination_item_revisions r
 WHERE i.id=pg_temp.ep_id(issue) AND c.id=pg_temp.ep_id(831) AND r.id=pg_temp.ep_id(701);
$$;
SELECT public.create_evidence_manifest(pg_temp.ep_id(201),pg_temp.ep_id(801),'fabrication_instruction',pg_temp.ep_members(821),'manifest-old');
