-- Applies 00886 and 00906 (which redefines its _scope_after_execution),
-- then runs the C4 oracle inside one rolled-back transaction. Refuses any target but 127.0.0.1:expected_port.
\set ON_ERROR_STOP on
\if :{?expected_port}
\else
\set expected_port 54322
\endif
SELECT :'HOST' = '127.0.0.1' AND :'PORT' = :'expected_port' AS local_stack \gset
\if :local_stack
\else
\echo REFUSED: service_acceptance_isolated needs 127.0.0.1 port :expected_port, got :HOST port :PORT
DO $$ BEGIN RAISE EXCEPTION 'service_acceptance_isolated refused: not the expected local stack'; END $$;
\quit
\endif
BEGIN;
SET LOCAL lock_timeout='3s';
SET LOCAL statement_timeout='60s';
\ir ../../migrations/00886_round8_service_acceptance.sql
\ir ../../migrations/00906_round8_legacy_jobs_stay_off_editions.sql
\ir service_acceptance_body.psql
ROLLBACK;
