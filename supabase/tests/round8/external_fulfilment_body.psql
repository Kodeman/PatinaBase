-- END shared fixture
-- Activation is test-local and rolled back. Public production ACLs were checked above.
GRANT EXECUTE ON FUNCTION public.create_external_fulfilment(uuid,uuid,text,text,text[],uuid,uuid,text),
 public.record_external_fulfilment_event(uuid,text,jsonb,text[],text),public.verify_external_fulfilment_event(uuid,text),
 public.bind_fulfilment_evidence(uuid,uuid,text[],text) TO authenticated;
SELECT pg_temp.c5_actor(1);
SELECT pg_temp.c5_error($q$SELECT public.create_external_fulfilment(pg_temp.c5_id(201),pg_temp.c5_id(301),'pkg.client','client_furnishing',ARRAY['chair'],NULL,NULL,'create')$q$,'55000','scope_editions_inactive','inactive create refuses');
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
CREATE TEMP TABLE c5_result(key text PRIMARY KEY,value jsonb);
GRANT ALL ON c5_result TO authenticated;
CREATE FUNCTION pg_temp.c5_fid(k text) RETURNS uuid LANGUAGE sql STABLE AS $$ SELECT (value->>'fulfilmentId')::uuid FROM c5_result WHERE key=k; $$;
GRANT EXECUTE ON FUNCTION pg_temp.c5_fid(text) TO authenticated;
GRANT EXECUTE ON FUNCTION pg_temp.c5_assert(boolean,text),pg_temp.c5_error(text,text,text,text),pg_temp.c5_id(integer),pg_temp.c5_actor(integer) TO authenticated;
SET LOCAL ROLE authenticated;
