SELECT pg_temp.c5_error($q$DELETE FROM public.project_external_fulfilment_evidence_bindings WHERE fulfilment_id=pg_temp.c5_fid('client')$q$,'23514','external_fulfilment_immutable','binding append-only');
-- Deleting a profile is rejected by retained external records, not SET NULL.
SELECT pg_temp.c5_error($q$DELETE FROM public.profiles WHERE id=pg_temp.c5_id(2)$q$,'23503',NULL,'verifier profile retained');
-- Direct calls cannot turn a client, guest or bearer of a private GUC into a writer.
SELECT pg_temp.c5_actor(7);
SET LOCAL ROLE authenticated;
SELECT pg_temp.c5_error($q$SELECT public.get_project_external_fulfilments(pg_temp.c5_id(201))$q$,'42501','external_fulfilment_access','client cannot read studio external ledger');
SELECT set_config('patina.external_writer','00875',true);
SELECT pg_temp.c5_error($q$UPDATE public.project_external_fulfilments SET status='installed'$q$,'42501',NULL,'direct DML denied even with writer marker');
SELECT pg_temp.c5_error($q$DELETE FROM public.project_external_fulfilment_events$q$,'42501',NULL,'direct event delete denied');
SELECT pg_temp.c5_error($q$INSERT INTO public.project_external_fulfilment_evidence_bindings DEFAULT VALUES$q$,'42501',NULL,'direct binding insert denied');
SELECT pg_temp.c5_error($q$SELECT public._fabrication_instructed_amount_cents(pg_temp.c5_fid('client'))$q$,'42501',NULL,'private amount helper denied');
RESET ROLE;
SELECT set_config('patina.external_writer','',true);
-- The responsibility helper is the single rule for creation and later writes.
DO $$ DECLARE slot text; value text; refusal text; r jsonb; BEGIN
 SELECT responsibilities INTO r FROM public.project_scope_edition_packages WHERE edition_id=pg_temp.c5_id(301) AND package_key='pkg.client';
 FOR slot,value,refusal IN SELECT * FROM (VALUES
  ('purchasing','studio','external_rail_studio_buyer'),('payer','studio','external_rail_studio_liability'),
  ('fabrication_contract','studio','external_rail_studio_liability'),('payer','none','external_rail_payer_unknown')) cases LOOP
  SET LOCAL session_replication_role=replica;
  UPDATE public.project_scope_edition_packages SET responsibilities=jsonb_set(r,ARRAY[slot],to_jsonb(value))
   WHERE edition_id=pg_temp.c5_id(301) AND package_key='pkg.client';
  SET LOCAL session_replication_role=origin;
  PERFORM pg_temp.c5_assert(public._external_rail_refusal(pg_temp.c5_id(301),'pkg.client')=refusal,'external combination '||slot||'='||value);
  PERFORM pg_temp.c5_actor(1);
  PERFORM pg_temp.c5_error($q$SELECT public.create_external_fulfilment(pg_temp.c5_id(201),pg_temp.c5_id(301),'pkg.client','client_furnishing',ARRAY['chair'],NULL,NULL,'rail-denied')$q$,'23514',refusal,'create uses shared rail refusal '||slot||'='||value);
  PERFORM pg_temp.c5_error($q$SELECT public.record_external_fulfilment_event(pg_temp.c5_fid('client'),'received','{}',NULL,'rail-denied')$q$,'23514',refusal,'event rechecks shared rail refusal '||slot||'='||value);
 END LOOP;
 SET LOCAL session_replication_role=replica;
 UPDATE public.project_scope_edition_packages SET responsibilities=r WHERE edition_id=pg_temp.c5_id(301) AND package_key='pkg.client';
 SET LOCAL session_replication_role=origin;
END $$;
