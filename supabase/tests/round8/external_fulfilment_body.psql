SELECT pg_temp.c5_error($q$SELECT public.create_external_fulfilment(pg_temp.c5_id(201),pg_temp.c5_id(301),'pkg.client','client_furnishing',ARRAY['chair','table'],NULL,NULL,'create')$q$,'42501','idempotency_key_reused','different requester cannot replay');
SELECT pg_temp.c5_actor(1);
