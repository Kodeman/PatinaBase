-- Include-only. The wrapper owns the rollback; no fixture may be committed.
-- BEGIN shared helpers
CREATE FUNCTION pg_temp.c5_assert(ok boolean,label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',label; END IF;
 RAISE NOTICE 'PASS: %',label;
END $$;
CREATE FUNCTION pg_temp.c5_error(command text,state text,message text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
 BEGIN EXECUTE command;
 EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
 END;
 PERFORM pg_temp.c5_assert(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
 label||format(' expected %s/%s got %s/%s',state,message,actual_state,actual_message));
END $$;
CREATE FUNCTION pg_temp.c5_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
 SELECT ('f8750000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.c5_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 PERFORM set_config('request.jwt.claim.sub',pg_temp.c5_id(n)::text,true);
 PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.c5_id(n),'role','authenticated')::text,true);
END $$;
-- END shared helpers

-- This assertion also runs against exact dispatch-base production bytes: an
-- absent new API is an assertion failure, never a collection/import error.
SELECT pg_temp.c5_assert(to_regprocedure('public.create_external_fulfilment(uuid,uuid,text,text,text[],uuid,uuid,text)') IS NOT NULL
 AND to_regprocedure('public.bind_fulfilment_evidence(uuid,uuid,text[],text)') IS NOT NULL
 AND to_regprocedure('public.verify_external_fulfilment_event(uuid,text)') IS NOT NULL,
 'external foundation provides creation, preapproval binding and verification acts');

DO $$ DECLARE t text; f record; BEGIN
 PERFORM pg_temp.c5_assert(NOT (SELECT enabled FROM public.server_capabilities WHERE key='scope_editions'),'capability remains false');
 FOREACH t IN ARRAY ARRAY['project_external_fulfilments','project_external_fulfilment_events','project_external_fulfilment_evidence_bindings','project_external_fulfilment_verifications'] LOOP
  PERFORM pg_temp.c5_assert((SELECT relrowsecurity FROM pg_class WHERE oid=('public.'||t)::regclass),'RLS enabled '||t);
  PERFORM pg_temp.c5_assert(NOT has_table_privilege('authenticated','public.'||t,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE')
   AND NOT has_table_privilege('anon','public.'||t,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE'),'direct table access denied '||t);
 END LOOP;
 FOR f IN SELECT oid,oid::regprocedure signature,proname,prosecdef,proconfig FROM pg_proc
  WHERE pronamespace='public'::regnamespace AND (proname LIKE '\_external\_%' ESCAPE '\' OR proname IN
  ('_fabrication_instructed_amount_cents','create_external_fulfilment','record_external_fulfilment_event','verify_external_fulfilment_event','bind_fulfilment_evidence','get_project_external_fulfilments')) LOOP
  PERFORM pg_temp.c5_assert(NOT has_function_privilege('anon',f.oid,'EXECUTE')
   AND NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc WHERE oid=f.oid)) WHERE grantee=0 AND privilege_type='EXECUTE'),'PUBLIC/anon denied '||f.signature);
  PERFORM pg_temp.c5_assert(has_function_privilege('authenticated',f.oid,'EXECUTE')=(f.proname='get_project_external_fulfilments'),'authenticated exact execute '||f.signature);
  IF f.prosecdef THEN PERFORM pg_temp.c5_assert('search_path=public, pg_temp'=ANY(f.proconfig),'definer path pinned '||f.signature); END IF;
 END LOOP;
 PERFORM pg_temp.c5_assert((SELECT count(*)=3 FROM pg_constraint WHERE conrelid='public.project_external_fulfilment_events'::regclass
  AND confrelid='public.profiles'::regclass AND confdeltype='r'),'event actors retained by RESTRICT');
END $$;
-- BEGIN shared fixture
SELECT pg_temp.c5_assert(NOT EXISTS(SELECT 1 FROM auth.users WHERE id::text LIKE 'f875%'),'fictional fixture namespace starts empty');
SET LOCAL session_replication_role=replica;
