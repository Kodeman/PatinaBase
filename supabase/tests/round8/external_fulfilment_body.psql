SELECT pg_temp.c5_assert((SELECT covers_plan_issue_id=pg_temp.c5_id(1102) FROM public.project_external_fulfilment_evidence_bindings WHERE decision_id=pg_temp.c5_id(607)),'new binding uses highest issue event sequence not timestamp');
SELECT pg_temp.c5_error($q$UPDATE public.project_external_fulfilment_evidence_bindings SET units=ARRAY['table'] WHERE decision_id=pg_temp.c5_id(601)$q$,'23514','external_fulfilment_immutable','binding cannot be widened');
SELECT pg_temp.c5_error($q$UPDATE public.project_external_fulfilment_events SET evidence_level='reported',verified_by=NULL,verified_at=NULL,verification_seq=NULL WHERE id=(SELECT (value->>'eventId')::uuid FROM c5_result WHERE key='contract1')$q$,'23514','external_fulfilment_immutable','verified tuple cannot be reversed');
-- A requester's exact receipts survive later cancellation/staleness but not lost access.
SELECT pg_temp.c5_actor(1);
SET LOCAL ROLE authenticated;
SELECT public.record_external_fulfilment_event(pg_temp.c5_fid('gc'),'cancelled','{}',NULL,'cancel');
SELECT pg_temp.c5_assert((public.create_external_fulfilment(pg_temp.c5_id(201),pg_temp.c5_id(301),'pkg.cabinets','gc_cabinetry',ARRAY['k-1','k-2'],NULL,NULL,'create-gc')->>'replayed')::boolean,'create receipt survives cancellation');
RESET ROLE;
SET LOCAL session_replication_role=replica;
UPDATE public.project_scope_editions SET status='stale' WHERE id=pg_temp.c5_id(301);
SET LOCAL session_replication_role=origin;
SET LOCAL ROLE authenticated;
SELECT pg_temp.c5_assert((public.record_external_fulfilment_event(pg_temp.c5_fid('gc'),'cancelled','{}',NULL,'cancel')->>'replayed')::boolean,'event receipt survives stale edition and terminal status');
SELECT pg_temp.c5_assert((public.bind_fulfilment_evidence(pg_temp.c5_fid('gc'),pg_temp.c5_id(606),ARRAY['k-1'],'issue-bind')->>'replayed')::boolean,'binding receipt survives cancelled fulfilment and stale edition');
SELECT pg_temp.c5_actor(2);
SELECT pg_temp.c5_assert((public.verify_external_fulfilment_event((SELECT (value->>'eventId')::uuid FROM c5_result WHERE key='contract1'),'verify1')->>'replayed')::boolean,'verification receipt survives stale edition');
SELECT pg_temp.c5_error($q$SELECT public.bind_fulfilment_evidence(pg_temp.c5_fid('gc'),pg_temp.c5_id(606),ARRAY['k-1'],'issue-bind')$q$,'42501','idempotency_key_reused','other studio admin cannot replay binding');
SELECT pg_temp.c5_actor(1);
SELECT pg_temp.c5_error($q$SELECT public.verify_external_fulfilment_event((SELECT (value->>'eventId')::uuid FROM c5_result WHERE key='contract1'),'verify1')$q$,'42501','idempotency_key_reused','other original recorder cannot replay verification');
RESET ROLE;
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
SET LOCAL ROLE authenticated;
SELECT pg_temp.c5_error($q$SELECT public.record_external_fulfilment_event(pg_temp.c5_fid('gc'),'cancelled','{}',NULL,'cancel')$q$,'55000','scope_editions_inactive','capability suspension precedes exact event replay');
SELECT pg_temp.c5_error($q$SELECT public.bind_fulfilment_evidence(pg_temp.c5_fid('gc'),pg_temp.c5_id(606),ARRAY['k-1'],'issue-bind')$q$,'55000','scope_editions_inactive','capability suspension precedes exact binding replay');
RESET ROLE;
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SET LOCAL session_replication_role=replica;
UPDATE public.organization_members SET status='suspended' WHERE organization_id=pg_temp.c5_id(101) AND user_id=pg_temp.c5_id(1);
SET LOCAL session_replication_role=origin;
SET LOCAL ROLE authenticated;
SELECT pg_temp.c5_error($q$SELECT public.record_external_fulfilment_event(pg_temp.c5_fid('gc'),'cancelled','{}',NULL,'cancel')$q$,'42501','external_fulfilment_access','original requester loses replay with current access');
RESET ROLE;
SELECT pg_temp.c5_assert(NOT EXISTS(SELECT 1 FROM public.project_external_fulfilment_events WHERE event_kind='fabrication_instruction'),'no instruction fabricated');
\echo 'C5 external fulfilment assertions complete; wrapper rolls back every fixture and temporary grant.'
