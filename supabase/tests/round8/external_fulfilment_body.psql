SELECT pg_temp.c5_error($q$SELECT public.create_external_fulfilment(pg_temp.c5_id(201),pg_temp.c5_id(302),'pkg.client','client_furnishing',ARRAY['chair'],NULL,NULL,'bad-edition')$q$,'55000','scope_edition_not_active','off-project edition refused');
SELECT pg_temp.c5_error($q$SELECT public.create_external_fulfilment(pg_temp.c5_id(201),pg_temp.c5_id(301),'pkg.client','client_furnishing',ARRAY['chair','chair'],NULL,NULL,'bad-units')$q$,'23514','fulfilment_units_invalid','duplicate units refused');
