  ) AS v(label, suffix);
GRANT SELECT ON m874_id TO PUBLIC;

-- {LABEL} → '<uuid>'::uuid
CREATE FUNCTION pg_temp.sql_of(p_template text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE r record; v_sql text := p_template;
BEGIN
  IF v_sql IS NULL THEN RETURN NULL; END IF;
  FOR r IN SELECT label, id FROM m874_id LOOP
    v_sql := replace(v_sql, '{' || r.label || '}', quote_literal(r.id::text) || '::uuid');
  END LOOP;
  ASSERT v_sql !~ '\{[A-Z0-9]+\}', 'unresolved label in ' || v_sql;
  RETURN v_sql;
END $$;

CREATE FUNCTION pg_temp.id(p_label text) RETURNS uuid
LANGUAGE sql AS $$ SELECT id FROM m874_id WHERE label = p_label $$;

-- ─── 3 · probes ─────────────────────────────────────────────────────────────
-- pg_temp.probe runs p_setup as postgres, then p_sql as the authenticated
-- actor, then raises to roll the whole subtransaction back (state, role and
-- JWT claims alike). Outcome: the SELECT's (or a WITH … SELECT's) text value,
-- 'rows=N', or 'denied' (42501, a row-level-security or guard refusal). A
-- chain (steps joined by ' ;; ') runs step by step as the same actor, each in
-- its own subtransaction so a refused step does not stop the next; the
-- outcomes are joined by ' | '.
CREATE FUNCTION pg_temp.probe(p_actor uuid, p_sql text, p_setup text)
RETURNS text LANGUAGE plpgsql AS $$
DECLARE v_out text; v_one text; v_step text; v_rows bigint;
BEGIN
  BEGIN
    IF p_setup IS NOT NULL THEN EXECUTE p_setup; END IF;
    PERFORM set_config('request.jwt.claims',
      json_build_object('sub', p_actor::text, 'role', 'authenticated')::text, true);
    EXECUTE 'SET LOCAL ROLE authenticated';
    FOREACH v_step IN ARRAY string_to_array(p_sql, ' ;; ') LOOP
      BEGIN
        IF v_step ~* '^\s*(select|with)\M' THEN
          EXECUTE v_step INTO v_one;
          v_one := COALESCE(v_one, 'null');
        ELSE
          EXECUTE v_step;
          GET DIAGNOSTICS v_rows = ROW_COUNT;
          v_one := 'rows=' || v_rows;
        END IF;
      EXCEPTION
        WHEN insufficient_privilege THEN v_one := 'denied';
        WHEN OTHERS THEN v_one := 'error ' || SQLSTATE || ': ' || SQLERRM;
      END;
      v_out := CASE WHEN v_out IS NULL THEN v_one ELSE v_out || ' | ' || v_one END;
    END LOOP;
    RAISE EXCEPTION USING ERRCODE = 'U0874', MESSAGE = 'probe rollback';
  EXCEPTION
    WHEN SQLSTATE 'U0874' THEN RETURN v_out;
    WHEN insufficient_privilege THEN RETURN 'denied';
    WHEN OTHERS THEN RETURN 'error ' || SQLSTATE || ': ' || SQLERRM;
  END;
END $$;

-- pg_temp.act is the same call WITHOUT the rollback, for the readback.
CREATE FUNCTION pg_temp.act(p_actor uuid, p_sql text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE v_rows bigint; v_out text;
BEGIN
  BEGIN
    PERFORM set_config('request.jwt.claims',
      json_build_object('sub', p_actor::text, 'role', 'authenticated')::text, true);
    EXECUTE 'SET LOCAL ROLE authenticated';
    EXECUTE p_sql;
    GET DIAGNOSTICS v_rows = ROW_COUNT;
    v_out := 'rows=' || v_rows;
  EXCEPTION
    WHEN insufficient_privilege THEN v_out := 'denied';
  END;
  EXECUTE 'RESET ROLE';
  PERFORM set_config('request.jwt.claims', NULL, true);
  RETURN v_out;
END $$;

