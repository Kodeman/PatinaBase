-- Include-only: callers own BEGIN/ROLLBACK. Actor fixture and probes follow 00867.
DO $$ BEGIN
 ASSERT EXISTS (SELECT 1 FROM pg_policy WHERE polrelid='public.margin_notes'::regclass AND polname='margin_notes_tenant_guard' AND NOT polpermissive AND polcmd='*'), 'C7 prerequisite: restrictive ALL tenant guard';
END $$;
