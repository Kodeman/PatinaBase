INSERT INTO public.margin_notes(id,project_id,designer_id,body,anchor_kind,field_capture_id)
VALUES(pg_temp.id('N1'),pg_temp.id('PA'),pg_temp.id('D'),repeat('Private field observation ',5),'letterhead',pg_temp.id('XA')),
      (pg_temp.id('N2'),pg_temp.id('PA'),pg_temp.id('D'),'Private escalation','letterhead',NULL),
      (pg_temp.id('N3'),pg_temp.id('PB'),pg_temp.id('D'),'B note','letterhead',NULL),
      (pg_temp.id('N4'),pg_temp.id('PA'),pg_temp.id('D'),'Hidden capture note','letterhead',pg_temp.id('XB'));

DO $$
DECLARE k text; a text; q text; r text;
BEGIN
  -- Every canonical owner resolves through real persisted rows, including print→sheet.
  FOREACH k IN ARRAY ARRAY['ffe_item','project_room','plan_print','plan_issue','purchase_order','field_capture','coordination_item'] LOOP
    ASSERT public._subject_project_id(k,pg_temp.id('XA')) = pg_temp.id('PA'), 'C7 canonical owner: '||k;
    q:=format('INSERT INTO public.margin_notes(project_id,designer_id,body,anchor_kind,subject_kind,subject_id) VALUES (%L,%L,%L,%L,%L,%L)',pg_temp.id('PA'),pg_temp.id('A1'),'typed','letterhead',k,pg_temp.id('XA'));
    ASSERT pg_temp.probe(pg_temp.id('A1'),q,NULL)='rows=1','C7 authorised typed insert: '||k;
    ASSERT pg_temp.probe(pg_temp.id('B1'),replace(q,quote_literal(pg_temp.id('A1')),quote_literal(pg_temp.id('B1'))),NULL)='denied','C7 typed subject never grants tenant access: '||k;
    q:=replace(q,quote_literal(pg_temp.id('PA')),quote_literal(pg_temp.id('PB')));
    ASSERT pg_temp.probe(pg_temp.id('D'),q,NULL) LIKE 'error 23514: subject_off_project%', 'C7 off-project: '||k;
  END LOOP;
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('UPDATE public.margin_notes SET subject_kind=''unknown'',subject_id={XA} WHERE id={N1}'),NULL) LIKE 'error 23514: subject_invalid%', 'C7 closed kind refusal: unknown';
  -- 00877 admits project_package into the closed vocabulary (C7 §2; deferred by 00874).
  -- A non-package id under that kind is refused by owner resolution instead.
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('UPDATE public.margin_notes SET subject_kind=''project_package'',subject_id={XA} WHERE id={N1}'),NULL) LIKE 'error 23514: subject_off_project%', 'C7 project_package without a package row refused';
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('UPDATE public.margin_notes SET subject_kind=''ffe_item'' WHERE id={N1}'),NULL) LIKE 'error 23514: subject_invalid%', 'C7 half pair kind refused';
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('UPDATE public.margin_notes SET subject_id={XA} WHERE id={N1}'),NULL) LIKE 'error 23514: subject_invalid%', 'C7 half pair id refused';
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('UPDATE public.margin_notes SET subject_kind=''ffe_item'',subject_id={DEC} WHERE id={N1}'),NULL) LIKE 'error 23514: subject_off_project%', 'C7 missing subject refused';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('INSERT INTO public.margin_notes(proposal_id,designer_id,body,anchor_kind,subject_kind,subject_id) VALUES({QA},{A1},''typed'',''letterhead'',''ffe_item'',{XA})'),NULL) LIKE 'error 23514: subject_requires_project%', 'C7 typed proposal needs project';
  -- Legacy project/proposal/Discovery writes do no subject lookup.
  FOREACH q IN ARRAY ARRAY[
    'INSERT INTO public.margin_notes(project_id,designer_id,body,anchor_kind) VALUES({PA},{A1},''legacy'',''letterhead'')',
    'INSERT INTO public.margin_notes(proposal_id,designer_id,body,anchor_kind) VALUES({QA},{A1},''legacy'',''letterhead'')',
    'INSERT INTO public.margin_notes(designer_client_id,designer_id,body,anchor_kind) VALUES({RA},{A1},''legacy'',''letterhead'')'] LOOP
    ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of(q),NULL)='rows=1','C7 legacy authorised insert';
    ASSERT pg_temp.probe(pg_temp.id('B1'),pg_temp.sql_of(q),NULL)='denied','C7 legacy foreign insert denied';
    r:=pg_temp.sql_of(q);
    ASSERT pg_temp.probe(pg_temp.id('A1'),'UPDATE public.margin_notes SET body=''legacy updated'' WHERE body=''legacy''',r)='rows=1','C7 legacy authorised update';
    ASSERT pg_temp.probe(pg_temp.id('B1'),'UPDATE public.margin_notes SET body=''legacy updated'' WHERE body=''legacy''',r)='rows=0','C7 legacy foreign update denied';
  END LOOP;
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('UPDATE public.margin_notes SET project_id={PB} WHERE id={N2}'),NULL)='denied','C7 new image tenant denied';
  ASSERT pg_temp.probe(pg_temp.id('B1'),pg_temp.sql_of('UPDATE public.margin_notes SET project_id={PB} WHERE id={N2}'),NULL)='rows=0','C7 old image tenant denied';
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('UPDATE public.margin_notes SET proposal_id={QB},subject_kind=''ffe_item'',subject_id={XA} WHERE id={N2}'),NULL)='denied','C7 contradictory anchors denied despite valid subject';
  FOREACH a IN ARRAY ARRAY['B1','AG','AS','AR','CL'] LOOP
    ASSERT pg_temp.probe(pg_temp.id(a),pg_temp.sql_of('SELECT count(*)::text FROM public.margin_notes WHERE id={N1}'),NULL)='0','C7 note read denied: '||a;
  END LOOP;
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT (payload->>''project_room_id'') FROM public.margin_items WHERE kind=''note'' AND item_id={N1}'),NULL)=pg_temp.id('XA')::text,'C7 visible Field room';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('SELECT (payload->>''project_room_id'') FROM public.margin_items WHERE kind=''note'' AND item_id={N1}'),NULL)=pg_temp.id('XA')::text,'C7 co-member visible Field room';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('SELECT (payload->>''project_room_id'') FROM public.margin_items WHERE kind=''note'' AND item_id={N4}'),NULL)='null','C7 hidden capture room redacted';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('SELECT (payload->>''capture_visible'') FROM public.margin_items WHERE kind=''note'' AND item_id={N4}'),NULL)='false','C7 capture visibility unchanged';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('SELECT (payload->>''audio_path'') FROM public.margin_items WHERE kind=''note'' AND item_id={N4}'),NULL)='null','C7 hidden capture media redacted';
END $$;

-- Production posture: neither PUBLIC nor any application role can invoke the
-- definer/helper, even while authenticated. Test-only grants below roll back.
DO $$
DECLARE f text; r text;
BEGIN
  ASSERT NOT (SELECT enabled FROM public.server_capabilities WHERE key='margin_note_escalation'),'C7 inactive capability';
  FOREACH f IN ARRAY ARRAY['public.escalate_margin_note(uuid,uuid)','public._subject_project_id(text,uuid)','public._guard_margin_note_subject()'] LOOP
    FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
      ASSERT NOT has_function_privilege(r,f,'EXECUTE'),'C7 effective execute revoked: '||r||' '||f;
    END LOOP;
    ASSERT NOT EXISTS(SELECT 1 FROM pg_proc p, LATERAL aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=f::regprocedure AND a.grantee=0 AND a.privilege_type='EXECUTE'),'C7 PUBLIC execute revoked';
  END LOOP;
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC})'),NULL)='denied','C7 direct RPC call denied';
END $$;
GRANT EXECUTE ON FUNCTION public.escalate_margin_note(uuid,uuid) TO authenticated;
DO $$ BEGIN
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC})'),NULL) LIKE 'error 55000: margin_note_escalation_inactive%', 'C7 capability enforced after test grant';
END $$;
UPDATE public.server_capabilities SET enabled=true WHERE key='margin_note_escalation';
DO $$
DECLARE a text; k text;
BEGIN
  FOREACH k IN ARRAY ARRAY['unknown','project_package'] LOOP
    ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC})'),
      'ALTER TABLE public.margin_notes DROP CONSTRAINT margin_notes_subject_kind_check; ALTER TABLE public.margin_notes DISABLE TRIGGER margin_note_subject_guard; ' ||
      pg_temp.sql_of(format('UPDATE public.margin_notes SET subject_kind=%L,subject_id={XA} WHERE id={N2}',k))) LIKE 'error 23514: subject_off_project%', 'C7 RPC closed kind refusal: '||k;
  END LOOP;
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N1},{XA})'),
    pg_temp.sql_of('UPDATE public.margin_notes SET escalated_to_decision_id={XA} WHERE id={N1}; ALTER TABLE public.client_decisions DISABLE TRIGGER USER; UPDATE public.client_decisions SET project_id={PB} WHERE id={XA}'))='denied','C7 RPC cross-project decision refused';
  FOREACH a IN ARRAY ARRAY['B1','AG','AS','AR','CL'] LOOP
    ASSERT pg_temp.probe(pg_temp.id(a),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC})'),NULL)='denied','C7 escalation tenant denied: '||a;
  END LOOP;
  ASSERT NOT EXISTS(SELECT 1 FROM public.client_decisions WHERE id=pg_temp.id('DEC')),'C7 denied escalation copied no body';
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{XA})'),NULL) LIKE 'error 23505: escalation conflict%', 'C7 cannot attach arbitrary existing decision';
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC})'),pg_temp.sql_of('UPDATE public.margin_notes SET proposal_id={QB} WHERE id={N2}'))='denied','C7 escalation rechecks every anchor';
END $$;
-- Same-project co-member exercises the real nested native decision writer.
SELECT pg_temp.act(pg_temp.id('A1'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC})'));
DO $$ BEGIN
  ASSERT (SELECT escalated_to_decision_id=pg_temp.id('DEC') FROM public.margin_notes WHERE id=pg_temp.id('N2')),'C7 atomic note link';
  ASSERT (SELECT status='draft' AND court='designer' AND sent_at IS NULL FROM public.client_decisions WHERE id=pg_temp.id('DEC')),'C7 unsent designer-court draft';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('SELECT (public.escalate_margin_note({N2},{DEC})).id::text'),NULL)=pg_temp.id('DEC')::text,'C7 same-ID replay';
  ASSERT pg_temp.probe(pg_temp.id('A1'),pg_temp.sql_of('SELECT public.escalate_margin_note({N2},{DEC2})'),NULL) LIKE 'error 23505: note already escalated%', 'C7 different-ID replay refused';
  ASSERT pg_temp.probe(pg_temp.id('CL'),pg_temp.sql_of('SELECT count(*)::text FROM public.client_decisions WHERE id={DEC}'),NULL)='0','C7 no client draft promotion';
END $$;
-- SQ-2082 F1: inherited policies expose draft existence, not private text.
DO $$ BEGIN
  ASSERT pg_temp.probe(pg_temp.id('U'),pg_temp.sql_of('SELECT count(*)::text FROM public.client_decisions WHERE id={DEC}'),NULL)='0','C7 unrelated reader excludes draft before GC appointment';
END $$;
INSERT INTO public.project_parties(project_id,party_kind,display_name,profile_id,created_by)
VALUES(pg_temp.id('PA'),'gc','874 GC',pg_temp.id('U'),pg_temp.id('D'));
DO $$
DECLARE a text;
BEGIN
  FOREACH a IN ARRAY ARRAY['B1','U'] LOOP
    ASSERT pg_temp.probe(pg_temp.id(a),pg_temp.sql_of('SELECT count(*)::text FROM public.margin_notes WHERE id={N2}'),NULL)='0','C7 source note stays invisible: '||a;
    ASSERT pg_temp.probe(pg_temp.id(a),pg_temp.sql_of('SELECT count(*)::text FROM public.client_decisions WHERE id={DEC}'),NULL)='1','C7 inherited draft existence remains visible: '||a;
    ASSERT pg_temp.probe(pg_temp.id(a),pg_temp.sql_of('SELECT (title=''Decision from a studio note'' AND context IS NULL AND to_jsonb(cd)::text NOT ILIKE ''%private%'')::text FROM public.client_decisions cd WHERE id={DEC}'),NULL)='true','C7 draft has neutral fields and no note-derived text: '||a;
  END LOOP;
  ASSERT NOT EXISTS(SELECT 1 FROM public.client_decision_options WHERE decision_id=pg_temp.id('DEC')),'C7 neutral draft has no copied options';
  RAISE NOTICE 'C7 audience assertions passed: B-only and GC see neutral draft fields only; source note remains hidden.';
END $$;
-- Fail AFTER the decision insert, at note linking: the nested statement must
-- roll the native decision back too, not leave a private orphan behind.
CREATE FUNCTION pg_temp.fail_874_link() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
 IF NEW.escalated_to_decision_id IS NOT NULL THEN RAISE EXCEPTION '874 injected link failure' USING ERRCODE='check_violation'; END IF; RETURN NEW; END $$;
CREATE TRIGGER fail_874_link BEFORE UPDATE ON public.margin_notes FOR EACH ROW EXECUTE FUNCTION pg_temp.fail_874_link();
DO $$ BEGIN
  ASSERT pg_temp.probe(pg_temp.id('D'),pg_temp.sql_of('SELECT public.escalate_margin_note({N1},{DEC2})'),NULL) LIKE 'error 23514: 874 injected link failure%', 'C7 downstream link failure exercised';
  ASSERT NOT EXISTS(SELECT 1 FROM public.client_decisions WHERE id=pg_temp.id('DEC2')),'C7 failed link leaves no decision';
  ASSERT (SELECT escalated_to_decision_id IS NULL FROM public.margin_notes WHERE id=pg_temp.id('N1')),'C7 failed link leaves no pointer';
END $$;
DROP TRIGGER fail_874_link ON public.margin_notes;
\echo 'C7 assertions passed: subjects, legacy anchors, tenant images, Field redaction, inactive ACLs, atomic draft/replay/rollback.'
