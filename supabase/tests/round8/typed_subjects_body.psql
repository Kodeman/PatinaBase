-- Native studio captures are visible to co-members. The unrelated author's
-- capture supplies a genuinely RLS-hidden join without altering capture policy.
-- Plan fixtures are recorded, not filed through the inactive application rail.
-- All ownership edges are real; replication mode is restored before any assertion.
SET LOCAL session_replication_role = replica;
INSERT INTO public.plan_sheets(id,project_id,sheet_number,title)
VALUES(pg_temp.id('SHEET'),pg_temp.id('PA'),'874-A1','874 plan');
