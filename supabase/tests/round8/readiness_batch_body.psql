-- Include-only: caller owns BEGIN/ROLLBACK. No persistent activation or fixtures.
CREATE FUNCTION pg_temp.batch_assert(ok boolean, label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %', label; END IF;
  RAISE NOTICE 'PASS: %', label;
END $$;
CREATE FUNCTION pg_temp.batch_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
  SELECT ('88000000-0000-4000-8000-' || lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.batch_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claim.sub',COALESCE(pg_temp.batch_id(n)::text,''),true);
  PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.batch_id(n),'role','authenticated')::text,true);
END $$;
CREATE FUNCTION pg_temp.batch_error(command text, expected text, label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual text;
BEGIN
  BEGIN EXECUTE command;
  EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual=RETURNED_SQLSTATE;
  END;
  PERFORM pg_temp.batch_assert(actual=expected,label || format(' expected %s got %s',expected,actual));
END $$;

-- This assertion also supplies a real dispatch-base negative control: no API yet.
SELECT pg_temp.batch_assert(to_regprocedure('public.get_project_ffe_readiness_batch(text[])') IS NOT NULL,
  'bounded readiness batch API exists');
DO $$ DECLARE r text; BEGIN
  FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
    PERFORM pg_temp.batch_assert(NOT has_function_privilege(r,
      'public.get_project_ffe_readiness_batch(text[])','EXECUTE'),'batch inactive for ' || r);
  END LOOP;
  PERFORM pg_temp.batch_assert(NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc
    WHERE oid='public.get_project_ffe_readiness_batch(text[])'::regprocedure))
    WHERE grantee=0 AND privilege_type='EXECUTE'),'batch inactive for PUBLIC');
  PERFORM pg_temp.batch_assert((SELECT NOT prosecdef AND proconfig @> ARRAY['search_path=public, pg_temp']
    FROM pg_proc WHERE oid='public.get_project_ffe_readiness_batch(text[])'::regprocedure),
    'invoker transport has a pinned search path');
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.batch_assert(boolean,text),pg_temp.batch_id(integer),
  pg_temp.batch_actor(integer),pg_temp.batch_error(text,text,text) TO authenticated;
SET LOCAL ROLE authenticated;
SELECT pg_temp.batch_error($q$SELECT public.get_project_ffe_readiness_batch(ARRAY[]::text[])$q$,
  '42501','inactive API is not callable even with empty input');
RESET ROLE;
SELECT pg_temp.batch_assert(NOT EXISTS(SELECT 1 FROM public.project_ffe_items WHERE id::text LIKE '88000000-%'),
  'readiness fixture namespace starts empty');
SELECT pg_temp.batch_assert(NOT (SELECT enabled FROM public.server_capabilities WHERE key='scope_editions'),
  'scope capability remains inactive');

-- Setup only: skip unrelated setup triggers, never the exercised read/authority path.
SET LOCAL session_replication_role=replica;
