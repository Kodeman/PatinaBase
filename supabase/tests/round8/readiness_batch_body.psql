SET LOCAL session_replication_role=origin;

-- Transaction-local activation solely to exercise the future authenticated call path.
GRANT EXECUTE ON FUNCTION public.get_project_ffe_readiness_batch(text[]) TO authenticated;
SELECT pg_temp.batch_actor(101);
SET LOCAL ROLE authenticated;
DO $$ DECLARE n integer; actual jsonb; expected jsonb; batch jsonb; BEGIN
  batch:=public.get_project_ffe_readiness_batch(ARRAY(SELECT pg_temp.batch_id(i)::text FROM generate_series(1,14)i ORDER BY i));
  PERFORM pg_temp.batch_assert(jsonb_array_length(batch)=14,'multi-line batch retains all native and external entries');
  FOR n IN 1..14 LOOP
    actual:=batch->(n-1);
    expected:=public.get_project_ffe_readiness(pg_temp.batch_id(n));
    PERFORM pg_temp.batch_assert(actual->'readiness'=expected AND actual->'error'='null'::jsonb,
      'singleton equality for native/external case '||n);
  END LOOP;
  PERFORM pg_temp.batch_assert((public.get_project_ffe_readiness_batch(ARRAY[pg_temp.batch_id(1)::text])->0->'readiness'->>'ready')::boolean,
    'selected object image is genuinely ready');
  PERFORM pg_temp.batch_assert((public.get_project_ffe_readiness(pg_temp.batch_id(13))->>'ready')::boolean
    AND (public.get_project_ffe_readiness(pg_temp.batch_id(14))->>'ready')::boolean,
    'catalog and own-item image fallbacks are genuinely ready');
  FOR n IN 3..9 LOOP
    PERFORM pg_temp.batch_assert(public.get_project_ffe_readiness(pg_temp.batch_id(n))->'missingFields'
      ? (ARRAY['designDisposition','removed','releaseBlock','vendor','quantity','clientPrice','allowanceCeiling'])[n-2],
      'native hold fixture is exercised for case '||n);
  END LOOP;
  PERFORM pg_temp.batch_assert(public.get_project_ffe_readiness(pg_temp.batch_id(2))->'missingFields' ? 'image',
    'missing-image fixture exercises an actual readiness hold');
  PERFORM pg_temp.batch_assert(public.get_project_ffe_readiness(pg_temp.batch_id(10))->'missingFields' ? 'parent_not_ready',
    'recursive labor parent hold survives batching');
  PERFORM pg_temp.batch_assert(public.get_project_ffe_readiness(pg_temp.batch_id(11))->'missingFields' ? 'clientPrice',
    'external GC responsibility retains native zero-price hold');
END $$;
SELECT pg_temp.batch_assert(public.get_project_ffe_readiness_batch(ARRAY[]::text[])='[]'::jsonb,'empty batch is empty');
SELECT pg_temp.batch_assert(jsonb_array_length(public.get_project_ffe_readiness_batch(array_fill(pg_temp.batch_id(1)::text,ARRAY[100])))=100,
  '100-entry boundary retains every duplicate');
SELECT pg_temp.batch_error($q$SELECT public.get_project_ffe_readiness_batch(NULL)$q$,'22023','null array rejected');
SELECT pg_temp.batch_error($q$SELECT public.get_project_ffe_readiness_batch(array_fill('bad'::text,ARRAY[101]))$q$,'22023','oversize rejected before any entries');
SELECT pg_temp.batch_error($q$SELECT public.get_project_ffe_readiness_batch(ARRAY[['bad','bad']])$q$,'22023','multidimensional input rejected');
SELECT pg_temp.batch_actor(102);
DO $$ DECLARE actual jsonb; BEGIN
  actual:=public.get_project_ffe_readiness_batch(ARRAY[pg_temp.batch_id(1)::text,'bad',pg_temp.batch_id(999)::text,
    pg_temp.batch_id(12)::text,pg_temp.batch_id(1)::text,NULL,'']);
  PERFORM pg_temp.batch_assert(jsonb_array_length(actual)=7 AND actual->0=actual->4
    AND actual->0->'readiness'=public.get_project_ffe_readiness(pg_temp.batch_id(1)),
    'recorded-studio member: mixed batch preserves order and duplicate successes');
  PERFORM pg_temp.batch_assert(actual->1->'error'->>'code'='22P02' AND actual->1->'selectionId'='"bad"'::jsonb
    AND actual->2->'error'->>'code'='P0002' AND actual->3->'error'->>'code'='42501'
    AND actual->5->'error'->>'code'='22P02' AND actual->6->'error'->>'code'='22P02',
    'invalid, missing, foreign, null and blank IDs have individual typed refusals');
  PERFORM pg_temp.batch_assert(NOT EXISTS(SELECT 1 FROM jsonb_array_elements(actual) e
    WHERE e->'error'<>'null'::jsonb AND (e->'readiness'<>'null'::jsonb OR e ? 'ready')),
    'refused entries never masquerade as readiness or aggregate success');
  PERFORM pg_temp.batch_assert(actual->2->'error'->>'message'='selection not found'
    AND actual->3->'error'->>'message'='project not found or access denied',
    'missing and foreign refusal messages match singleton');
END $$;
DO $$ DECLARE n integer; actual jsonb; state text; message text; BEGIN
  FOREACH n IN ARRAY ARRAY[103,104,105,106,107,NULL::integer] LOOP
    PERFORM pg_temp.batch_actor(n);
    state:=NULL;
    BEGIN PERFORM public.get_project_ffe_readiness(pg_temp.batch_id(1));
    EXCEPTION WHEN insufficient_privilege THEN GET STACKED DIAGNOSTICS state=RETURNED_SQLSTATE,message=MESSAGE_TEXT;
    END;
    actual:=public.get_project_ffe_readiness_batch(ARRAY[pg_temp.batch_id(1)::text])->0;
    PERFORM pg_temp.batch_assert(state='42501' AND actual->'readiness'='null'::jsonb
      AND actual->'error'=jsonb_build_object('code',state,'message',message),
      'native authority parity for B-only/guest/suspended/client/outsider/unauth actor '||COALESCE(n::text,'null'));
  END LOOP;
END $$;
RESET ROLE;
SELECT pg_temp.batch_actor(101);

-- Compare actual business rows before/after the read, including external evidence.
CREATE TEMP TABLE batch_before AS
SELECT 'items' AS source,jsonb_agg(to_jsonb(i) ORDER BY id) AS payload FROM public.project_ffe_items i WHERE id::text LIKE '88000000-%'
UNION ALL SELECT 'external',jsonb_agg(to_jsonb(f) ORDER BY id) FROM public.project_external_fulfilments f WHERE project_id=pg_temp.batch_id(203)
UNION ALL SELECT 'events',jsonb_agg(to_jsonb(e) ORDER BY id) FROM public.project_external_fulfilment_events e WHERE fulfilment_id=pg_temp.batch_id(213)
UNION ALL SELECT 'documents',jsonb_agg(to_jsonb(d) ORDER BY id) FROM public.project_commercial_documents d WHERE project_id=pg_temp.batch_id(203)
UNION ALL SELECT 'orders',jsonb_agg(to_jsonb(p) ORDER BY id) FROM public.purchase_orders p WHERE project_id=pg_temp.batch_id(203);
SELECT public.get_project_ffe_readiness_batch(ARRAY[pg_temp.batch_id(11)::text]);
SELECT pg_temp.batch_assert(NOT EXISTS(
  (SELECT * FROM batch_before EXCEPT
    (SELECT 'items',jsonb_agg(to_jsonb(i) ORDER BY id) FROM public.project_ffe_items i WHERE id::text LIKE '88000000-%'
     UNION ALL SELECT 'external',jsonb_agg(to_jsonb(f) ORDER BY id) FROM public.project_external_fulfilments f WHERE project_id=pg_temp.batch_id(203)
     UNION ALL SELECT 'events',jsonb_agg(to_jsonb(e) ORDER BY id) FROM public.project_external_fulfilment_events e WHERE fulfilment_id=pg_temp.batch_id(213)
     UNION ALL SELECT 'documents',jsonb_agg(to_jsonb(d) ORDER BY id) FROM public.project_commercial_documents d WHERE project_id=pg_temp.batch_id(203)
     UNION ALL SELECT 'orders',jsonb_agg(to_jsonb(p) ORDER BY id) FROM public.purchase_orders p WHERE project_id=pg_temp.batch_id(203)))),
  'batch read leaves native/external rows, versions, evidence, documents and orders untouched');
SELECT pg_temp.batch_assert((SELECT prosrc !~* '\mFOR\s+(UPDATE|SHARE|NO\s+KEY\s+UPDATE|KEY\s+SHARE)\M'
  FROM pg_proc WHERE oid='public.get_project_ffe_readiness_batch(text[])'::regprocedure),'transport adds no row-lock SQL');

-- Unexpected failures must abort, not become a falsely successful partial response.
SAVEPOINT unexpected_readiness_failure;
CREATE OR REPLACE FUNCTION public.get_project_ffe_readiness(p_ffe_item_id uuid)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public','pg_temp' AS $$
BEGIN RAISE EXCEPTION 'unexpected readiness failure' USING ERRCODE='XX000'; END $$;
SELECT pg_temp.batch_error($q$SELECT public.get_project_ffe_readiness_batch(ARRAY[pg_temp.batch_id(1)::text])$q$,
  'XX000','unexpected singleton errors propagate');
ROLLBACK TO SAVEPOINT unexpected_readiness_failure;
REVOKE EXECUTE ON FUNCTION public.get_project_ffe_readiness_batch(text[]) FROM authenticated;
SELECT pg_temp.batch_assert(NOT has_function_privilege('authenticated','public.get_project_ffe_readiness_batch(text[])','EXECUTE'),
  'fixture activation removed before wrapper rollback');
