-- Include-only. All source overlays and fictional rows roll back together.
-- BEGIN shared helpers
CREATE FUNCTION pg_temp.fi_assert(ok boolean,label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',label; END IF;
 RAISE NOTICE 'PASS: %',label;
END $$;
CREATE FUNCTION pg_temp.fi_error(command text,state text,message text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
 BEGIN EXECUTE command;
 EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
 END;
 PERFORM pg_temp.fi_assert(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
 label||format(' expected %s/%s got %s/%s',state,message,actual_state,actual_message));
END $$;
CREATE FUNCTION pg_temp.fi_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
 SELECT ('f8790000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.fi_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 PERFORM set_config('request.jwt.claim.sub',pg_temp.fi_id(n)::text,true);
 PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.fi_id(n),'role','authenticated')::text,true);
END $$;
-- END shared helpers
SELECT pg_temp.fi_assert(to_regprocedure('public.assert_fabrication_instruction_authority(uuid,uuid,uuid,text[])') IS NOT NULL,
 'both fabrication routes have a shared authority gate');
SELECT pg_temp.fi_assert(NOT (SELECT enabled FROM public.server_capabilities WHERE key='scope_editions'),'capability remains inactive');
DO $$ DECLARE signature text; BEGIN
 FOREACH signature IN ARRAY ARRAY['assert_fabrication_instruction_authority(uuid,uuid,uuid,text[])',
 '_record_fabrication_instruction(uuid,uuid,uuid,text[],jsonb,text)',
 'record_fabrication_instruction(uuid,uuid,uuid,text[],jsonb,uuid)',
 'record_external_fulfilment_event(uuid,text,jsonb,text[],text)'] LOOP
  PERFORM pg_temp.fi_assert(NOT has_function_privilege('anon','public.'||signature,'EXECUTE')
   AND NOT has_function_privilege('authenticated','public.'||signature,'EXECUTE')
   AND NOT has_function_privilege('service_role','public.'||signature,'EXECUTE')
   AND NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc WHERE oid=('public.'||signature)::regprocedure)) WHERE grantee=0 AND privilege_type='EXECUTE'),
   'inactive effective ACL '||signature);
 END LOOP;
END $$;
