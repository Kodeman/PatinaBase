-- BEGIN shared runtime
CREATE FUNCTION pg_temp.fi_fid() RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path=public,pg_temp AS $$
 SELECT id FROM public.project_external_fulfilments WHERE project_id=pg_temp.fi_id(201) AND client_request_id='fi-gc'; $$;
CREATE FUNCTION pg_temp.fi_manifest(k text DEFAULT 'fi-manifest-1') RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path=public,pg_temp AS $$
 SELECT manifest_id FROM public.evidence_manifest_requests WHERE project_id=pg_temp.fi_id(201) AND idempotency_key=k; $$;
CREATE FUNCTION pg_temp.fi_members(issue uuid,revisions uuid[],configured boolean DEFAULT true) RETURNS jsonb LANGUAGE sql AS $$
 SELECT COALESCE(jsonb_agg(member),'[]'::jsonb) FROM (
  SELECT jsonb_build_object('kind','plan_issue','id',i.id,'version',i.issue_number,'sha256',i.set_checksum) member FROM public.plan_issues i WHERE i.id=issue
  UNION ALL SELECT jsonb_build_object('kind','coordination_item_revision','id',c.id,'rev',c.rev_number,'sha256',
   encode(extensions.digest(public._plan_room_canonical_json(jsonb_build_object('decisionId',c.decision_id,'rev',c.rev_number,'attachments',c.attachments,'note',c.note)),'sha256'),'hex'))
   FROM public.coordination_item_revisions c WHERE c.id=ANY(revisions)
  UNION ALL SELECT jsonb_build_object('kind','product_configuration','id',c.id,'version',c.version,'sha256',c.snapshot_hash)
   FROM public.product_configurations c WHERE c.id=pg_temp.fi_id(831) AND configured
 ) source; $$;
CREATE FUNCTION pg_temp.fi_call(route text,units text[],key uuid,manifest uuid DEFAULT NULL,evidence jsonb DEFAULT '{}',party uuid DEFAULT NULL) RETURNS jsonb LANGUAGE plpgsql AS $$
DECLARE m uuid:=COALESCE(manifest,pg_temp.fi_manifest()); seat uuid:=COALESCE(party,pg_temp.fi_id(811)); BEGIN
 IF route='direct' THEN RETURN public.record_fabrication_instruction(pg_temp.fi_fid(),m,seat,units,evidence,key); END IF;
 RETURN public.record_external_fulfilment_event(pg_temp.fi_fid(),'fabrication_instruction',evidence||jsonb_build_object('manifestId',m,'authorizingPartyId',seat),units,key::text);
END $$;
-- END shared runtime
SELECT pg_temp.fi_actor(1);
SELECT pg_temp.fi_error($q$SELECT pg_temp.fi_call('direct',ARRAY['k-1'],pg_temp.fi_id(1000))$q$,'55000','scope_editions_inactive','direct capability entry precedes all work');
SELECT pg_temp.fi_error($q$SELECT pg_temp.fi_call('generic',ARRAY['k-1'],pg_temp.fi_id(1000))$q$,'55000','scope_editions_inactive','generic capability entry precedes all work');
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
