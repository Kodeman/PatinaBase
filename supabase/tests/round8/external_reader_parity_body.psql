 BEGIN PERFORM public._ffe_require_usd_budget_rollup('f8830000-0000-4000-8000-000000000090');
 EXCEPTION WHEN check_violation THEN RAISE EXCEPTION 'assertion failed: reader USD guard excludes external legacy price'; END;
 RAISE NOTICE 'PASS: reader USD guard excludes external legacy price';
END $$;
ROLLBACK TO legacy_currency_guard;
