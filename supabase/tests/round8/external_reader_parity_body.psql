-- END shared fixture
-- BEGIN shared native helpers
CREATE FUNCTION pg_temp.package(phase_id uuid DEFAULT NULL, inclusion text DEFAULT 'included', installer text DEFAULT 'gc')
RETURNS jsonb LANGUAGE sql AS $$
 SELECT jsonb_build_object('kind','scope_package','partKey','scope.kitchen','title','Kitchen','payload',
  jsonb_build_object('packageKey','pkg.kitchen','label','Kitchen','inclusion',inclusion,
    'responsibilities',jsonb_build_object('design','studio','purchasing','client','payer','client','fabrication_contract','gc','installation',installer))
  || CASE WHEN phase_id IS NULL THEN '{}'::jsonb ELSE jsonb_build_object('serviceBindings',jsonb_build_object('design',jsonb_build_array(phase_id))) END);
$$;
CREATE FUNCTION pg_temp.policy() RETURNS jsonb LANGUAGE sql AS $$
 SELECT jsonb_build_object('kind','acceptance_signer_policy','partKey','scope.signers','title','Signers','payload',
  jsonb_build_object('policyRevision',1,'signers',jsonb_build_array(jsonb_build_object('slot','client','required',true,
    'profileId','f8690000-0000-4000-8000-000000000005'))));
$$;
CREATE FUNCTION pg_temp.parts(p uuid) RETURNS jsonb LANGUAGE sql AS $$
 SELECT COALESCE(jsonb_agg(jsonb_build_object('kind',kind,'variant',variant,'partKey',part_key,'title',title,
   'payload',payload,'required',required,'clientVisible',client_visible) ORDER BY position),'[]')
 FROM public.proposal_agreement_parts WHERE proposal_id=p;
$$;
CREATE FUNCTION pg_temp.draft(p uuid, scope_parts boolean DEFAULT true) RETURNS void LANGUAGE plpgsql AS $$
DECLARE phase_id uuid;
BEGIN
 INSERT INTO public.proposals(id,designer_id,designer_client_id,client_id,title,total_amount,status,valid_until)
 VALUES(p,'f8690000-0000-4000-8000-000000000001','f8692000-0000-4000-8000-000000000001',
   'f8690000-0000-4000-8000-000000000005','Scope execution draft',0,'draft',now()+interval '30 days');
 INSERT INTO public.proposal_phases(proposal_id,name,phase_key,duration_days,lane,fee_cents,sort_order)
 VALUES(p,'Design','design-development',5,'main',0,0) RETURNING id INTO phase_id;
 PERFORM public.upsert_design_services_draft(p,jsonb_build_object('scope','Interior design services',
   'deliverables',jsonb_build_array('Selections'),'exclusions','[]'::jsonb,'billingCeilingCents',100000,
   'retainerAmountCents',0,'retainerActivationPolicy','immediate','billingCadence','monthly',
   'currency','USD','terms','Signed actual hours','currentRateVersion',1),
   jsonb_build_array(jsonb_build_object('version',1,'roleName','Designer','hourlyRateCents',12000,'sortOrder',0,'effectiveAt',now()-interval '1 day')));
 IF scope_parts THEN
   PERFORM public.materialize_standard_parts(p);
   PERFORM public.upsert_agreement_parts(p,pg_temp.parts(p)||jsonb_build_array(pg_temp.package(phase_id),pg_temp.policy()),'execution fixture');
 END IF;
END $$;
CREATE FUNCTION pg_temp.send_and_sign(p uuid, paper boolean DEFAULT false) RETURNS void LANGUAGE plpgsql AS $$
DECLARE snapshot jsonb;
BEGIN
 IF paper THEN
   PERFORM public.record_paper_client_signature(p,'Execution Client',current_date,NULL::uuid,true);
 ELSE
   snapshot:=public.get_commercial_document_send_snapshot(p);
   PERFORM public.send_commercial_document(p,snapshot->>'documentFingerprint',NULL,now()+interval '30 days');
   PERFORM pg_temp.actor(5);
   PERFORM public.sign_design_services_agreement(p,'Execution Client');
   PERFORM pg_temp.actor(1);
 END IF;
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.actor(integer),pg_temp.send_and_sign(uuid,boolean) TO authenticated;
GRANT EXECUTE ON FUNCTION pg_temp.assert_true(boolean,text),pg_temp.expect_error(text,text,text,text) TO authenticated,anon;
-- END shared native helpers

-- Native signatures and immutable editions, not forged signature rows.
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SELECT pg_temp.actor(1);
SELECT pg_temp.draft('f8693000-0000-4000-8000-000000008831');
SELECT pg_temp.send_and_sign('f8693000-0000-4000-8000-000000008831');
CREATE TEMP TABLE amendment_fixture(key text PRIMARY KEY,value jsonb);
INSERT INTO amendment_fixture VALUES('origin',public.countersign_design_services_agreement(
 'f8693000-0000-4000-8000-000000008831','Execution Designer'));
CREATE FUNCTION pg_temp.reader_job() RETURNS uuid LANGUAGE sql AS $$
 SELECT (value->>'projectId')::uuid FROM amendment_fixture WHERE key='origin'; $$;
CREATE FUNCTION pg_temp.reader_external(request text) RETURNS jsonb LANGUAGE sql AS $$
 SELECT public.create_external_fulfilment(pg_temp.reader_job(),(SELECT id FROM public.project_scope_editions
 WHERE project_id=pg_temp.reader_job() AND status='active'),'pkg.kitchen','client_furnishing',ARRAY['chair'],NULL,NULL,request); $$;
CREATE FUNCTION pg_temp.reader_amendment(payer text) RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE draft jsonb; p uuid; parts jsonb;
BEGIN
 draft:=public.create_service_addendum(pg_temp.reader_job(),'Reader amendment'); p:=(draft->>'proposalId')::uuid;
 PERFORM public.copy_agreement_parts_from_authority(p,'Reader amendment composition');
 SELECT jsonb_agg(CASE WHEN x->>'kind'='scope_package' THEN jsonb_set(x,'{payload,responsibilities,payer}',to_jsonb(payer))
 ELSE x END ORDER BY ord) INTO parts FROM jsonb_array_elements(pg_temp.parts(p)) WITH ORDINALITY a(x,ord);
 PERFORM public.upsert_agreement_parts(p,parts,'Reader responsibility change');
 RETURN p;
END $$;
CREATE FUNCTION pg_temp.reader_proposal() RETURNS uuid LANGUAGE sql AS $$
 SELECT (value->>'proposalId')::uuid FROM amendment_fixture WHERE key='amendment'; $$;
CREATE FUNCTION pg_temp.reader_send() RETURNS jsonb LANGUAGE sql AS $$
 SELECT public.send_commercial_document(pg_temp.reader_proposal(),public._commercial_document_fingerprint(pg_temp.reader_proposal())); $$;
CREATE FUNCTION pg_temp.reader_counter() RETURNS jsonb LANGUAGE sql AS $$
 SELECT public.countersign_design_services_agreement(pg_temp.reader_proposal(),'Execution Designer'); $$;
CREATE FUNCTION pg_temp.reader_reconcile() RETURNS jsonb LANGUAGE sql AS $$
 SELECT public.reconcile_scope_edition(pg_temp.reader_job(),(SELECT id FROM public.project_commercial_documents
 WHERE proposal_id=pg_temp.reader_proposal()),'f8830000-0000-4000-8000-000000000001'); $$;
INSERT INTO amendment_fixture VALUES('external1',pg_temp.reader_external('reader-external1'));
-- A non-liability amendment is still permitted with an external binding.
SAVEPOINT compatible_amendment;
INSERT INTO amendment_fixture VALUES('amendment',jsonb_build_object('proposalId',pg_temp.reader_amendment('client')));
SELECT pg_temp.send_and_sign(pg_temp.reader_proposal());
SELECT pg_temp.reader_counter();
SELECT pg_temp.assert_true((SELECT count(*)=2 FROM public.project_scope_editions WHERE project_id=pg_temp.reader_job()),
 'hold compatible amendment still executes with external binding');
ROLLBACK TO compatible_amendment;
INSERT INTO amendment_fixture VALUES('amendment',jsonb_build_object('proposalId',pg_temp.reader_amendment('studio')));
SELECT pg_temp.expect_error('SELECT pg_temp.reader_send()','23514','scope_amendment_external_binding_live',
 'hold send refuses uncontracted live binding');
SAVEPOINT send_contract;
SELECT public.record_external_fulfilment_event((SELECT (value->>'fulfilmentId')::uuid FROM amendment_fixture WHERE key='external1'),
 'contract_reported','{"contractAmountCents":100}',NULL,'reader-contract-send');
SELECT pg_temp.expect_error('SELECT pg_temp.reader_send()','23514','scope_amendment_external_transfer_unowned',
 'hold send refuses contracted live transfer');
ROLLBACK TO send_contract;
SELECT public.record_external_fulfilment_event((SELECT (value->>'fulfilmentId')::uuid FROM amendment_fixture WHERE key='external1'),
 'cancelled','{}',NULL,'reader-cancel-first');
SELECT pg_temp.send_and_sign(pg_temp.reader_proposal());
INSERT INTO amendment_fixture VALUES('external2',pg_temp.reader_external('reader-external2'));
SELECT pg_temp.expect_error('SELECT pg_temp.reader_counter()','23514','scope_amendment_external_binding_live',
 'hold countersign rechecks binding created after client signature');
SAVEPOINT counter_contract;
SELECT public.record_external_fulfilment_event((SELECT (value->>'fulfilmentId')::uuid FROM amendment_fixture WHERE key='external2'),
 'contract_reported','{"contractAmountCents":100}',NULL,'reader-contract-counter');
SELECT pg_temp.expect_error('SELECT pg_temp.reader_counter()','23514','scope_amendment_external_transfer_unowned',
 'hold countersign refuses contracted live transfer');
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
SELECT pg_temp.reader_counter();
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SELECT pg_temp.expect_error('SELECT pg_temp.reader_reconcile()','23514','scope_amendment_external_transfer_unowned',
 'hold reconciliation refuses contracted live transfer');
ROLLBACK TO counter_contract;
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
SELECT pg_temp.reader_counter();
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SELECT pg_temp.expect_error('SELECT pg_temp.reader_reconcile()','23514','scope_amendment_external_binding_live',
 'hold reconciliation rechecks live uncontracted binding');
SELECT public.record_external_fulfilment_event((SELECT (value->>'fulfilmentId')::uuid FROM amendment_fixture WHERE key='external2'),
 'cancelled','{}',NULL,'reader-cancel-stale');
SELECT pg_temp.reader_reconcile();
SELECT pg_temp.assert_true((SELECT count(*)=1 FROM public.project_scope_editions
 WHERE project_id=pg_temp.reader_job() AND status='active' AND edition_number=2),
 'hold stale-edition cancellation exit permits reconciliation when no binding remains');
\echo external_reader_parity: reader and amendment assertions passed
