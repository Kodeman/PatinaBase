-- Include-only; each entry point owns BEGIN/ROLLBACK.
CREATE FUNCTION pg_temp.c1_assert(ok boolean,label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',label; END IF;
 RAISE NOTICE 'PASS: %',label;
END $$;
CREATE FUNCTION pg_temp.c1_error(command text,state text,message text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
 BEGIN EXECUTE command;
 EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
 END;
 PERFORM pg_temp.c1_assert(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
 label||format(' expected %s/%s got %s/%s',state,message,actual_state,actual_message));
END $$;

DO $$ DECLARE f record; t text; BEGIN
 PERFORM pg_temp.c1_assert(to_regclass('public.project_packages') IS NOT NULL
   AND to_regclass('public.plan_sheet_rooms') IS NOT NULL
   AND to_regclass('public.plan_sheet_packages') IS NOT NULL,
   'C1 composition tables exist on candidate');
 FOR f IN SELECT oid::regprocedure signature,proname FROM pg_proc WHERE pronamespace='public'::regnamespace
 AND proname IN ('can_compose_project_plan','create_project_package','bind_project_package_key',
 'set_plan_sheet_rooms','set_plan_sheet_packages','_guard_plan_composition','_assert_plan_package_key') LOOP
  PERFORM pg_temp.c1_assert(NOT has_function_privilege('anon',f.signature,'EXECUTE'),'anon denied '||f.signature);
  PERFORM pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM pg_proc p,aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a
   WHERE p.oid=f.signature::oid AND a.grantee=0 AND a.privilege_type='EXECUTE'),'PUBLIC denied '||f.signature);
  PERFORM pg_temp.c1_assert(has_function_privilege('authenticated',f.signature,'EXECUTE') = (left(f.proname,1)<>'_'),
    'authenticated exact execute '||f.signature);
 END LOOP;
 FOREACH t IN ARRAY ARRAY['project_packages','plan_sheet_rooms','plan_sheet_packages'] LOOP
  PERFORM pg_temp.c1_assert(has_table_privilege('authenticated','public.'||t,'SELECT'),'studio read grant '||t);
  PERFORM pg_temp.c1_assert(NOT has_table_privilege('authenticated','public.'||t,'INSERT,UPDATE,DELETE,TRUNCATE'),'no direct writes '||t);
  PERFORM pg_temp.c1_assert(NOT has_table_privilege('anon','public.'||t,'SELECT'),'anon no read '||t);
 END LOOP;
 IF to_regclass('pg_temp.c1_native_before') IS NOT NULL THEN
  PERFORM pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM c1_native_before b JOIN pg_proc p ON p.oid=b.oid WHERE p.prosrc<>b.prosrc),
    'holdings, issue, print writers and shared predicate byte-identical');
 END IF;
END $$;
SELECT pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM auth.users WHERE id::text LIKE 'f871%'),'fictional actors absent');
-- Frozen-scope fixture only: replica skips native execution/immutability triggers.
-- No executed agreement or authority is manufactured by a production RPC here.
SET LOCAL session_replication_role=replica;
