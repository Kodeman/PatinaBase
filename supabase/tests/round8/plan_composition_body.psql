SET LOCAL session_replication_role=origin;

CREATE FUNCTION pg_temp.c1_create(code text,key text DEFAULT NULL,request text DEFAULT 'create') RETURNS public.project_packages LANGUAGE sql AS $$
 SELECT public.create_project_package('f8712000-0000-4000-8000-000000000001','cabinetry',code,'Kitchen',request,NULL,key);
$$;
CREATE TEMP TABLE c1_ids(name text PRIMARY KEY,id uuid);
GRANT ALL ON c1_ids TO authenticated;
GRANT EXECUTE ON FUNCTION pg_temp.c1_assert(boolean,text), pg_temp.c1_error(text,text,text,text), pg_temp.c1_create(text,text,text) TO authenticated;
SELECT set_config('request.jwt.claim.sub','f8710000-0000-4000-8000-000000000002',true);
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_assert(public.can_compose_project_plan('f8712000-0000-4000-8000-000000000001'),'A member admitted');
SELECT pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid()
 AND relation='public.project_rooms'::regclass AND mode='RowShareLock'),
 'key-only bind starts without a room SHARE lock');
SELECT pg_temp.c1_assert((public.bind_project_package_key('f8719000-0000-4000-8000-000000000001','pkg.home-room')).package_key='pkg.home-room',
 'key-only bind with assigned home room succeeds');
-- This transaction inserted the fixture, so the FK rechecks even an unchanged
-- home and takes KEY SHARE. Inspect tuple modes to distinguish the guard's SHARE
-- lock from that native FK lock, rather than conflating both as RowShareLock.
SELECT pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM extensions.pgrowlocks('public.project_rooms') l
 WHERE l.locked_row=(SELECT ctid FROM public.project_rooms WHERE id='f8713000-0000-4000-8000-000000000004')
 AND pg_backend_pid()=ANY(l.pids) AND NOT (l.modes <@ ARRAY['For Key Share']::text[])),
 'key-only bind takes no room SHARE lock');
SELECT pg_temp.c1_assert((SELECT project_room_id='f8713000-0000-4000-8000-000000000004'
 FROM public.project_packages WHERE id='f8719000-0000-4000-8000-000000000001'),
 'key-only bind retains assigned home room');
SELECT pg_temp.c1_assert((SELECT count(*)=0 FROM public.plan_sheet_rooms),'populated legacy sheets get no guessed links');
INSERT INTO c1_ids SELECT 'bound',(pg_temp.c1_create('K','pkg.kitchen-cabinetry')).id;
SELECT pg_temp.c1_assert((pg_temp.c1_create('K','pkg.kitchen-cabinetry')).id=(SELECT id FROM c1_ids WHERE name='bound'),'identical create replays UUID');
SELECT pg_temp.c1_error($q$SELECT pg_temp.c1_create('different','pkg.kitchen-cabinetry')$q$,'23505','idempotency_key_reused','changed request refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.c1_create('X','pkg.unknown','unknown')$q$,'23514','package_key_not_in_edition','unknown signed key refuses');
INSERT INTO c1_ids SELECT 'null',(pg_temp.c1_create('B',NULL,'null')).id;
SELECT pg_temp.c1_assert((SELECT package_key IS NULL FROM public.project_packages WHERE id=(SELECT id FROM c1_ids WHERE name='null')),'composition UUID is not signed key');
SELECT pg_temp.c1_assert((public.bind_project_package_key((SELECT id FROM c1_ids WHERE name='null'),'pkg.other')).package_key='pkg.other','NULL key binds exact canonical key');
SELECT pg_temp.c1_assert((public.bind_project_package_key((SELECT id FROM c1_ids WHERE name='null'),'pkg.other')).package_key='pkg.other','same key binding replays');
SELECT pg_temp.c1_error($q$SELECT public.bind_project_package_key((SELECT id FROM c1_ids WHERE name='null'),'pkg.kitchen-cabinetry')$q$,'23514','package_key_immutable','bound key cannot move');
SELECT public.set_plan_sheet_rooms('f8714000-0000-4000-8000-000000000001',ARRAY['f8713000-0000-4000-8000-000000000001']::uuid[]);
SELECT pg_temp.c1_assert(public.set_plan_sheet_rooms('f8714000-0000-4000-8000-000000000001',ARRAY['f8713000-0000-4000-8000-000000000001','f8713000-0000-4000-8000-000000000001']::uuid[])->'roomIds'='["f8713000-0000-4000-8000-000000000001"]','room sets dedupe and replay');
SELECT public.set_plan_sheet_rooms('f8714000-0000-4000-8000-000000000004',ARRAY['f8713000-0000-4000-8000-000000000001']::uuid[]);
SELECT public.set_plan_sheet_packages('f8714000-0000-4000-8000-000000000001',ARRAY[(SELECT id FROM c1_ids WHERE name='bound')]);
SELECT public.set_plan_sheet_packages('f8714000-0000-4000-8000-000000000004',ARRAY[(SELECT id FROM c1_ids WHERE name='bound')]);
SELECT pg_temp.c1_assert((SELECT count(*)=2 FROM public.plan_sheet_packages),'A reads exact package joins without transmittals');
SELECT pg_temp.c1_error($q$UPDATE public.project_rooms SET project_id='f8712000-0000-4000-8000-000000000002' WHERE id='f8713000-0000-4000-8000-000000000001'$q$,
 '23514','plan_composition_room_project_immutable','linked room reparent refuses');
SELECT pg_temp.c1_assert((SELECT count(*)=2 AND bool_and(r.project_id=s.project_id)
 FROM public.plan_sheet_rooms j JOIN public.project_rooms r ON r.id=j.project_room_id
 JOIN public.plan_sheets s ON s.id=j.sheet_id),'refused reparent retains same-project sheet links');
SELECT public.create_project_package('f8712000-0000-4000-8000-000000000001','build','HOME','Home room','home-room','f8713000-0000-4000-8000-000000000004');
SELECT pg_temp.c1_error($q$UPDATE public.project_rooms SET project_id='f8712000-0000-4000-8000-000000000002' WHERE id='f8713000-0000-4000-8000-000000000004'$q$,
 '23514','plan_composition_room_project_immutable','package home room reparent refuses');
UPDATE public.project_rooms SET project_id=project_id WHERE id='f8713000-0000-4000-8000-000000000001';
SELECT pg_temp.c1_assert((SELECT project_id='f8712000-0000-4000-8000-000000000001' FROM public.project_rooms WHERE id='f8713000-0000-4000-8000-000000000004'),
 'refused reparent retains package home project');
UPDATE public.project_rooms SET project_id='f8712000-0000-4000-8000-000000000002' WHERE id='f8713000-0000-4000-8000-000000000005';
SELECT pg_temp.c1_assert((SELECT project_id='f8712000-0000-4000-8000-000000000002' FROM public.project_rooms WHERE id='f8713000-0000-4000-8000-000000000005'),
 'unlinked room can still move');
SELECT pg_temp.c1_error($q$SELECT public.set_plan_sheet_rooms('f8714000-0000-4000-8000-000000000001',ARRAY['f8713000-0000-4000-8000-000000000002']::uuid[])$q$,'23514','plan_sheet_link_off_project','foreign room atomic refusal');
SELECT pg_temp.c1_assert((SELECT count(*)=2 FROM public.plan_sheet_rooms),'bad replacement retains prior room sets');
SELECT pg_temp.c1_assert(public.set_plan_sheet_packages('f8714000-0000-4000-8000-000000000004',ARRAY[(SELECT id FROM c1_ids WHERE name='null'),(SELECT id FROM c1_ids WHERE name='null')])->'packageIds'=to_jsonb(ARRAY[(SELECT id FROM c1_ids WHERE name='null')]),'package set replaces exactly and dedupes');
SELECT pg_temp.c1_error($q$SELECT public.set_plan_sheet_packages('f8714000-0000-4000-8000-000000000001',ARRAY['f8719999-0000-4000-8000-000000000001']::uuid[])$q$,'23514','plan_sheet_link_off_project','missing package refuses atomically');
SELECT pg_temp.c1_error($q$SELECT public.create_project_package('f8712000-0000-4000-8000-000000000001','build','F','Foreign room','foreign-room','f8713000-0000-4000-8000-000000000002')$q$,'23514','plan_sheet_link_off_project','package home room cannot cross project');
SELECT pg_temp.c1_error($q$UPDATE public.project_packages SET package_key=NULL$q$,'42501',NULL,'direct package writes denied');
RESET ROLE;
SELECT pg_temp.c1_error($q$UPDATE public.project_packages SET project_room_id='f8713000-0000-4000-8000-000000000002'
 WHERE id='f8719000-0000-4000-8000-000000000001'$q$,'23514','plan_sheet_link_off_project',
 'home room reassignment to another project refuses');
SELECT pg_temp.c1_assert((SELECT project_room_id='f8713000-0000-4000-8000-000000000004'
 FROM public.project_packages WHERE id='f8719000-0000-4000-8000-000000000001'),
 'refused home room reassignment retains prior room');
UPDATE public.project_packages SET project_room_id='f8713000-0000-4000-8000-000000000001'
 WHERE id='f8719000-0000-4000-8000-000000000001';
SELECT pg_temp.c1_assert((SELECT project_room_id='f8713000-0000-4000-8000-000000000001'
 FROM public.project_packages WHERE id='f8719000-0000-4000-8000-000000000001'),
 'home room reassignment within project succeeds');
-- Archive is trusted maintenance; identity is retained, live display code reusable.
UPDATE public.project_packages SET archived_at=now() WHERE id=(SELECT id FROM c1_ids WHERE name='bound');
SELECT set_config('request.jwt.claim.sub','f8710000-0000-4000-8000-000000000002',true);
SET LOCAL ROLE authenticated;
INSERT INTO c1_ids SELECT 'replacement',(pg_temp.c1_create('K',NULL,'replacement')).id;
SELECT pg_temp.c1_error($q$SELECT public.bind_project_package_key((SELECT id FROM c1_ids WHERE name='replacement'),'pkg.kitchen-cabinetry')$q$,'23505','package_key_taken','archived key never reassigned');
RESET ROLE;
SELECT pg_temp.c1_error($q$UPDATE public.project_packages SET project_id='f8712000-0000-4000-8000-000000000002' WHERE id=(SELECT id FROM c1_ids WHERE name='bound')$q$,'23514','package_key_immutable','trigger freezes package project');
SELECT pg_temp.c1_error($q$INSERT INTO public.plan_sheet_packages(sheet_id,package_id) VALUES('f8714000-0000-4000-8000-000000000002',(SELECT id FROM c1_ids WHERE name='bound'))$q$,'23514','plan_sheet_link_off_project','service cross-project package link refuses');
SELECT pg_temp.c1_error($q$UPDATE public.plan_sheet_rooms SET project_room_id='f8713000-0000-4000-8000-000000000002'$q$,'23514','plan_sheet_link_off_project','update link guard refuses');
SET LOCAL session_replication_role=replica;
UPDATE public.project_scope_editions SET status='stale' WHERE id='f8716000-0000-4000-8000-000000000001';
SET LOCAL session_replication_role=origin;
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_error($q$SELECT pg_temp.c1_create('S','pkg.other','stale')$q$,'23514','package_key_not_in_edition','stale edition is not agreed active scope');
RESET ROLE;

-- All new RPCs and all three new reads enforce recorded studio, not pair membership.
DO $$ DECLARE actor integer; label text; command text; BEGIN
 FOR actor IN 3..5 LOOP
  label:=CASE actor WHEN 3 THEN 'B-only' WHEN 4 THEN 'A guest' ELSE 'client' END;
  PERFORM set_config('request.jwt.claim.sub',('f8710000-0000-4000-8000-'||lpad(actor::text,12,'0')),true);
  SET LOCAL ROLE authenticated;
  PERFORM pg_temp.c1_assert(NOT public.can_compose_project_plan('f8712000-0000-4000-8000-000000000001'),label||' compose denied');
  PERFORM pg_temp.c1_error($q$SELECT pg_temp.c1_create('denied',NULL,'denied')$q$,'42501','plan_composition_forbidden',label||' create denied');
  PERFORM pg_temp.c1_error($q$SELECT public.bind_project_package_key((SELECT id FROM c1_ids WHERE name='bound'),'pkg.kitchen-cabinetry')$q$,'42501','plan_composition_forbidden',label||' replay bind denied');
  PERFORM pg_temp.c1_error($q$SELECT public.set_plan_sheet_rooms('f8714000-0000-4000-8000-000000000001','{}')$q$,'42501','plan_composition_forbidden',label||' room write denied');
  PERFORM pg_temp.c1_error($q$SELECT public.set_plan_sheet_packages('f8714000-0000-4000-8000-000000000001','{}')$q$,'42501','plan_composition_forbidden',label||' package write denied');
  PERFORM pg_temp.c1_assert((SELECT count(*)=0 FROM public.project_packages),label||' no package rows');
  PERFORM pg_temp.c1_assert((SELECT count(*)=CASE WHEN actor=5 THEN 1 ELSE 0 END FROM public.plan_sheet_rooms),label||' shared-only room links');
  PERFORM pg_temp.c1_assert((SELECT count(*)=CASE WHEN actor=5 THEN 1 ELSE 0 END FROM public.plan_sheet_packages),label||' shared-only package links');
  RESET ROLE;
 END LOOP;
END $$;
SELECT set_config('request.jwt.claim.sub','f8710000-0000-4000-8000-000000000002',true);
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_error($q$SELECT public.create_project_package('f8712000-0000-4000-8000-000000000003','build','N','No studio','no-studio')$q$,'42501','plan_composition_forbidden','studio-less co-member denied');
RESET ROLE;
SELECT set_config('request.jwt.claim.sub','f8710000-0000-4000-8000-000000000001',true);
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_assert((public.create_project_package('f8712000-0000-4000-8000-000000000003','build','N','No studio','no-studio')).id IS NOT NULL,'studio-less recorded designer allowed');
SELECT public.set_plan_sheet_rooms('f8714000-0000-4000-8000-000000000001','{}');
SELECT pg_temp.c1_assert((SELECT count(*)=1 FROM public.plan_sheet_rooms),'empty set clears only targeted sheet');
RESET ROLE;
SELECT pg_temp.c1_assert((SELECT NOT enabled FROM public.server_capabilities WHERE key='scope_editions'),'scope execution activation unchanged false');
