-- Pre-existing home assignment: avoid retaining the INSERT guard's room lock
-- before measuring the key-only bind in this transaction.
INSERT INTO public.project_packages(id,project_id,package_kind,code,title,project_room_id,idempotency_key,request_hash)
VALUES ('f8719000-0000-4000-8000-000000000001','f8712000-0000-4000-8000-000000000001',
