-- Include-only: the wrapper must own BEGIN/ROLLBACK.
-- Item-version and package-assignment checkpoint; conversion/writer coverage is pending.
CREATE FUNCTION pg_temp.presence_assert(ok boolean,label text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',label; END IF;
 RAISE NOTICE 'PASS: %',label;
END $$;

SELECT pg_temp.presence_assert(EXISTS (
 SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='project_ffe_items'
 AND column_name='row_version' AND data_type='bigint' AND is_nullable='NO'),
 'item row version is a required bigint concurrency authority');
SELECT pg_temp.presence_assert(NOT has_function_privilege('anon','public._ffe_bump_item_row_version()','EXECUTE')
 AND NOT has_function_privilege('authenticated','public._ffe_bump_item_row_version()','EXECUTE')
 AND NOT has_function_privilege('service_role','public._ffe_bump_item_row_version()','EXECUTE')
 AND NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc
  WHERE oid='public._ffe_bump_item_row_version()'::regprocedure)) WHERE grantee=0 AND privilege_type='EXECUTE'),
 'item version helper is revoked from all API roles');
SELECT pg_temp.presence_assert(NOT EXISTS(SELECT 1 FROM public.project_ffe_items
 WHERE id='f8760000-0000-4000-8000-000000000001'), 'item version fixture namespace starts empty');

-- Only seed setup bypasses native setup triggers; all measured updates below
-- run with every native item trigger enabled and real parent rows present.
SET LOCAL session_replication_role=replica;
INSERT INTO auth.users(id,email,encrypted_password,email_confirmed_at,created_at,updated_at,aud,role)
VALUES('f8760000-0000-4000-8000-000000000004','presence-version@test.invalid','',now(),now(),now(),'authenticated','authenticated');
INSERT INTO public.profiles(id,email,full_name,is_designer)
VALUES('f8760000-0000-4000-8000-000000000004','presence-version@test.invalid','Presence version fixture',true);
INSERT INTO public.projects(id,name,designer_id,created_by,status)
VALUES('f8760000-0000-4000-8000-000000000002','Presence version fixture',
 'f8760000-0000-4000-8000-000000000004','f8760000-0000-4000-8000-000000000004','active');
INSERT INTO public.project_ffe_items(id,project_id,name,selection_thread_id)
VALUES('f8760000-0000-4000-8000-000000000001','f8760000-0000-4000-8000-000000000002',
 'External presence version fixture','f8760000-0000-4000-8000-000000000003');
SET LOCAL session_replication_role=origin;
SELECT pg_temp.presence_assert((SELECT row_version=1 FROM public.project_ffe_items
 WHERE id='f8760000-0000-4000-8000-000000000001'), 'new item starts at version one');
UPDATE public.project_ffe_items SET notes=notes WHERE id='f8760000-0000-4000-8000-000000000001';
SELECT pg_temp.presence_assert((SELECT row_version=2 FROM public.project_ffe_items
 WHERE id='f8760000-0000-4000-8000-000000000001'), 'no-op update advances item version');
UPDATE public.project_ffe_items SET row_version=9000 WHERE id='f8760000-0000-4000-8000-000000000001';
SELECT pg_temp.presence_assert((SELECT row_version=3 FROM public.project_ffe_items
 WHERE id='f8760000-0000-4000-8000-000000000001'), 'caller-supplied update version is ignored');
UPDATE public.project_ffe_items SET notes='native item edit' WHERE id='f8760000-0000-4000-8000-000000000001';
SELECT pg_temp.presence_assert((SELECT row_version=4 AND notes='native item edit' FROM public.project_ffe_items
 WHERE id='f8760000-0000-4000-8000-000000000001'), 'native item edit advances item version');
SELECT pg_temp.presence_assert(NOT (SELECT enabled FROM public.server_capabilities WHERE key='scope_editions'),
 'scope capability remains inactive');

-- Package-assignment checkpoint. All mutations being measured use origin
-- triggers, authenticated execution and the recorded-studio predicate.
CREATE FUNCTION pg_temp.presence_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
 SELECT ('f8760000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.presence_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 PERFORM set_config('request.jwt.claim.sub',pg_temp.presence_id(n)::text,true);
 PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.presence_id(n),'role','authenticated')::text,true);
END $$;
CREATE FUNCTION pg_temp.presence_error(command text,state text,message text,label text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
 BEGIN EXECUTE command;
 EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
 END;
 PERFORM pg_temp.presence_assert(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
 label||format(' expected %s/%s got %s/%s',state,message,actual_state,actual_message));
END $$;
SELECT pg_temp.presence_assert(to_regprocedure('public.assign_ffe_items_to_scope_package(uuid,uuid[],text,text)') IS NOT NULL,
 'package assignment API exists');
DO $$ DECLARE f regprocedure; r text; BEGIN
 FOREACH f IN ARRAY ARRAY['public.assign_ffe_items_to_scope_package(uuid,uuid[],text,text)'::regprocedure,
  'public._ffe_guard_scope_binding()'::regprocedure,'public._ffe_scope_assignment_receipt_guard()'::regprocedure] LOOP
  FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
   PERFORM pg_temp.presence_assert(NOT has_function_privilege(r,f,'EXECUTE'),'safety API inactive for '||r||' '||f);
  END LOOP;
  PERFORM pg_temp.presence_assert(NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc WHERE oid=f))
   WHERE grantee=0 AND privilege_type='EXECUTE'),'safety API inactive for PUBLIC '||f);
 END LOOP;
 PERFORM pg_temp.presence_assert((SELECT relrowsecurity FROM pg_class
  WHERE oid='public.project_ffe_scope_assignment_receipts'::regclass),'assignment receipts use RLS');
 FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  PERFORM pg_temp.presence_assert(NOT has_table_privilege(r,'public.project_ffe_scope_assignment_receipts','SELECT,INSERT,UPDATE,DELETE,TRUNCATE'),
   'assignment receipts inaccessible to '||r);
 END LOOP;
END $$;
SET LOCAL session_replication_role=replica;
