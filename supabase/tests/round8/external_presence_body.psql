SELECT pg_temp.presence_error($q$SELECT public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(1),pg_temp.presence_id(99)],'pkg.chairs','missing')$q$,
