SELECT pg_temp.presence_assert((SELECT row_version=4 AND scope_package_key IS NULL FROM public.project_ffe_items WHERE id=pg_temp.presence_id(1))
 AND NOT EXISTS(SELECT 1 FROM public.project_ffe_scope_assignment_receipts),'rejected assignments change neither items nor receipts');
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_assert(NOT (public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(15),pg_temp.presence_id(1)],'pkg.chairs','assign')->>'replayed')::boolean,
 'recorded-studio member assigns multiple items');
SELECT pg_temp.presence_assert((public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(15),pg_temp.presence_id(1)],'pkg.chairs','assign')->>'replayed')::boolean,
 'original requester exact assignment replays');
SELECT pg_temp.presence_error($q$SELECT public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(15),pg_temp.presence_id(1)],'pkg.tables','assign')$q$,
 '40001','external_request_changed','assignment receipt rejects changed payload');
SELECT pg_temp.presence_actor(4);
SELECT pg_temp.presence_error($q$SELECT public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(15),pg_temp.presence_id(1)],'pkg.chairs','assign')$q$,
 '42501','idempotency_key_reused','another authorized requester cannot replay assignment');
