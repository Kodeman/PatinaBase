SELECT pg_temp.presence_id(n),pg_temp.presence_id(CASE WHEN n=13 THEN 12 ELSE 2 END),'Presence assignment fixture',pg_temp.presence_id(100+n),
 CASE WHEN n=14 THEN 'pkg.chairs' END,CASE WHEN n=14 THEN pg_temp.presence_id(30) END FROM generate_series(13,15)n;
SET LOCAL session_replication_role=origin;
GRANT EXECUTE ON FUNCTION public.assign_ffe_items_to_scope_package(uuid,uuid[],text,text) TO authenticated;
GRANT EXECUTE ON FUNCTION pg_temp.presence_assert(boolean,text),pg_temp.presence_id(integer),
 pg_temp.presence_actor(integer),pg_temp.presence_error(text,text,text,text) TO authenticated,service_role;
SELECT pg_temp.presence_actor(4);
SELECT pg_temp.presence_error($q$SELECT public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(1)],'pkg.chairs','inactive')$q$,
 '55000','scope_editions_inactive','assignment capability gate refuses while inactive');
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_actor(5);
SELECT pg_temp.presence_error($q$SELECT public.assign_ffe_items_to_scope_package(pg_temp.presence_id(2),ARRAY[pg_temp.presence_id(1)],'pkg.chairs','b-only')$q$,
 '42501','external_fulfilment_access','B-only co-member cannot assign recorded-A job');
SELECT pg_temp.presence_actor(7);
