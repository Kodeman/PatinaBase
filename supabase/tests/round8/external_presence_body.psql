SELECT set_config('patina.ffe_scope_binding_writer','00876',true);
SELECT pg_temp.presence_error($q$UPDATE public.project_ffe_items SET scope_package_key='pkg.tables' WHERE id=pg_temp.presence_id(14)$q$,
 '23514','external_presence_binding_mismatch','external package must match immutable fulfilment');
SELECT pg_temp.presence_error($q$UPDATE public.project_ffe_items SET unit_price_cents=123,line_total_cents=123 WHERE id=pg_temp.presence_id(14)$q$,
 '23514','project_ffe_items_external_unpriced_check','external line cannot carry a studio price');
SELECT set_config('patina.ffe_scope_binding_writer','',true);
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
