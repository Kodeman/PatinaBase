-- Ruling #206: independent reported total, per-line immutable estimate history.
DO $$ DECLARE f regprocedure; r text; BEGIN
 FOREACH f IN ARRAY ARRAY[
  'public.set_ffe_item_external_fulfilment(uuid,uuid,bigint,text)'::regprocedure,
  'public._ffe_external_pricing_snapshot(public.project_ffe_items)'::regprocedure,
  'public._ffe_external_conversion_receipt_guard()'::regprocedure] LOOP
  FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
   PERFORM pg_temp.presence_assert(NOT has_function_privilege(r,f,'EXECUTE'),'conversion inactive for '||r||' '||f);
  END LOOP;
  PERFORM pg_temp.presence_assert(NOT EXISTS(SELECT 1 FROM aclexplode((SELECT proacl FROM pg_proc WHERE oid=f))
   WHERE grantee=0 AND privilege_type='EXECUTE'),'conversion inactive for PUBLIC '||f);
 END LOOP;
 PERFORM pg_temp.presence_assert((SELECT relrowsecurity FROM pg_class
  WHERE oid='public.project_ffe_external_conversion_receipts'::regclass),'conversion receipts use RLS');
 FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
  PERFORM pg_temp.presence_assert(NOT has_table_privilege(r,'public.project_ffe_external_conversion_receipts','SELECT,INSERT,UPDATE,DELETE,TRUNCATE'),
   'conversion receipts inaccessible to '||r);
 END LOOP;
END $$;
