 '55000','scope_editions_inactive','conversion capability gate refuses while inactive');
RESET ROLE;
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_actor(5);
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(40),pg_temp.presence_id(30),2,'other-studio')$q$,
 '42501','external_fulfilment_access','other-studio member cannot convert recorded-A item');
SELECT pg_temp.presence_actor(6);
