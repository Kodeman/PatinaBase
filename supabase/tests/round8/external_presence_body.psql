 'PT409','external_conversion_version_conflict','conversion checks native item version');
SELECT pg_temp.presence_assert((public.set_ffe_item_external_fulfilment(b.id,pg_temp.presence_id(30),b.row_version,'convert-'||b.id)->'pricingSnapshot')=b.pricing,
 'each converted line receipt holds its exact native pricing snapshot') FROM presence_before b ORDER BY id;
-- Native purchasing APIs stay active, but external lines cannot enter them.
SELECT pg_temp.presence_error($q$SELECT public.record_studio_purchase(jsonb_build_object(
 'projectId',pg_temp.presence_id(2),'ffeItemId',pg_temp.presence_id(40),
 'kind','antique_auction','payeeName','External supplier','amountCents',100))$q$,
 '23514','external_presence_studio_purchase_refused','native studio purchase refuses converted external line');
RESET ROLE;
SELECT pg_temp.presence_error($q$UPDATE public.project_ffe_items SET purchase_order_id=pg_temp.presence_id(999)
 WHERE id=pg_temp.presence_id(40)$q$,
 '23514','external_presence_purchase_order_refused','native PO trigger refuses external line before legacy early return');
SELECT pg_temp.presence_assert(NOT EXISTS(SELECT 1 FROM public.studio_purchases WHERE ffe_item_id=pg_temp.presence_id(40))
 AND (SELECT purchase_order_id IS NULL FROM public.project_ffe_items WHERE id=pg_temp.presence_id(40)),
 'refused native purchasing leaves no external payable or PO binding');
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_line_pricing(pg_temp.presence_id(40),'quantity',3)$q$,
 '23514','External presence lines are not studio commerce.','native pricing writer refuses external quantity');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(40),pg_temp.presence_id(30),3,'convert-'||pg_temp.presence_id(40))$q$,
 'PT409','external_request_changed','conversion retry refuses changed version payload');
SELECT pg_temp.presence_actor(4);
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(40),pg_temp.presence_id(30),2,'convert-'||pg_temp.presence_id(40))$q$,
 '42501','idempotency_key_reused','another authorized actor cannot replay a conversion receipt');
RESET ROLE;
SELECT pg_temp.presence_assert((SELECT reported_price_cents=7654321 FROM public.project_external_fulfilments WHERE id=pg_temp.presence_id(30)),
 'two converted lines leave independent externally reported total unchanged');
SELECT pg_temp.presence_assert((SELECT count(*)=2 FROM public.project_ffe_external_conversion_receipts),
 'conversion receipts are one per line and refused requests write nothing');
SELECT pg_temp.presence_assert((SELECT bool_and(i.unit_price_cents=0 AND i.line_total_cents=0 AND i.trade_price_cents IS NULL
 AND i.retail_unit_cents IS NULL AND i.scope_package_key='pkg.chairs' AND i.external_fulfilment_id=pg_temp.presence_id(30)
 AND i.row_version=b.row_version+1 AND i.project_room_id IS NOT DISTINCT FROM b.project_room_id
 AND i.selection_thread_id=b.selection_thread_id) FROM public.project_ffe_items i JOIN presence_before b USING(id)),
 'conversion preserves selection and room, binds package and removes studio prices exactly once');
SELECT pg_temp.presence_error($q$UPDATE public.project_ffe_external_conversion_receipts SET pricing_snapshot='{}'$q$,
 '23514','external_conversion_receipt_immutable','conversion receipt UPDATE is refused');
SELECT pg_temp.presence_error($q$DELETE FROM public.project_ffe_external_conversion_receipts$q$,
 '23514','external_conversion_receipt_immutable','conversion receipt DELETE is refused');
SELECT pg_temp.presence_error($q$UPDATE public.project_ffe_items SET quantity=3 WHERE id=pg_temp.presence_id(40)$q$,
 '23514','external_presence_pricing_frozen','privileged native update cannot change external pricing snapshot');
SET LOCAL session_replication_role=replica;
UPDATE public.project_scope_editions SET status='superseded' WHERE id=pg_temp.presence_id(20);
SET LOCAL session_replication_role=origin;
SELECT pg_temp.presence_actor(6);
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_assert((public.set_ffe_item_external_fulfilment(b.id,pg_temp.presence_id(30),b.row_version,'convert-'||b.id)->>'replayed')::boolean,
 'exact conversion retry precedes stale version and inactive edition checks') FROM presence_before b ORDER BY id;
SELECT pg_temp.presence_assert((public.set_ffe_item_external_fulfilment(b.id,NULL,b.row_version+1,'reverse-'||b.id)->'pricingSnapshot')=b.pricing,
 'uncontracted reverse is an exit act on a superseded edition') FROM presence_before b ORDER BY id;
RESET ROLE;
SELECT pg_temp.presence_assert((SELECT bool_and(public._ffe_external_pricing_snapshot(i)=b.pricing AND i.external_fulfilment_id IS NULL
 AND i.row_version=b.row_version+2) FROM public.project_ffe_items i JOIN presence_before b USING(id)),
 'both reverse conversions restore every pricing field byte-equal through native pricing triggers');
SELECT pg_temp.presence_assert((SELECT reported_price_cents=7654321 FROM public.project_external_fulfilments WHERE id=pg_temp.presence_id(30)),
 'reverse conversions never alter externally reported total');
SET LOCAL session_replication_role=replica;
UPDATE public.project_scope_editions SET status='active' WHERE id=pg_temp.presence_id(20);
SET LOCAL session_replication_role=origin;
SET LOCAL ROLE authenticated;
SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(40),pg_temp.presence_id(30),4,'convert-again');
SELECT public.record_external_fulfilment_event(pg_temp.presence_id(30),'contract_reported','{"contractAmountCents":80000}',NULL,'contract');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(40),NULL,5,'reverse-contracted')$q$,
 '23514','external_conversion_contract_reported','even reported-only contract permanently refuses reverse conversion');
RESET ROLE;
UPDATE public.organization_members SET status='suspended' WHERE user_id=pg_temp.presence_id(6) AND organization_id=pg_temp.presence_id(10);
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(40),pg_temp.presence_id(30),4,'convert-again')$q$,
 '42501','external_fulfilment_access','conversion replay rechecks current recorded-studio access');
RESET ROLE;
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';

-- Protected commitments use the authentic native guard on locked items.
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SET LOCAL session_replication_role=replica;
UPDATE public.organization_members SET status='active' WHERE user_id=pg_temp.presence_id(6) AND organization_id=pg_temp.presence_id(10);
INSERT INTO public.project_ffe_items(id,project_id,name,selection_thread_id)
SELECT pg_temp.presence_id(n),pg_temp.presence_id(2),'Committed fixture',pg_temp.presence_id(100+n) FROM generate_series(50,56)n;
INSERT INTO public.proposals(id,designer_id,title,commercial_state)
SELECT pg_temp.presence_id(60+n::integer),pg_temp.presence_id(4),'Protected authorization',s FROM
 unnest(ARRAY['draft','sent','executed']) WITH ORDINALITY AS x(s,n);
INSERT INTO public.project_commercial_documents(id,project_id,proposal_id,document_kind,wave_name,created_by)
SELECT pg_temp.presence_id(70+n),pg_temp.presence_id(2),pg_temp.presence_id(60+n::integer),'furnishings_authorization','Fixture wave '||n,pg_temp.presence_id(4)
 FROM generate_series(1,3)n;
INSERT INTO public.furnishing_authorization_items(id,commercial_document_id,source_ffe_item_id,name,quantity,client_unit_price_cents,client_line_total_cents)
SELECT pg_temp.presence_id(80+n),pg_temp.presence_id(70+n),pg_temp.presence_id(49+n),'Held line',1,100,100 FROM generate_series(1,3)n;
INSERT INTO public.studio_purchases(id,project_id,ffe_item_id,kind,payee_name,purchased_on,amount_cents,status)
VALUES(pg_temp.presence_id(90),pg_temp.presence_id(2),pg_temp.presence_id(53),'one_off','Independent maker',current_date,100,'recorded');
INSERT INTO public.invoice_line_items(id,invoice_id,ffe_item_id,description)
VALUES(pg_temp.presence_id(91),pg_temp.presence_id(92),pg_temp.presence_id(54),'Billed line');
UPDATE public.project_ffe_items SET purchase_order_id=pg_temp.presence_id(93) WHERE id=pg_temp.presence_id(55);
UPDATE public.project_ffe_items SET removed_at=now(),removed_by=pg_temp.presence_id(6),removal_reason='Fixture removed' WHERE id=pg_temp.presence_id(56);
SET LOCAL session_replication_role=origin;
SELECT pg_temp.presence_actor(6);
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(50),pg_temp.presence_id(30),1,'draft-held')$q$,
 '23514','drafted release','forward draft authorization protects conversion before reverse provenance exists');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(51),pg_temp.presence_id(30),1,'sent-held')$q$,
 '23514','Released lines','forward sent authorization protects conversion');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(52),pg_temp.presence_id(30),1,'executed-held')$q$,
 '23514','Released lines','forward executed authorization protects conversion');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(53),pg_temp.presence_id(30),1,'purchase-held')$q$,
 '23514','external_conversion_studio_purchase_live','live native studio purchase protects conversion');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(54),pg_temp.presence_id(30),1,'invoice-held')$q$,
 '23514','invoiced','any native invoice reference protects conversion');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(55),pg_temp.presence_id(30),1,'po-held')$q$,
 '23514','Released lines','native PO protects conversion');
SELECT pg_temp.presence_error($q$SELECT public.set_ffe_item_external_fulfilment(pg_temp.presence_id(56),pg_temp.presence_id(30),1,'removed-held')$q$,
 '23514','removed','native removed-line lock protects conversion');
SELECT pg_temp.presence_error($q$SELECT public.record_external_fulfilment_event(pg_temp.presence_id(30),'cancelled','{}',NULL,'cancel-live')$q$,
 '23514','fulfilment_cancel_lines_live','cancellation refuses live external presence before writing an event');
RESET ROLE;
-- A cancellation reported before a later binding must be checked again by its verifier.
SET LOCAL session_replication_role=replica;
INSERT INTO public.project_external_fulfilment_events(id,fulfilment_id,event_kind,evidence,recorded_by,event_seq,client_request_id,request_hash)
VALUES(pg_temp.presence_id(300),pg_temp.presence_id(30),'cancelled','{}',pg_temp.presence_id(6),100,'cancel-race','fixture');
SET LOCAL session_replication_role=origin;
GRANT EXECUTE ON FUNCTION public.verify_external_fulfilment_event(uuid,text) TO authenticated;
SELECT pg_temp.presence_actor(4);
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_error($q$SELECT public.verify_external_fulfilment_event(pg_temp.presence_id(300),'verify-cancel-race')$q$,
 '23514','fulfilment_cancel_lines_live','cancellation verification rechecks lines bound after the report');
SELECT pg_temp.presence_actor(6);
SELECT public.record_external_fulfilment_event(pg_temp.presence_id(30),'received','{}',NULL,'received');
RESET ROLE;
SELECT pg_temp.presence_assert((SELECT status<>'installed' FROM public.project_ffe_items WHERE id=pg_temp.presence_id(40))
 AND (SELECT purchase_order_id IS NULL FROM public.project_ffe_items WHERE id=pg_temp.presence_id(40)) AND NOT EXISTS(SELECT 1 FROM public.studio_purchases WHERE ffe_item_id=pg_temp.presence_id(40)),
 'reported external receipt does not install presence or create studio purchasing');
CREATE TEMP TABLE presence_install_event AS SELECT NULL::uuid AS id;
GRANT SELECT,UPDATE ON presence_install_event TO authenticated;
GRANT EXECUTE ON FUNCTION public.verify_external_fulfilment_event(uuid,text) TO authenticated;
SET LOCAL ROLE authenticated;
UPDATE presence_install_event SET id=(public.record_external_fulfilment_event(pg_temp.presence_id(30),'installed','{}',NULL,'reported-install')->>'eventId')::uuid;
RESET ROLE;
SELECT pg_temp.presence_assert((SELECT status<>'installed' FROM public.project_ffe_items WHERE id=pg_temp.presence_id(40)),
 'reported-only installation cannot advance presence status');
SET LOCAL ROLE authenticated;
SELECT pg_temp.presence_error($q$SELECT public.verify_external_fulfilment_event((SELECT id FROM presence_install_event),'self-verify')$q$,
 '42501','fulfilment_verifier_required','reporter cannot verify installation');
SELECT pg_temp.presence_actor(4);
SELECT pg_temp.presence_assert((public.verify_external_fulfilment_event((SELECT id FROM presence_install_event),'owner-install')->>'evidenceLevel')='verified',
 'independent recorded-studio owner verifies installation');
SELECT pg_temp.presence_assert((public.verify_external_fulfilment_event((SELECT id FROM presence_install_event),'owner-install')->>'replayed')::boolean,
 'exact installation verification replay writes no second item update');
RESET ROLE;
SELECT pg_temp.presence_assert((SELECT bool_and(status='installed') FROM public.project_ffe_items
 WHERE id IN (pg_temp.presence_id(14),pg_temp.presence_id(40)))
 AND (SELECT row_version=6 FROM public.project_ffe_items WHERE id=pg_temp.presence_id(40)),
 'only verified installed event advances every bound live item exactly once');
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
