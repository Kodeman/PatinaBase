SELECT pg_temp.assert_true((SELECT count(*)=1 FROM public.project_scope_editions WHERE project_id=pg_temp.fixture('job'))
 AND NOT EXISTS(SELECT 1 FROM public.project_scope_reconciliations WHERE project_id=pg_temp.fixture('job')),'final-document failure rolls back every intermediate mint');
