-- BEGIN shared native helpers
CREATE FUNCTION pg_temp.package(phase_id uuid DEFAULT NULL, inclusion text DEFAULT 'included', installer text DEFAULT 'gc')
RETURNS jsonb LANGUAGE sql AS $$
 SELECT jsonb_build_object('kind','scope_package','partKey','scope.kitchen','title','Kitchen','payload',
  jsonb_build_object('packageKey','pkg.kitchen','label','Kitchen','inclusion',inclusion,
    'responsibilities',jsonb_build_object('design','studio','purchasing','client','payer','client','fabrication_contract','gc','installation',installer))
  || CASE WHEN phase_id IS NULL THEN '{}'::jsonb ELSE jsonb_build_object('serviceBindings',jsonb_build_object('design',jsonb_build_array(phase_id))) END);
$$;
CREATE FUNCTION pg_temp.policy() RETURNS jsonb LANGUAGE sql AS $$
 SELECT jsonb_build_object('kind','acceptance_signer_policy','partKey','scope.signers','title','Signers','payload',
  jsonb_build_object('policyRevision',1,'signers',jsonb_build_array(jsonb_build_object('slot','client','required',true,
    'profileId','f8700000-0000-4000-8000-000000000005'))));
$$;
CREATE FUNCTION pg_temp.parts(p uuid) RETURNS jsonb LANGUAGE sql AS $$
 SELECT COALESCE(jsonb_agg(jsonb_build_object('kind',kind,'variant',variant,'partKey',part_key,'title',title,
   'payload',payload,'required',required,'clientVisible',client_visible) ORDER BY position),'[]')
 FROM public.proposal_agreement_parts WHERE proposal_id=p;
$$;
CREATE FUNCTION pg_temp.draft(p uuid, scope_parts boolean DEFAULT true) RETURNS void LANGUAGE plpgsql AS $$
DECLARE phase_id uuid;
BEGIN
 INSERT INTO public.proposals(id,designer_id,designer_client_id,client_id,title,total_amount,status,valid_until)
 VALUES(p,'f8700000-0000-4000-8000-000000000001','f8702000-0000-4000-8000-000000000001',
   'f8700000-0000-4000-8000-000000000005','Scope execution draft',0,'draft',now()+interval '30 days');
 INSERT INTO public.proposal_phases(proposal_id,name,phase_key,duration_days,lane,fee_cents,sort_order)
 VALUES(p,'Design','design-development',5,'main',0,0) RETURNING id INTO phase_id;
 PERFORM public.upsert_design_services_draft(p,jsonb_build_object('scope','Interior design services',
   'deliverables',jsonb_build_array('Selections'),'exclusions','[]'::jsonb,'billingCeilingCents',100000,
   'retainerAmountCents',0,'retainerActivationPolicy','immediate','billingCadence','monthly',
   'currency','USD','terms','Signed actual hours','currentRateVersion',1),
   jsonb_build_array(jsonb_build_object('version',1,'roleName','Designer','hourlyRateCents',12000,'sortOrder',0,'effectiveAt',now()-interval '1 day')));
 IF scope_parts THEN
   PERFORM public.materialize_standard_parts(p);
   PERFORM public.upsert_agreement_parts(p,pg_temp.parts(p)||jsonb_build_array(pg_temp.package(phase_id),pg_temp.policy()),'execution fixture');
 END IF;
END $$;
CREATE FUNCTION pg_temp.send_and_sign(p uuid, paper boolean DEFAULT false) RETURNS void LANGUAGE plpgsql AS $$
DECLARE snapshot jsonb;
BEGIN
 IF paper THEN
   PERFORM public.record_paper_client_signature(p,'Execution Client',current_date,NULL::uuid,true);
 ELSE
   snapshot:=public.get_commercial_document_send_snapshot(p);
   PERFORM public.send_commercial_document(p,snapshot->>'documentFingerprint',NULL,now()+interval '30 days');
   PERFORM pg_temp.actor(5);
   PERFORM public.sign_design_services_agreement(p,'Execution Client');
   PERFORM pg_temp.actor(1);
 END IF;
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.actor(integer),pg_temp.send_and_sign(uuid,boolean) TO authenticated;
GRANT EXECUTE ON FUNCTION pg_temp.assert_true(boolean,text),pg_temp.expect_error(text,text,text,text) TO authenticated,anon;
-- END shared native helpers

-- BEGIN shared reconciliation helpers
CREATE TEMP TABLE scope_reconciliation_fixture(key text PRIMARY KEY,id uuid, result jsonb);
CREATE FUNCTION pg_temp.fixture(key_name text) RETURNS uuid LANGUAGE sql AS $$
 SELECT id FROM scope_reconciliation_fixture WHERE key=key_name;
$$;
CREATE FUNCTION pg_temp.reconcile(target uuid DEFAULT NULL, request uuid DEFAULT 'f8705000-0000-4000-8000-000000000001')
RETURNS jsonb LANGUAGE plpgsql AS $$
BEGIN
 -- On the base bytes there is deliberately no substitute implementation. Keep
 -- the native stale state, then let the same behavioral assertions go red.
 IF to_regprocedure('public.reconcile_scope_edition(uuid,uuid,uuid)') IS NULL THEN RETURN NULL; END IF;
 RETURN public.reconcile_scope_edition(pg_temp.fixture('job'),COALESCE(target,pg_temp.fixture('doc4')),request);
END $$;
CREATE FUNCTION pg_temp.amendment(n integer, slot text) RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE draft jsonb; p uuid; phase uuid; parts jsonb; doc uuid;
BEGIN
 draft:=public.create_service_addendum(pg_temp.fixture('job'),'Paused amendment '||n);
 p:=(draft->>'proposalId')::uuid;
 -- Opposite UUID order to execution sequence, before any signature references.
 doc:=('f8704000-0000-4000-8000-'||lpad((6-n)::text,12,'0'))::uuid;
 SET LOCAL session_replication_role=replica;
 UPDATE public.project_commercial_documents SET id=doc WHERE id=(draft->>'documentId')::uuid;
 SET LOCAL session_replication_role=origin;
 PERFORM public.copy_agreement_parts_from_authority(p,'Paused composition');
 INSERT INTO public.proposal_phases(proposal_id,name,phase_key,duration_days,lane,fee_cents,sort_order)
 VALUES(p,'Added phase '||n,'phase-'||n,5,'main',0,0) RETURNING id INTO phase;
 SELECT jsonb_agg(CASE WHEN part->>'kind'='scope_package' THEN
   jsonb_set(jsonb_set(jsonb_set(part,'{payload}',(part->'payload')-'serviceBindings'),
     '{payload,responsibilities,installation}',to_jsonb(CASE WHEN n>=3 THEN 'studio'::text ELSE 'gc'::text END)),
     '{payload,serviceBindings}',jsonb_build_object(slot,jsonb_build_array(phase)))
   ELSE part END ORDER BY ord) INTO parts FROM jsonb_array_elements(pg_temp.parts(p)) WITH ORDINALITY e(part,ord);
 PERFORM public.upsert_agreement_parts(p,parts,'Bind own amendment phase');
 PERFORM pg_temp.send_and_sign(p);
 INSERT INTO scope_reconciliation_fixture VALUES('proposal'||n,p,NULL),('doc'||n,doc,NULL),('phase'||n,phase,NULL);
 RETURN p;
END $$;
-- END shared reconciliation helpers

-- Staged ACLs, default PUBLIC execute, table privacy and inactive capability.
SELECT pg_temp.assert_true((SELECT NOT enabled FROM public.server_capabilities WHERE key='scope_editions'),'capability ships false');
DO $$ DECLARE f record; r text; BEGIN
 FOR f IN SELECT p.oid::regprocedure signature FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
 WHERE n.nspname='public' AND p.proname IN ('reconcile_scope_edition','_scope_reconciliation_snapshot','_assert_scope_reconciliation_authority') LOOP
  FOREACH r IN ARRAY ARRAY['anon','authenticated'] LOOP
   PERFORM pg_temp.assert_true(NOT has_function_privilege(r,f.signature,'EXECUTE'),r||' no execute '||f.signature);
  END LOOP;
  PERFORM pg_temp.assert_true(NOT EXISTS(SELECT 1 FROM pg_proc p,
   aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid=f.signature::oid AND a.grantee=0 AND a.privilege_type='EXECUTE'),
   'PUBLIC no execute '||f.signature);
 END LOOP;
END $$;
SELECT pg_temp.expect_error($q$SELECT pg_temp.reconcile()$q$,'55000','scope_editions_inactive','inactive reconciliation refuses');
SELECT pg_temp.assert_true((SELECT relrowsecurity FROM pg_class WHERE oid='public.project_scope_reconciliations'::regclass),'receipt RLS enabled');
SELECT pg_temp.assert_true(NOT has_table_privilege('authenticated','public.project_scope_reconciliations','SELECT,INSERT,UPDATE,DELETE')
 AND NOT has_table_privilege('anon','public.project_scope_reconciliations','SELECT,INSERT,UPDATE,DELETE'),'receipt has no client table grants');

