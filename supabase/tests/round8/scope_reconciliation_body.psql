-- The base control skips refusal cases that require the new RPC, not the final
-- behavioral assertions. No missing-function/import error can count as red.
SELECT to_regprocedure('public.reconcile_scope_edition(uuid,uuid,uuid)') IS NOT NULL AS reconciliation_installed \gset
\if :reconciliation_installed
