SET LOCAL session_replication_role=replica;
UPDATE storage.objects SET metadata=jsonb_set(metadata,'{eTag}',to_jsonb('"etag-5"'::text)) WHERE id='f8869000-0000-4000-8000-000000000005';
SET LOCAL session_replication_role=origin;
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirmed',%L,NULL,'rv-expect')$q$,
  pg_temp.v('p2')->>'intakeId',repeat('0',64)),'PT409','paper_document_changed','review checks the expected document hash');
INSERT INTO sa_results VALUES('rv2',public.review_service_acceptance_paper_intake((pg_temp.v('p2')->>'intakeId')::uuid,'confirmed',
  pg_temp.v('p2')->>'documentSha256',NULL,'rv-2'));
INSERT INTO sa_results VALUES('rv2-replay',public.review_service_acceptance_paper_intake((pg_temp.v('p2')->>'intakeId')::uuid,'confirmed',
  pg_temp.v('p2')->>'documentSha256',NULL,'rv-2'));
SELECT pg_temp.assert_true((pg_temp.v('rv2')->>'aggregateOutcome')='accepted_with_conditions'
  AND (pg_temp.v('rv2-replay')->>'replayed')::boolean AND pg_temp.v('rv2-replay')->>'responseId'=pg_temp.v('rv2')->>'responseId',
  'confirmed paper completes the required set; the optional signer never blocks');
SELECT pg_temp.assert_true((SELECT lifecycle='closed' AND closed_reason='accepted_with_conditions' AND closed_at IS NOT NULL
  FROM public.service_acceptance_requests WHERE id=pg_temp.req('r1'))
  AND (SELECT method='paper_intake' AND responder_profile_id IS NULL AND presented_signer_policy_revision=2
  FROM public.service_acceptance_responses WHERE id=(pg_temp.v('rv2')->>'responseId')::uuid),'non-pending outcome closes the request');
SELECT pg_temp.expect_error(format($q$DO $d$ BEGIN PERFORM set_config('app.service_acceptance_request_id',%L,true);
  UPDATE public.service_acceptance_requests SET aggregate_outcome='returned',closed_reason='returned' WHERE id=%L; END $d$$q$,
  pg_temp.req('r1'),pg_temp.req('r1')),'23514','service_acceptance_transition_invalid','a closed request never moves');
SELECT pg_temp.expect_error($q$UPDATE public.service_acceptance_responses SET return_reason=NULL$q$,
  '23514','service_acceptance_record_immutable','responses are append-only');
SELECT pg_temp.expect_error(format($q$SELECT public.withdraw_service_acceptance_request(%L,'late','w-late')$q$,pg_temp.req('r1')),
  '55000','request_not_open','a closed request cannot be withdrawn');

-- T6 withdrawal receipt.
SELECT pg_temp.actor(1);
INSERT INTO sa_results VALUES('r2',pg_temp.create('c-r2','f8868000-0000-4000-8000-000000000002'));
SELECT pg_temp.deliver(pg_temp.req('r2'));
SELECT pg_temp.actor(2);
SELECT pg_temp.expect_error(format($q$SELECT public.withdraw_service_acceptance_request(%L,NULL,'w-2')$q$,pg_temp.req('r2')),
  '23514','service_acceptance_withdraw_invalid','withdraw needs a reason');
SELECT pg_temp.expect_error(format($q$SELECT public.withdraw_service_acceptance_request(%L,'no key',NULL)$q$,pg_temp.req('r2')),
  '23514','client_request_id_invalid','withdraw has no default key');
INSERT INTO sa_results VALUES('w2',public.withdraw_service_acceptance_request(pg_temp.req('r2'),'Scope conversation reopened','w-2'));
INSERT INTO sa_results VALUES('w2-replay',public.withdraw_service_acceptance_request(pg_temp.req('r2'),'Scope conversation reopened','w-2'));
SELECT pg_temp.assert_true((pg_temp.v('w2')->>'lifecycle')='withdrawn' AND pg_temp.v('w2-replay')->>'withdrawnAt'=pg_temp.v('w2')->>'withdrawnAt'
  AND (pg_temp.v('w2-replay')->>'replayed')::boolean AND NOT (pg_temp.v('w2')->>'replayed')::boolean,'T6 withdrawal replays its receipt');
SELECT pg_temp.assert_true((SELECT withdrawn_by=pg_temp.uid(2) AND withdraw_reason='Scope conversation reopened'
  AND withdraw_client_request_id='w-2' AND length(withdraw_request_hash)=64 FROM public.service_acceptance_requests
  WHERE id=pg_temp.req('r2')),'withdrawal records its five columns');
SELECT pg_temp.expect_error(format($q$SELECT public.withdraw_service_acceptance_request(%L,'other reason','w-2')$q$,pg_temp.req('r2')),
  '23505','idempotency_key_reused','withdraw refuses a reused key with another reason');
SELECT pg_temp.expect_error(format($q$SELECT public.withdraw_service_acceptance_request(%L,'again','w-2b')$q$,pg_temp.req('r2')),
  '55000','request_not_open','a withdrawn request is terminal');
SELECT pg_temp.actor(5);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-withdrawn')$q$,pg_temp.req('r2')),
  '55000','request_not_open','a withdrawn request refuses responses');

-- Draft withdrawal discards the unsent V22 draft.
SELECT pg_temp.actor(1);
INSERT INTO sa_results VALUES('r3',pg_temp.create('c-r3'));
SELECT public.withdraw_service_acceptance_request(pg_temp.req('r3'),'Created by mistake','w-3');
SELECT pg_temp.assert_true((SELECT status='discarded' FROM public.outbound_drafts WHERE id=(pg_temp.v('r3')->>'outboundDraftId')::uuid),
  'withdrawing a draft discards its unsent outbound draft');

-- Return closes at once even with a required signer pending. r4 binds its own
-- manifest: 00903 (K11) refuses a later request on a returned request's
-- evidence, and r5-r7 below reuse manifest 1.
SET LOCAL session_replication_role=replica;
INSERT INTO public.evidence_manifests(id,project_id,package_id,purpose,members,manifest_hash,request_hash,idempotency_key,created_by) VALUES
('f8868000-0000-4000-8000-000000000004',pg_temp.project(),NULL,'service_acceptance','[]',repeat('d',64),repeat('4',64),'sa-4',pg_temp.uid(1));
SET LOCAL session_replication_role=origin;
SELECT pg_temp.actor(1);
INSERT INTO sa_results VALUES('r4',pg_temp.create('c-r4','f8868000-0000-4000-8000-000000000004'));
SELECT pg_temp.deliver(pg_temp.req('r4'));
SELECT pg_temp.actor(6);
INSERT INTO sa_results VALUES('r4-return',pg_temp.respond(pg_temp.req('r4'),'return','x-return',reason=>'The kitchen scope is missing'));
SELECT pg_temp.assert_true((pg_temp.v('r4-return')->>'aggregateOutcome')='returned'
  AND (SELECT lifecycle='closed' AND closed_reason='returned' FROM public.service_acceptance_requests WHERE id=pg_temp.req('r4')),
  'any required return closes the request returned');

-- Client projection (no studio-only fields) and studio projection.
SELECT pg_temp.actor(5);
INSERT INTO sa_results VALUES('mine5',public.get_my_service_acceptance_requests());
SELECT pg_temp.assert_true(jsonb_array_length(pg_temp.v('mine5'))=3
  AND NOT EXISTS (SELECT 1 FROM jsonb_array_elements(pg_temp.v('mine5')) e WHERE e->>'lifecycle'='draft'
    OR e ? 'paperIntakes' OR e ? 'outboundDraftId' OR e ? 'withdrawReason' OR (e->'signers')::text LIKE '%profileId%')
  AND (SELECT bool_and(e->>'viewerRole'='signer_required') FROM jsonb_array_elements(pg_temp.v('mine5')) e),
  'client sees sent and terminal requests as a required signer, without studio fields');
-- K5 provenance: the signer sees confirmed paper as paper, apart from their own click-through.
SELECT pg_temp.assert_true((SELECT jsonb_object_agg(s->>'slot',s->'response'->>'method')
    ='{"client":"portal_authenticated","partner":"paper_intake"}'::jsonb
  FROM jsonb_array_elements(pg_temp.v('mine5')) e, jsonb_array_elements(e->'signers') s
  WHERE e->>'requestId'=pg_temp.req('r1')::text AND s->'response'<>'null'::jsonb),
  'the client sees the confirmed paper response as paper intake, distinct from the authenticated click-through');
SELECT pg_temp.assert_true(NOT EXISTS (SELECT 1 FROM jsonb_array_elements(pg_temp.v('mine5')) e,
    jsonb_array_elements(e->'signers') s WHERE s->'response'<>'null'::jsonb
    AND (SELECT array_agg(k ORDER BY k) FROM jsonb_object_keys(s->'response') k)
      <>ARRAY['conditions','method','respondedAt','response','returnReason'])
  AND position(pg_temp.v('rv2')->>'responseId' in pg_temp.v('mine5')::text)=0
  AND position(pg_temp.v('p2')->>'documentSha256' in pg_temp.v('mine5')::text)=0
  AND position('f8869000-0000-4000-8000-000000000005' in pg_temp.v('mine5')::text)=0,
  'client responses withhold the response id, paper object, hash and reviewer');
SELECT pg_temp.actor(6);
INSERT INTO sa_results VALUES('mine6',public.get_my_service_acceptance_requests());
SELECT pg_temp.assert_true((SELECT COALESCE(jsonb_agg(e->>'requestId' ORDER BY e->>'requestId'),'[]'::jsonb)
    FROM jsonb_array_elements(pg_temp.v('mine6')) e)
  =(SELECT jsonb_agg(x ORDER BY x) FROM unnest(ARRAY[pg_temp.req('r2')::text,pg_temp.req('r4')::text]) x)
  AND NOT EXISTS (SELECT 1 FROM jsonb_array_elements(pg_temp.v('mine6')) e WHERE e->>'requestId'=pg_temp.req('r1')::text),
  'a replaced signer stops seeing that request; other requests still show');
SELECT pg_temp.actor(7);
SELECT pg_temp.assert_true(public.get_my_service_acceptance_requests()='[]'::jsonb,'an outsider sees no requests');
SELECT pg_temp.expect_error(format('SELECT public.get_project_service_acceptance(%L)',pg_temp.project()),'42501',NULL,
  'an outsider cannot read the studio projection');
SELECT pg_temp.actor(5);
SELECT pg_temp.expect_error(format('SELECT public.get_project_service_acceptance(%L)',pg_temp.project()),'42501',NULL,
  'the client cannot read the studio projection');
SELECT pg_temp.actor(2);
SELECT pg_temp.assert_true((SELECT jsonb_array_length(v->'requests')=4 AND v->>'capability'='active'
  AND (v->'requests'->0->>'requestNumber')::int=4 AND jsonb_array_length(v->'requests'->3->'paperIntakes')=3
  AND (SELECT array_agg(i->>'reviewState' ORDER BY i->>'reviewState') FROM jsonb_array_elements(v->'requests'->3->'paperIntakes') i)
    =ARRAY['confirmed','lapsed','rejected']
  FROM public.get_project_service_acceptance(pg_temp.project()) v),'studio projection lists every request with paper intakes');

-- X08: the old approval list never sees acceptance rows.
SELECT pg_temp.actor(1);
SELECT pg_temp.assert_true((SELECT position('service_acceptance' in v::text)=0 AND position('f886a000-0000-4000-8000-000000000001' in v::text)>0
  FROM public.get_project_decision_reviews(pg_temp.project()) v),'old approval list returns only artifact kinds');
SELECT pg_temp.assert_true(pg_temp.closure()=pg_temp.v('closure0'),'acceptance transitions leave project closure state unchanged');

-- Supersession: a successor request, then a material scope change.
GRANT EXECUTE ON FUNCTION pg_temp.project(),pg_temp.v(text) TO authenticated;
INSERT INTO sa_results VALUES('r5',pg_temp.create('c-r5'));
INSERT INTO sa_results VALUES('r6',pg_temp.create('c-r6'));
SELECT pg_temp.assert_true((SELECT lifecycle='superseded' AND superseded_reason='successor_request' FROM public.service_acceptance_requests
  WHERE id=pg_temp.req('r5')) AND (pg_temp.request(pg_temp.req('r6'))).predecessor_request_id=pg_temp.req('r5')
  AND (SELECT status='discarded' FROM public.outbound_drafts WHERE id=(pg_temp.v('r5')->>'outboundDraftId')::uuid),
  'a new request supersedes the open one and discards its draft');
SELECT pg_temp.deliver(pg_temp.req('r6'));
INSERT INTO sa_results VALUES('p6',pg_temp.record_paper(pg_temp.req('r6'),pg_temp.signer(pg_temp.req('r6'),'client'),
  pg_temp.paper(6,1),'accept','p-6'));
SET LOCAL ROLE authenticated;
INSERT INTO sa_results VALUES('amendment',public.create_service_addendum(pg_temp.project(),'Acceptance amendment'));
SELECT public.copy_agreement_parts_from_authority((pg_temp.v('amendment')->>'proposalId')::uuid,'copy frozen composition');
SELECT pg_temp.send_and_sign((pg_temp.v('amendment')->>'proposalId')::uuid);
SELECT public.countersign_design_services_agreement((pg_temp.v('amendment')->>'proposalId')::uuid,'Acceptance Designer');
RESET ROLE;
SELECT pg_temp.assert_true((SELECT lifecycle='superseded' AND superseded_reason='scope_edition_superseded'
  FROM public.service_acceptance_requests WHERE id=pg_temp.req('r6'))
  AND (SELECT review_state='lapsed' AND lapsed_reason='request_terminal' FROM public.service_acceptance_paper_intakes
  WHERE id=(pg_temp.v('p6')->>'intakeId')::uuid),'an executed amendment supersedes the open request and lapses its paper');
SELECT pg_temp.actor(5);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-superseded')$q$,pg_temp.req('r6')),
  '55000','request_not_open','a superseded request refuses responses');
SELECT pg_temp.actor(1);
SELECT pg_temp.expect_error(format($q$SELECT public.create_service_acceptance_request(%L,%L,'f8868000-0000-4000-8000-000000000001','c-old')$q$,
  pg_temp.project(),(pg_temp.request(pg_temp.req('r6'))).scope_edition_id),'55000','scope_edition_not_active',
  'create refuses a superseded edition');
INSERT INTO sa_results VALUES('closure1',pg_temp.closure());
INSERT INTO sa_results VALUES('r7',pg_temp.create('c-r7'));
SELECT pg_temp.deliver(pg_temp.req('r7'));
SELECT pg_temp.assert_true((pg_temp.request(pg_temp.req('r7'))).scope_edition_id<>(pg_temp.request(pg_temp.req('r6'))).scope_edition_id
  AND jsonb_array_length(pg_temp.v('r7')->'signers')=3,'a request on the amended edition takes its frozen policy');
SELECT pg_temp.assert_true(pg_temp.closure()=pg_temp.v('closure1'),'post-amendment acceptance leaves closure state unchanged');
SET LOCAL ROLE authenticated;
INSERT INTO sa_results VALUES('paused',public.create_service_addendum(pg_temp.project(),'Paused amendment'));
SELECT public.copy_agreement_parts_from_authority((pg_temp.v('paused')->>'proposalId')::uuid,'copy before pause');
SELECT pg_temp.send_and_sign((pg_temp.v('paused')->>'proposalId')::uuid);
RESET ROLE;
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
SET LOCAL ROLE authenticated;
SELECT public.countersign_design_services_agreement((pg_temp.v('paused')->>'proposalId')::uuid,'Acceptance Designer');
RESET ROLE;
SELECT pg_temp.assert_true((SELECT lifecycle='superseded' AND superseded_reason='scope_edition_stale'
  FROM public.service_acceptance_requests WHERE id=pg_temp.req('r7'))
  AND (SELECT status='stale' FROM public.project_scope_editions WHERE id=(pg_temp.request(pg_temp.req('r7'))).scope_edition_id),
  'a stale edition supersedes its open request');
SELECT pg_temp.actor(5);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-inactive')$q$,pg_temp.req('r7')),
  '55000','scope_editions_inactive','responses re-check the capability at entry');
SELECT pg_temp.assert_true((SELECT count(*)=7 FROM public.service_acceptance_requests WHERE project_id=pg_temp.project())
  AND (SELECT count(*)=0 FROM public.service_acceptance_requests WHERE lifecycle IN ('draft','sent')),
  'seven requests, none left open');
