-- C4 service acceptance (00886) real PostgreSQL oracle. The enclosing runner
-- owns BEGIN/ROLLBACK, so every test-only grant and capability change rolls back.
-- The "shared" sections are reused by service_acceptance_concurrency.test.mjs.
-- BEGIN shared assertion helpers
CREATE FUNCTION pg_temp.assert_true(ok boolean, name text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',name; END IF;
  RAISE NOTICE 'PASS: %',name;
END $$;
CREATE FUNCTION pg_temp.expect_error(command text, state text, message text, name text)
RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
  BEGIN EXECUTE command;
  EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
  END;
  PERFORM pg_temp.assert_true(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
    name||format(' [expected %s/%s, got %s/%s]',state,message,actual_state,actual_message));
END $$;
CREATE FUNCTION pg_temp.uid(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
  SELECT ('f8860000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
$$;
CREATE FUNCTION pg_temp.actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claim.sub',CASE WHEN n IS NULL THEN '' ELSE pg_temp.uid(n)::text END,true);
  PERFORM set_config('request.jwt.claims',CASE WHEN n IS NULL THEN '' ELSE jsonb_build_object('sub',pg_temp.uid(n),
    'role','authenticated')::text END,true);
END $$;
GRANT EXECUTE ON FUNCTION pg_temp.assert_true(boolean,text),pg_temp.expect_error(text,text,text,text),
  pg_temp.actor(integer),pg_temp.uid(integer) TO authenticated,service_role;
-- END shared assertion helpers

-- Shipped inactive: no mutation or helper is executable by PUBLIC, anon,
-- authenticated or service_role; only the reads and 00889's client evidence
-- storage predicate reach authenticated.
DO $$ DECLARE f record; r text; BEGIN
  FOR f IN SELECT p.oid::regprocedure signature, p.proname FROM pg_proc p
    WHERE p.pronamespace='public'::regnamespace AND (p.proname LIKE '%service_acceptance%')
      AND p.proname NOT IN ('_can_access_service_acceptance_paper_object') LOOP
    IF f.proname IN ('get_project_service_acceptance','get_my_service_acceptance_requests',
      'get_my_service_acceptance_evidence','_can_read_service_acceptance_evidence_object') THEN
      PERFORM pg_temp.assert_true(has_function_privilege('authenticated',f.signature,'EXECUTE')
        AND NOT has_function_privilege('anon',f.signature,'EXECUTE'),'read granted to authenticated only '||f.signature);
      CONTINUE;
    END IF;
    FOREACH r IN ARRAY ARRAY['anon','authenticated','service_role'] LOOP
      PERFORM pg_temp.assert_true(NOT has_function_privilege(r,f.signature,'EXECUTE'),r||' no execute '||f.signature);
    END LOOP;
    PERFORM pg_temp.assert_true(NOT EXISTS (SELECT 1 FROM pg_proc p,
      aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) acl
      WHERE p.oid=f.signature::oid AND acl.grantee=0 AND acl.privilege_type='EXECUTE'),'PUBLIC no execute '||f.signature);
  END LOOP;
END $$;
SELECT pg_temp.assert_true((SELECT count(*)=7 FROM pg_proc WHERE pronamespace='public'::regnamespace AND proname IN
  ('create_service_acceptance_request','respond_service_acceptance','record_service_acceptance_paper_intake',
   'stamp_service_acceptance_paper_hash','review_service_acceptance_paper_intake','replace_service_acceptance_signer',
   'withdraw_service_acceptance_request')),'seven mutation RPCs exist');
SELECT pg_temp.assert_true(to_regproc('public._service_acceptance_paper_fingerprint') IS NULL,
  'no metadata fingerprint stands in for the paper content hash');
SELECT pg_temp.assert_true((SELECT bool_and(c.relrowsecurity) AND bool_and(NOT has_table_privilege('authenticated',c.oid,'SELECT,INSERT,UPDATE,DELETE'))
  AND bool_and(NOT has_table_privilege('anon',c.oid,'SELECT,INSERT,UPDATE,DELETE')) AND count(*)=4
  FROM pg_class c WHERE c.relnamespace='public'::regnamespace AND c.relname IN ('service_acceptance_requests',
  'service_acceptance_signers','service_acceptance_responses','service_acceptance_paper_intakes')),
  'four acceptance tables have RLS and no anon/authenticated table privilege');
SELECT pg_temp.assert_true((SELECT NOT public FROM storage.buckets WHERE id='service-acceptance-paper'),'paper bucket is private');
SELECT pg_temp.assert_true((SELECT NOT enabled FROM public.server_capabilities WHERE key='scope_editions'),'capability ships false');
SELECT pg_temp.assert_true(NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname='close_project' AND prosrc LIKE '%service_acceptance%'),
  'close_project does not read acceptance');

-- Inactive: every mutation refuses even with its grant restored here.
DO $$ DECLARE f regprocedure; BEGIN
  FOR f IN SELECT p.oid::regprocedure FROM pg_proc p WHERE p.pronamespace='public'::regnamespace AND p.proname IN
    ('create_service_acceptance_request','respond_service_acceptance','record_service_acceptance_paper_intake',
     'review_service_acceptance_paper_intake','replace_service_acceptance_signer','withdraw_service_acceptance_request') LOOP
    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO authenticated',f);
  END LOOP;
END $$;
SELECT pg_temp.actor(1);
SET LOCAL ROLE authenticated;
SELECT pg_temp.expect_error('SELECT public.create_service_acceptance_request(gen_random_uuid(),gen_random_uuid(),gen_random_uuid(),''k'')',
  '55000','scope_editions_inactive','inactive create refuses with grant restored');
SELECT pg_temp.expect_error('SELECT public.respond_service_acceptance(gen_random_uuid(),''accept'',''[]'',NULL,''h'',''h'',1,''k'')',
  '55000','scope_editions_inactive','inactive respond refuses with grant restored');
SELECT pg_temp.expect_error('SELECT public.record_service_acceptance_paper_intake(gen_random_uuid(),gen_random_uuid(),gen_random_uuid(),current_date,''n'',''accept'',''[]'',NULL,1,''h'',''h'',1,''k'')',
  '55000','scope_editions_inactive','inactive paper intake refuses with grant restored');
SELECT pg_temp.expect_error('SELECT public.review_service_acceptance_paper_intake(gen_random_uuid(),''confirmed'',''h'',NULL,''k'')',
  '55000','scope_editions_inactive','inactive paper review refuses with grant restored');
SELECT pg_temp.expect_error('SELECT public.replace_service_acceptance_signer(gen_random_uuid(),gen_random_uuid(),gen_random_uuid(),NULL,1,''r'',''k'')',
  '55000','scope_editions_inactive','inactive replace refuses with grant restored');
SELECT pg_temp.expect_error('SELECT public.withdraw_service_acceptance_request(gen_random_uuid(),''r'',''k'')',
  '55000','scope_editions_inactive','inactive withdraw refuses with grant restored');
RESET ROLE;
DO $$ DECLARE f regprocedure; BEGIN
  FOR f IN SELECT p.oid::regprocedure FROM pg_proc p WHERE p.pronamespace='public'::regnamespace AND p.proname IN
    ('create_service_acceptance_request','respond_service_acceptance','record_service_acceptance_paper_intake',
     'review_service_acceptance_paper_intake','replace_service_acceptance_signer','withdraw_service_acceptance_request') LOOP
    EXECUTE format('REVOKE EXECUTE ON FUNCTION %s FROM authenticated',f);
  END LOOP;
END $$;
-- The content stamp is service_role only; it is inactive with that grant restored here.
GRANT EXECUTE ON FUNCTION public.stamp_service_acceptance_paper_hash(uuid,text,text,text) TO service_role;
SELECT pg_temp.actor(NULL);
SET LOCAL ROLE service_role;
SELECT pg_temp.expect_error('SELECT public.stamp_service_acceptance_paper_hash(gen_random_uuid(),repeat(''a'',64),''v'',''e'')',
  '55000','scope_editions_inactive','inactive paper stamp refuses with its service_role grant restored');
RESET ROLE;
REVOKE EXECUTE ON FUNCTION public.stamp_service_acceptance_paper_hash(uuid,text,text,text) FROM service_role;

