-- Create: authority, inputs, receipt replay (R15).
SELECT pg_temp.actor(7);
SELECT pg_temp.expect_error($q$SELECT pg_temp.create('c-outsider')$q$,'42501',NULL,'outsider cannot create');
SELECT pg_temp.actor(4);
