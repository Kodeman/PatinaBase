SELECT pg_temp.actor(2);
SELECT pg_temp.expect_error($q$SELECT pg_temp.create(NULL)$q$,'23514','client_request_id_invalid','create requires a client request id');
SELECT pg_temp.expect_error($q$SELECT pg_temp.create('c-fab','f8868000-0000-4000-8000-000000000003')$q$,
  '23514','evidence_manifest_invalid','create refuses a manifest of another purpose');
SELECT pg_temp.expect_error($q$SELECT public.create_service_acceptance_request(pg_temp.project(),gen_random_uuid(),
  'f8868000-0000-4000-8000-000000000001','c-noedition')$q$,'55000','scope_edition_not_active','create refuses an unknown edition');
