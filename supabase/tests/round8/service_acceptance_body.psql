INSERT INTO sa_results VALUES('r1',pg_temp.create('c-r1'));
INSERT INTO sa_results VALUES('r1-replay',pg_temp.create('c-r1'));
SELECT pg_temp.assert_true((pg_temp.v('r1')->>'lifecycle')='draft' AND jsonb_array_length(pg_temp.v('r1')->'signers')=3
  AND (pg_temp.v('r1')->>'signerPolicyRevision')::int=1 AND NOT (pg_temp.v('r1')->>'replayed')::boolean,'create returns a draft with three signers');
SELECT pg_temp.assert_true(pg_temp.req('r1-replay')=pg_temp.req('r1') AND (pg_temp.v('r1-replay')->>'replayed')::boolean,
  'create replays its receipt');
SELECT pg_temp.expect_error($q$SELECT pg_temp.create('c-r1','f8868000-0000-4000-8000-000000000002')$q$,
  '23505','idempotency_key_reused','create refuses a reused key with another payload');
SELECT pg_temp.assert_true((SELECT d.kind='service_acceptance_request' AND d.status='awaiting_review' AND d.ref_id=pg_temp.req('r1')
  AND d.to_client_id=pg_temp.uid(5) AND position('signature' in lower(d.subject||d.body))=0
  FROM public.outbound_drafts d WHERE d.id=(pg_temp.v('r1')->>'outboundDraftId')::uuid),'create composes one V22 draft awaiting review');
SELECT pg_temp.assert_true((SELECT bool_and(source='edition_policy' AND policy_slot=slot) AND count(*) FILTER (WHERE required)=2
  FROM public.service_acceptance_signers WHERE request_id=pg_temp.req('r1')),'signers come from the edition policy only');
SELECT pg_temp.assert_true((SELECT scope_content_hash=(SELECT content_hash FROM public.project_scope_editions WHERE id=scope_edition_id)
  AND evidence_manifest_hash=repeat('a',64) FROM public.service_acceptance_requests WHERE id=pg_temp.req('r1')),
  'request pins edition and manifest hashes');

-- Guards: direct writes fail without the RPC markers.
SELECT pg_temp.expect_error(format('UPDATE public.service_acceptance_requests SET lifecycle=''sent'',sent_at=now() WHERE id=%L',
  pg_temp.req('r1')),'42501','service_acceptance_write_unauthorized','direct request update refuses');
SELECT pg_temp.expect_error(format($q$DO $d$ BEGIN PERFORM set_config('app.service_acceptance_request_id',%L,true);
  UPDATE public.service_acceptance_requests SET aggregate_outcome='accepted',lifecycle='closed',closed_reason='accepted',
  closed_at=now(),sent_at=now() WHERE id=%L; END $d$$q$,pg_temp.req('r1'),pg_temp.req('r1')),
  '23514','service_acceptance_transition_invalid','draft cannot jump to closed');
SELECT pg_temp.expect_error(format('DELETE FROM public.service_acceptance_signers WHERE request_id=%L',pg_temp.req('r1')),
  '23514','service_acceptance_record_immutable','signers cannot be deleted');

-- Delivery: a rejected send leaves draft; the after-send hook marks sent once.
SELECT pg_temp.actor(5);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','early')$q$,pg_temp.req('r1')),
  '55000','request_not_open','a draft request refuses responses');
SELECT pg_temp.deliver(pg_temp.req('r1'),true);
SELECT pg_temp.assert_true((pg_temp.request(pg_temp.req('r1'))).lifecycle='draft','rejected delivery leaves the request in draft');
SELECT pg_temp.deliver(pg_temp.req('r1'));
SELECT pg_temp.assert_true((SELECT lifecycle='sent' AND sent_at IS NOT NULL FROM public.service_acceptance_requests WHERE id=pg_temp.req('r1')),
  'after-send hook marks the request sent');
INSERT INTO sa_results VALUES('r1-sent-at',to_jsonb((pg_temp.request(pg_temp.req('r1'))).sent_at));
-- Replay the after-send transition itself: the hook fires again but is a no-op.
SET LOCAL session_replication_role=replica;
UPDATE public.outbound_drafts SET after_send_done_at=NULL WHERE id=(pg_temp.v('r1')->>'outboundDraftId')::uuid;
SET LOCAL session_replication_role=origin;
UPDATE public.outbound_drafts SET after_send_done_at=clock_timestamp() WHERE id=(pg_temp.v('r1')->>'outboundDraftId')::uuid;
SELECT pg_temp.assert_true(to_jsonb((pg_temp.request(pg_temp.req('r1'))).sent_at)=pg_temp.v('r1-sent-at'),'after-send runs once');

-- Respond: authority, binding, payload, replay.
SELECT pg_temp.actor(7);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x7')$q$,pg_temp.req('r1')),'42501',NULL,'non-signer cannot respond');
SELECT pg_temp.actor(5);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-hash',hash=>repeat('0',64))$q$,pg_temp.req('r1')),
  'PT409','stale_scope','respond refuses a stale scope hash');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-rev',revision=>2)$q$,pg_temp.req('r1')),
  'PT409','stale_signer_policy','respond refuses a stale signer revision');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept_with_conditions','x-empty')$q$,pg_temp.req('r1')),
  '23514','service_acceptance_response_invalid','conditional response needs conditions');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'return','x-reason')$q$,pg_temp.req('r1')),
  '23514','service_acceptance_response_invalid','return needs a reason');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-paper',method=>'paper_intake')$q$,pg_temp.req('r1')),
  '23514','service_acceptance_response_invalid','paper is never an online method');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept_with_conditions','x-id','[{"conditionId":"c","text":"t"}]')$q$,
  pg_temp.req('r1')),'23514','service_acceptance_response_invalid','client cannot assign condition ids');
-- The activation path: the same RPC through the authenticated role (grant restored here only).
GRANT EXECUTE ON FUNCTION public.respond_service_acceptance(uuid,text,jsonb,text,text,text,integer,text,text) TO authenticated;
SELECT id AS r1_id,scope_content_hash AS r1_scope,evidence_manifest_hash AS r1_manifest
FROM public.service_acceptance_requests WHERE id=pg_temp.req('r1') \gset
SET LOCAL ROLE authenticated;
INSERT INTO sa_results VALUES('r1-client',public.respond_service_acceptance(:'r1_id','accept_with_conditions',
  '[{"text":"Keep the oak floor"}]',NULL,:'r1_scope',:'r1_manifest',1,'x-client'));
INSERT INTO sa_results VALUES('r1-client-replay',public.respond_service_acceptance(:'r1_id','accept_with_conditions',
  '[{"text":"Keep the oak floor"}]',NULL,:'r1_scope',:'r1_manifest',1,'x-client'));
RESET ROLE;
REVOKE EXECUTE ON FUNCTION public.respond_service_acceptance(uuid,text,jsonb,text,text,text,integer,text,text) FROM authenticated;
SELECT pg_temp.assert_true((pg_temp.v('r1-client')->>'aggregateOutcome')='pending'
  AND (pg_temp.v('r1-client')->'pendingRequiredSigners'->0->>'slot')='partner'
  AND jsonb_array_length(pg_temp.v('r1-client')->'pendingRequiredSigners')=1,'one of two required signers leaves the outcome pending');
SELECT pg_temp.assert_true(pg_temp.v('r1-client-replay')->>'responseId'=pg_temp.v('r1-client')->>'responseId'
  AND (pg_temp.v('r1-client-replay')->>'replayed')::boolean,'respond replays its receipt');
SELECT pg_temp.assert_true((SELECT conditions->0->>'text'='Keep the oak floor' AND (conditions->0->>'conditionId') IS NOT NULL
  AND method='portal_authenticated' AND responder_profile_id=pg_temp.uid(5)
  FROM public.service_acceptance_responses WHERE id=(pg_temp.v('r1-client')->>'responseId')::uuid),'server assigns condition ids');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-client')$q$,pg_temp.req('r1')),
  '23505','idempotency_key_reused','respond refuses a reused key with another payload');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.respond(%L,'accept','x-again')$q$,pg_temp.req('r1')),
  '23505','already_responded','a signer responds once');
SELECT pg_temp.expect_error(format($q$SELECT public.withdraw_service_acceptance_request(%L,'client withdraw','w-client')$q$,
  pg_temp.req('r1')),'42501',NULL,'client cannot withdraw');

-- T5 paper across a revision: an intake at revision 1 lapses on replacement.
SELECT pg_temp.actor(1);
INSERT INTO sa_results VALUES('p1',pg_temp.record_paper(pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner'),
  pg_temp.paper(1,1),'accept','p-1'));
SELECT pg_temp.assert_true((pg_temp.v('p1')->>'reviewState')='pending_review' AND pg_temp.v('p1')->'documentSha256'='null'::jsonb
  AND (SELECT storage_object_id='f8869000-0000-4000-8000-000000000001' AND storage_object_version='v-1'
    AND storage_object_etag='"etag-1"' AND document_sha256 IS NULL AND document_stamped_at IS NULL
    FROM public.service_acceptance_paper_intakes WHERE id=(pg_temp.v('p1')->>'intakeId')::uuid),
  'paper intake records the object identity and leaves the content hash unstamped');
SELECT pg_temp.paper(8,1),pg_temp.paper(9,1);
UPDATE storage.objects SET version=NULL WHERE id='f8869000-0000-4000-8000-000000000008';
UPDATE storage.objects SET metadata=metadata-'eTag' WHERE id='f8869000-0000-4000-8000-000000000009';
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.record_paper(%L,%L,'f8869000-0000-4000-8000-000000000008','accept','p-noversion')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner')),'23514','service_acceptance_paper_invalid',
  'paper without a storage version refuses');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.record_paper(%L,%L,'f8869000-0000-4000-8000-000000000009','accept','p-noetag')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner')),'23514','service_acceptance_paper_invalid',
  'paper without an eTag refuses');
SELECT pg_temp.actor(2);
SELECT pg_temp.expect_error(format($q$SELECT public.replace_service_acceptance_signer(%L,%L,NULL,'f8866000-0000-4000-8000-000000000004',1,'moved','rp-member')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner')),'42501',NULL,'a member cannot replace a signer');
SELECT pg_temp.actor(3);
SELECT pg_temp.expect_error(format($q$SELECT public.replace_service_acceptance_signer(%L,%L,%L,NULL,1,'outsider','rp-out')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner'),pg_temp.uid(7)),'23514','signer_policy_unbound',
  'replacement refuses a person outside the household');
SELECT pg_temp.expect_error(format($q$SELECT public.replace_service_acceptance_signer(%L,%L,%L,NULL,1,'dup','rp-dup')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner'),pg_temp.uid(5)),'23514','signer_policy_duplicate',
  'replacement refuses a person already signing');
SELECT pg_temp.expect_error(format($q$SELECT public.replace_service_acceptance_signer(%L,%L,NULL,'f8866000-0000-4000-8000-000000000003',1,'dup card','rp-dup2')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner')),'23514','signer_policy_duplicate',
  'replacement refuses the optional card already signing');
SELECT pg_temp.expect_error(format($q$SELECT public.replace_service_acceptance_signer(%L,%L,NULL,'f8866000-0000-4000-8000-000000000004',2,'stale','rp-stale')$q$,
  pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner')),'PT409','stale_signer_policy','replacement checks the revision');
INSERT INTO sa_results VALUES('rp1',public.replace_service_acceptance_signer(pg_temp.req('r1'),pg_temp.signer(pg_temp.req('r1'),'partner'),
  NULL,'f8866000-0000-4000-8000-000000000004',1,'Partner travelling; second card signs on paper','rp-1'));
INSERT INTO sa_results VALUES('rp1-replay',public.replace_service_acceptance_signer(
  (SELECT request_id FROM public.service_acceptance_signers WHERE replacement_client_request_id='rp-1'),
  (SELECT id FROM public.service_acceptance_signers WHERE replacement_client_request_id='rp-1'),
  NULL,'f8866000-0000-4000-8000-000000000004',1,'Partner travelling; second card signs on paper','rp-1'));
SELECT pg_temp.assert_true((pg_temp.v('rp1')->>'signerPolicyRevision')::int=2
  AND pg_temp.v('rp1')->'lapsedIntakeIds'=jsonb_build_array(pg_temp.v('p1')->>'intakeId')
  AND pg_temp.v('rp1-replay')->>'signerId'=pg_temp.v('rp1')->>'signerId' AND (pg_temp.v('rp1-replay')->>'replayed')::boolean,
  'replacement bumps the revision, lapses the intake and replays');
SELECT pg_temp.assert_true((SELECT review_state='lapsed' AND lapsed_reason='signer_policy_revised'
  FROM public.service_acceptance_paper_intakes WHERE id=(pg_temp.v('p1')->>'intakeId')::uuid),'T5 intake lapses on signer revision');
SELECT pg_temp.assert_true((SELECT s.required AND s.profile_id IS NULL AND old.status='replaced' AND old.replaced_by=pg_temp.uid(3)
  AND old.replacement_reason LIKE 'Partner travelling%' AND old.replaced_by_signer_id=s.id
  FROM public.service_acceptance_signers s JOIN public.service_acceptance_signers old ON old.replaced_by_signer_id=s.id
  WHERE s.id=(pg_temp.v('rp1')->>'signerId')::uuid),'a profile-less required signer is accepted and the replacement audited');
-- The validator runs directly on the active edition's proposal: no projection can skip it.
SELECT pg_temp.expect_error($q$SELECT public._validate_service_acceptance_signers((SELECT e.source_proposal_id
  FROM public.project_scope_editions e WHERE e.project_id=pg_temp.project() AND e.status='active'),
  '[{"slot":"only","required":true,"householdPersonId":"f8866000-0000-4000-8000-00000000ffff"}]')$q$,
  '23514','signer_policy_unbound','create-time validation refuses a card outside the household');
DO $$ DECLARE proposal uuid; failure text; BEGIN
  SELECT e.source_proposal_id INTO STRICT proposal FROM public.project_scope_editions e
  WHERE e.project_id=pg_temp.project() AND e.status='active';
  BEGIN
    PERFORM public._validate_service_acceptance_signers(proposal,
      '[{"slot":"only","required":true,"householdPersonId":"f8866000-0000-4000-8000-000000000003"}]');
  EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS failure=MESSAGE_TEXT;
  END;
  PERFORM pg_temp.assert_true(failure IS NULL,
    'create-time validation accepts a profile-less required signer (reachable on paper)'||COALESCE(' [got '||failure||']',''));
END $$;
SELECT pg_temp.actor(3);
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirmed',%L,NULL,'rv-lapsed')$q$,
  pg_temp.v('p1')->>'intakeId',pg_temp.v('p1')->>'documentSha256'),'55000','request_not_open','a lapsed intake cannot be confirmed');
SELECT pg_temp.expect_error($q$SELECT pg_temp.stamp('p1')$q$,'55000','request_not_open','a lapsed intake is never stamped');
SELECT pg_temp.actor(1);
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.record_paper(%L,%L,pg_temp.paper(2,1),'accept','p-stale',1)$q$,
  pg_temp.req('r1'),pg_temp.v('rp1')->>'signerId'),'PT409','stale_signer_policy','paper presented at the old revision refuses');
SELECT pg_temp.expect_error(format($q$SELECT public.record_service_acceptance_paper_intake(r.id,%L,pg_temp.paper(20,1),current_date,
  'Signed Name','accept','[]'::jsonb,NULL,r.request_number,repeat('0',64),r.evidence_manifest_hash,r.signer_policy_revision,'p-stale-scope')
  FROM public.service_acceptance_requests r WHERE r.id=%L$q$,pg_temp.v('rp1')->>'signerId',pg_temp.req('r1')),
  'PT409','stale_scope','paper presented against another scope refuses');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.record_paper(%L,%L,pg_temp.paper(3,1),'accept','p-old')$q$,
  pg_temp.req('r1'),(SELECT id FROM public.service_acceptance_signers WHERE replaced_by_signer_id=(pg_temp.v('rp1')->>'signerId')::uuid)),
  '55000','signer_not_active','paper for a replaced signer refuses');
SELECT pg_temp.expect_error(format($q$SELECT pg_temp.record_paper(%L,%L,pg_temp.paper(4,2),'accept','p-owner')$q$,
  pg_temp.req('r1'),pg_temp.v('rp1')->>'signerId'),'23514','service_acceptance_paper_invalid','paper must be the recorder''s upload');
INSERT INTO sa_results VALUES('p2',pg_temp.record_paper(pg_temp.req('r1'),(pg_temp.v('rp1')->>'signerId')::uuid,
  pg_temp.paper(5,1),'accept','p-2'));
SELECT pg_temp.expect_error($q$UPDATE storage.objects SET name=name WHERE id='f8869000-0000-4000-8000-000000000005'$q$,
  '23514','Recorded acceptance paper','recorded paper object is immutable');
INSERT INTO sa_results VALUES('p3',pg_temp.record_paper(pg_temp.req('r1'),(pg_temp.v('rp1')->>'signerId')::uuid,
  pg_temp.paper(7,1),'accept','p-3'));
SELECT pg_temp.actor(2);
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirmed',%L,NULL,'rv-member')$q$,
  pg_temp.v('p2')->>'intakeId',pg_temp.v('p2')->>'documentSha256'),'42501',NULL,'a member cannot review paper');
SELECT pg_temp.actor(1);
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirmed',%L,NULL,'rv-self')$q$,
  pg_temp.v('p2')->>'intakeId',pg_temp.v('p2')->>'documentSha256'),'42501',NULL,'the recorder cannot review their own intake');
-- C4 §2.2 decision vocabulary: 'confirmed'/'rejected'; the old 'confirm' refuses.
SELECT pg_temp.actor(3);
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirm',NULL,NULL,'rv-old')$q$,
  pg_temp.v('p2')->>'intakeId'),'23514','service_acceptance_review_invalid','review refuses the old confirm vocabulary');
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirmed',NULL,NULL,'rv-unstamped')$q$,
  pg_temp.v('p2')->>'intakeId'),'55000','paper_document_unstamped','confirmation refuses paper whose bytes are not yet hashed');
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'rejected',NULL,NULL,'rv-3-note')$q$,
  pg_temp.v('p3')->>'intakeId'),'23514','service_acceptance_review_invalid','a rejection needs a note');
INSERT INTO sa_results VALUES('rv3',public.review_service_acceptance_paper_intake((pg_temp.v('p3')->>'intakeId')::uuid,'rejected',
  NULL,'Signature page missing','rv-3'));
SELECT pg_temp.assert_true((pg_temp.v('rv3')->>'reviewState')='rejected' AND pg_temp.v('rv3')->'responseId'='null'::jsonb
  AND (SELECT review_state='rejected' AND reviewed_by=pg_temp.uid(3) AND document_sha256 IS NULL
    FROM public.service_acceptance_paper_intakes WHERE id=(pg_temp.v('p3')->>'intakeId')::uuid)
  AND NOT EXISTS (SELECT 1 FROM public.service_acceptance_responses WHERE paper_intake_id=(pg_temp.v('p3')->>'intakeId')::uuid),
  'an unstamped intake can be rejected and never creates a response');

-- The service-role content stamp (WP-10C hashes the stored bytes, then calls it).
SELECT pg_temp.expect_error(format($q$SELECT public.stamp_service_acceptance_paper_hash(%L,repeat('b',64),'v-5','"etag-5"')$q$,
  pg_temp.v('p2')->>'intakeId'),'42501','insufficient_privilege','a signed-in caller never stamps');
SELECT pg_temp.actor(NULL);
SELECT pg_temp.expect_error(format($q$SELECT public.stamp_service_acceptance_paper_hash(%L,repeat('B',64),'v-5','"etag-5"')$q$,
  pg_temp.v('p2')->>'intakeId'),'23514','paper_document_hash_invalid','stamp refuses a hash that is not 64 lowercase hex');
SELECT pg_temp.expect_error(format($q$SELECT public.stamp_service_acceptance_paper_hash(%L,repeat('b',63),'v-5','"etag-5"')$q$,
  pg_temp.v('p2')->>'intakeId'),'23514','paper_document_hash_invalid','stamp refuses a short hash');
SELECT pg_temp.expect_error(format($q$SELECT public.stamp_service_acceptance_paper_hash(%L,repeat('b',64),'v-other','"etag-5"')$q$,
  pg_temp.v('p2')->>'intakeId'),'PT409','paper_document_changed','stamp refuses bytes hashed from another object version');
SET LOCAL session_replication_role=replica;
UPDATE storage.objects SET metadata=jsonb_set(metadata,'{eTag}','"moved"') WHERE id='f8869000-0000-4000-8000-000000000005';
SET LOCAL session_replication_role=origin;
SELECT pg_temp.expect_error($q$SELECT pg_temp.stamp('p2')$q$,'PT409','paper_document_changed',
  'stamp refuses an object whose eTag moved after the intake recorded it');
SET LOCAL session_replication_role=replica;
UPDATE storage.objects SET metadata=jsonb_set(metadata,'{eTag}',to_jsonb('"etag-5"'::text)) WHERE id='f8869000-0000-4000-8000-000000000005';
SET LOCAL session_replication_role=origin;
INSERT INTO sa_results VALUES('s2',pg_temp.stamp('p2'));
INSERT INTO sa_results VALUES('s2-replay',pg_temp.stamp('p2'));
SELECT pg_temp.assert_true(pg_temp.v('s2')->>'documentSha256'=encode(extensions.digest('p2','sha256'),'hex')
  AND NOT (pg_temp.v('s2')->>'replayed')::boolean AND (pg_temp.v('s2-replay')->>'replayed')::boolean
  AND pg_temp.v('s2-replay')->>'documentSha256'=pg_temp.v('s2')->>'documentSha256'
  AND (SELECT document_sha256=pg_temp.v('s2')->>'documentSha256' AND document_stamped_at IS NOT NULL AND review_state='pending_review'
    FROM public.service_acceptance_paper_intakes WHERE id=(pg_temp.v('p2')->>'intakeId')::uuid),
  'stamp binds the byte hash once and replays the same value');
SELECT pg_temp.expect_error($q$SELECT pg_temp.stamp('p2','other bytes')$q$,'23505','paper_document_hash_conflict',
  'a stamped intake refuses a different hash');
SELECT pg_temp.expect_error(format($q$DO $d$ BEGIN PERFORM set_config('app.service_acceptance_request_id',%L,true);
  UPDATE public.service_acceptance_paper_intakes SET document_sha256=repeat('e',64) WHERE id=%L; END $d$$q$,
  pg_temp.req('r1'),pg_temp.v('p2')->>'intakeId'),'23514','service_acceptance_transition_invalid','a bound hash never moves');
SELECT pg_temp.actor(3);
SET LOCAL session_replication_role=replica;
UPDATE storage.objects SET metadata=jsonb_set(metadata,'{eTag}','"changed"') WHERE id='f8869000-0000-4000-8000-000000000005';
SET LOCAL session_replication_role=origin;
SELECT pg_temp.expect_error(format($q$SELECT public.review_service_acceptance_paper_intake(%L,'confirmed',%L,NULL,'rv-changed')$q$,
  pg_temp.v('p2')->>'intakeId',pg_temp.v('p2')->>'documentSha256'),'PT409','paper_document_changed',
