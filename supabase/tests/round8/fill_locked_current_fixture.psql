 (pg_temp.fill_id(10),'Fill house',pg_temp.fill_id(1),pg_temp.fill_id(1),pg_temp.fill_id(100),pg_temp.fill_id(8),'active'),
 (pg_temp.fill_id(11),'Other house',pg_temp.fill_id(6),pg_temp.fill_id(6),pg_temp.fill_id(101),NULL,'active');
INSERT INTO public.project_rooms(id,project_id,name,sort_order) VALUES
