  1,1,'{}','{"selections":[]}',repeat('a',64),true,true),
 (pg_temp.fill_id(41),pg_temp.fill_id(31),pg_temp.fill_id(6),pg_temp.fill_id(101),pg_temp.fill_id(11),
  1,1,'{}','{"selections":[]}',repeat('b',64),true,true);

CREATE FUNCTION pg_temp.fill_actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
 PERFORM set_config('request.jwt.claim.sub',pg_temp.fill_id(n)::text,true);
 PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',pg_temp.fill_id(n),'role','authenticated')::text,true);
END; $$;
CREATE FUNCTION pg_temp.fill_request(line uuid, key text, kind text DEFAULT 'allowance')
RETURNS jsonb LANGUAGE sql AS $$
 SELECT jsonb_build_object('projectId',pg_temp.fill_id(10),'productId',pg_temp.fill_id(30),
 'placeholderSelectionId',line,'itemType',kind,'quantity',4,
 'assignmentScope','room','roomId',pg_temp.fill_id(20),'disposition','selected',
 'budgetMinCents',20000,'budgetMaxCents',60000,'duplicateMode','reuse','idempotencyKey',key);
$$;
CREATE FUNCTION pg_temp.fill_new(key text, kind text DEFAULT 'allowance') RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE result jsonb;
BEGIN
 result := public.place_product_in_project_v2(jsonb_build_object('projectId',pg_temp.fill_id(10),
 'name','Requirement '||key,'itemType',kind,'quantity',4,'unit','yard','roughCents',150000,
 'needLabel','Retain this need','assignmentScope','room','roomId',pg_temp.fill_id(20),
 'disposition','selected','budgetMinCents',20000,'budgetMaxCents',60000,'idempotencyKey',key));
 RETURN (result->>'selectionId')::uuid;
END; $$;
-- Compare all side-effect-bearing native records on refused commands.
CREATE FUNCTION pg_temp.fill_state() RETURNS jsonb LANGUAGE sql SECURITY DEFINER SET search_path TO public,pg_temp AS $$
 SELECT jsonb_build_object(
 'items',(SELECT jsonb_agg(to_jsonb(i) ORDER BY id) FROM public.project_ffe_items i WHERE project_id IN (pg_temp.fill_id(10),pg_temp.fill_id(11))),
 'specs',(SELECT jsonb_agg(to_jsonb(s) ORDER BY s.ffe_item_id) FROM public.project_ffe_specs s JOIN public.project_ffe_items i ON i.id=s.ffe_item_id WHERE i.project_id=pg_temp.fill_id(10)),
 'threads',(SELECT jsonb_agg(to_jsonb(t) ORDER BY id) FROM public.project_ffe_selection_threads t WHERE project_id=pg_temp.fill_id(10)),
 'receipts',(SELECT jsonb_agg(to_jsonb(r) ORDER BY actor_id,idempotency_key) FROM public.project_ffe_command_idempotency r WHERE actor_id::text LIKE 'f2084000-%'),
 'fills',(SELECT jsonb_agg(to_jsonb(f) ORDER BY f.id) FROM public.project_ffe_allowance_fills f JOIN public.project_ffe_items i ON i.id=f.ffe_item_id WHERE i.project_id=pg_temp.fill_id(10)),
 'placements',(SELECT jsonb_agg(to_jsonb(b) ORDER BY b.id) FROM public.proposal_board_items b JOIN public.project_ffe_items i ON i.id=b.project_ffe_item_id WHERE i.project_id=pg_temp.fill_id(10)));
$$;
CREATE FUNCTION pg_temp.fill_refused(request jsonb, state text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE before_state jsonb := pg_temp.fill_state(); got text;
BEGIN
 BEGIN
  PERFORM public.place_product_in_project_v2(request);
 EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS got=RETURNED_SQLSTATE;
 END;
 ASSERT got=state, format('fill_refusal expected %s, got %s: %s',state,got,request);
 ASSERT pg_temp.fill_state()=before_state,'fill_refusal_is_atomic';
END; $$;
-- Owner-only fixture shaping for legacy budgets (there is no API min/NULL setter).
CREATE FUNCTION pg_temp.fill_budgets(line uuid, low integer, high integer) RETURNS void
LANGUAGE plpgsql SECURITY DEFINER SET search_path TO public,pg_temp AS $$ BEGIN
 PERFORM set_config('app.ffe_mutation_rpc','on',true);
 UPDATE public.project_ffe_items SET budget_min_cents=low,budget_max_cents=high
 WHERE id=line AND project_id=pg_temp.fill_id(10);
END; $$;
CREATE FUNCTION pg_temp.fill_remove_member(n integer) RETURNS void
LANGUAGE sql SECURITY DEFINER SET search_path TO public,pg_temp AS $$
 UPDATE public.organization_members SET status='removed'
 WHERE user_id=pg_temp.fill_id(n) AND organization_id=pg_temp.fill_id(100);
$$;
DO $$ DECLARE f regprocedure; BEGIN
 FOR f IN SELECT oid::regprocedure FROM pg_proc WHERE pronamespace=pg_my_temp_schema() LOOP
  EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO authenticated',f);
 END LOOP;
END; $$;
