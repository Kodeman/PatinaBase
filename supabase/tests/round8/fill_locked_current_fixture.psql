 (pg_temp.fill_id(21),pg_temp.fill_id(10),'Dining',1),
 (pg_temp.fill_id(22),pg_temp.fill_id(11),'Foreign',0);
INSERT INTO public.products(id,name,captured_at,layer,owner_user_id,price_trade,price_retail) VALUES
 (pg_temp.fill_id(30),'Fill catalog chair',now(),'catalog',NULL,7000,10000),
 (pg_temp.fill_id(31),'Other private chair',now(),'personal',pg_temp.fill_id(6),7000,10000);
INSERT INTO public.product_configurations(id,product_id,owner_user_id,studio_id,project_id,
 version,schema_revision,evaluation,snapshot,snapshot_hash,is_complete,is_valid) VALUES
