-- Include-only fixture. The caller owns BEGIN/ROLLBACK (or the N() window).
CREATE FUNCTION pg_temp.fill_id(n integer) RETURNS uuid LANGUAGE sql IMMUTABLE AS $$
 SELECT ('f2084000-0000-4000-8000-' || lpad(n::text,12,'0'))::uuid;
$$;
DO $$ BEGIN
 ASSERT NOT EXISTS (SELECT 1 FROM auth.users WHERE id::text LIKE 'f2084000-%'),
   'fill_fixture_starts_absent';
END; $$;
INSERT INTO auth.users(id,email,encrypted_password,email_confirmed_at,instance_id,aud,role)
SELECT pg_temp.fill_id(n), 'fill-'||n||'@test.invalid', '', now(),
 '00000000-0000-0000-0000-000000000000', 'authenticated','authenticated'
FROM generate_series(1,8) n;
INSERT INTO public.profiles(id,email,full_name,is_designer)
SELECT pg_temp.fill_id(n),'fill-'||n||'@test.invalid','Fill actor '||n,true
FROM generate_series(1,8) n ON CONFLICT (id) DO NOTHING;
INSERT INTO public.organizations(id,type,name,slug) VALUES
 (pg_temp.fill_id(100),'design_studio','Fill studio A','sq2084-fill-a'),
 (pg_temp.fill_id(101),'design_studio','Fill studio B','sq2084-fill-b');
INSERT INTO public.organization_members(user_id,organization_id,role,status,joined_at)
SELECT pg_temp.fill_id(n),pg_temp.fill_id(100),
 (CASE n WHEN 1 THEN 'owner' WHEN 3 THEN 'admin' WHEN 4 THEN 'guest' ELSE 'member' END)::public.member_role,
 (CASE n WHEN 5 THEN 'removed' ELSE 'active' END)::public.member_status,now()
FROM generate_series(1,5) n;
INSERT INTO public.organization_members(user_id,organization_id,role,status,joined_at) VALUES
 (pg_temp.fill_id(1),pg_temp.fill_id(101),'owner','active',now()),
 (pg_temp.fill_id(7),pg_temp.fill_id(101),'member','active',now());
