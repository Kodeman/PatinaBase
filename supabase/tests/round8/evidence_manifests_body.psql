 ('plan_issue','plan_issues','f8770000-0000-4000-8000-000000000042','name=''changed'''),
 ('plan_issue_print','plan_issue_prints','f8770000-0000-4000-8000-000000000043','sheet_title=''changed'''),
 ('plan_print','plan_prints','f8770000-0000-4000-8000-000000000041','sha256=repeat(''b'',64)'),
 ('product_configuration','product_configurations','f8770000-0000-4000-8000-000000000044','snapshot=''{}''::jsonb||''{"changed":true}''::jsonb'),
 ('custom_commission_revision','custom_commission_revisions','f8770000-0000-4000-8000-000000000047','brief=''{}''::jsonb||''{"changed":true}''::jsonb'),
 ('review_item','project_review_items','f8770000-0000-4000-8000-000000000050','item_snapshot=''{}''::jsonb||''{"changed":true}''::jsonb'),
