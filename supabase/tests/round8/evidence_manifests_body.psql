SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('empty','f8770000-0000-4000-8000-000000000030','fabrication_instruction','[]')$q$,'23514','manifest_members_empty','empty fabrication refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('missing',NULL)$q$,'23514','manifest_package_required','fabrication requires package');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('foreign','f8770000-0000-4000-8000-000000000032')$q$,'23514','manifest_package_off_project','foreign package refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('archived','f8770000-0000-4000-8000-000000000033')$q$,'23514','manifest_package_off_project','archived package refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('forged','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='plan_print'),'{sha256}',to_jsonb(repeat('b',64)))))$q$,'23514','manifest_member_identity_mismatch','forged file hash refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('stale','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='product_configuration'),'{version}','2')))$q$,'23514','manifest_member_identity_mismatch','stale version refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('mutable','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='product_configuration'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000046'::text))))$q$,'23514','manifest_member_not_frozen','saved configuration refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('foreign','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='product_configuration'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000045'::text))))$q$,'23514','manifest_member_off_project','foreign member refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('draft','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='review_item'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000051'::text))))$q$,'23514','manifest_member_not_frozen','draft review refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('submitted','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='coordination_item_revision'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000057'::text))))$q$,'23514','manifest_member_not_frozen','unapproved submittal refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('head','f8770000-0000-4000-8000-000000000030','package_issue','[{"kind":"plan_sheet","id":"f8770000-0000-4000-8000-000000000040"}]')$q$,'23514','manifest_member_not_frozen','mutable sheet head is not evidence');
SELECT pg_temp.c1_assert((pg_temp.mint('service',NULL,'service_acceptance','[]')->>'manifestId')=(pg_temp.mint('service-alias',NULL,'service_acceptance','[]')->>'manifestId'),'NULL service package dedupes with alias receipt');
INSERT INTO public.margin_notes(id,project_id,designer_id,body,subject_kind,subject_id) VALUES ('f8770000-0000-4000-8000-000000000060','f8770000-0000-4000-8000-000000000020','f8770000-0000-4000-8000-000000000002','Private studio text','project_package','f8770000-0000-4000-8000-000000000030');
SELECT pg_temp.c1_assert(EXISTS(SELECT 1 FROM public.margin_notes WHERE id='f8770000-0000-4000-8000-000000000060' AND subject_kind='project_package'),'package subject accepted for studio member');
SELECT pg_temp.c1_error($q$UPDATE public.margin_notes SET subject_id='f8770000-0000-4000-8000-000000000032' WHERE id='f8770000-0000-4000-8000-000000000060'$q$,'23514','subject_off_project','foreign package note refuses');
SELECT pg_temp.c1_error($q$UPDATE public.evidence_manifests SET purpose=purpose$q$,'42501',NULL,'authenticated direct update denied');
RESET ROLE;
UPDATE public.server_capabilities SET enabled=true WHERE key='margin_note_escalation';
GRANT EXECUTE ON FUNCTION public.escalate_margin_note(uuid,uuid) TO authenticated;
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_assert((public.escalate_margin_note('f8770000-0000-4000-8000-000000000060','f8770000-0000-4000-8000-000000000061')).title='Decision from a studio note','package subject escalates with neutral title');
SELECT pg_temp.c1_assert((SELECT context IS NULL AND status='draft' FROM public.client_decisions WHERE id='f8770000-0000-4000-8000-000000000061'),'package escalation never copies private text');
RESET ROLE;
REVOKE EXECUTE ON FUNCTION public.escalate_margin_note(uuid,uuid) FROM authenticated;
UPDATE public.server_capabilities SET enabled=false WHERE key='margin_note_escalation';
SELECT pg_temp.c1_error($q$UPDATE public.evidence_manifests SET purpose=purpose$q$,'55000','immutable','owner update rejector');
SELECT pg_temp.c1_error($q$DELETE FROM public.evidence_manifests$q$,'55000','immutable','owner delete rejector');
SELECT pg_temp.c1_error($q$UPDATE public.evidence_manifest_requests SET request_hash=request_hash$q$,'55000','immutable','receipt update rejector');
SELECT pg_temp.c1_error($q$DELETE FROM public.evidence_manifest_requests$q$,'55000','immutable','receipt delete rejector');
SELECT pg_temp.c1_error($q$DELETE FROM public.profiles WHERE id='f8770000-0000-4000-8000-000000000002'$q$,'23503',NULL,'minting actor retained with RESTRICT');
SELECT pg_temp.c1_assert(public._subject_project_id('project_package','f8770000-0000-4000-8000-000000000030')='f8770000-0000-4000-8000-000000000020','package subject project helper');
DO $$ DECLARE n integer; BEGIN
 FOR n IN 3..5 LOOP
  PERFORM set_config('request.jwt.claim.sub',('f8770000-0000-4000-8000-'||lpad(n::text,12,'0')),true);
  SET LOCAL ROLE authenticated;
  PERFORM pg_temp.c1_error('SELECT pg_temp.mint(''denied'')','42501','manifest_access_denied','foreign-studio, guest and client denied '||n);
  PERFORM pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM public.evidence_manifests),'RLS hides manifest from denied actor '||n);
  RESET ROLE;
 END LOOP;
END $$;
REVOKE EXECUTE ON FUNCTION public.create_evidence_manifest(uuid,uuid,text,jsonb,text) FROM authenticated;
SELECT pg_temp.c1_assert(NOT has_function_privilege('authenticated','public.create_evidence_manifest(uuid,uuid,text,jsonb,text)','EXECUTE') AND NOT has_function_privilege('anon','public.create_evidence_manifest(uuid,uuid,text,jsonb,text)','EXECUTE'),'activation rollback closes authenticated; anon never opens');
