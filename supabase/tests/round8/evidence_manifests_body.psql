SELECT pg_temp.c1_assert((SELECT result->>'manifestId' FROM results WHERE key='original')<>(SELECT result->>'manifestId' FROM results WHERE key='package-b'),'same members separate by package');
SELECT pg_temp.c1_assert((SELECT result->>'manifestId' FROM results WHERE key='original')<>(SELECT result->>'manifestId' FROM results WHERE key='purpose'),'same members separate by purpose');
SELECT pg_temp.c1_assert((SELECT (result->>'replayed')::boolean FROM results WHERE key='same'),'original key replays');
