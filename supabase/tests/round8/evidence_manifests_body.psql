GRANT EXECUTE ON FUNCTION pg_temp.c1_assert(boolean,text),pg_temp.c1_error(text,text,text,text) TO service_role;
DO $$ DECLARE c record; role_name text; before_row jsonb; after_row jsonb; BEGIN
 FOREACH role_name IN ARRAY ARRAY['postgres','service_role'] LOOP
  FOR c IN SELECT * FROM retention_cases LOOP
   EXECUTE format('SELECT to_jsonb(t) FROM public.%I t WHERE id=$1',c.native_table) INTO before_row USING c.id;
   -- Test-only grants prove the trigger, not a missing table permission, refuses service writes.
   EXECUTE format('GRANT UPDATE,DELETE ON public.%I TO service_role',c.native_table);
   IF role_name='service_role' THEN SET LOCAL ROLE service_role; END IF;
   PERFORM pg_temp.c1_error(format('UPDATE public.%I SET %s WHERE id=%L',c.native_table,c.assignment,c.id),'55000','evidence_member_pinned',role_name||' pinned UPDATE '||c.kind);
   PERFORM pg_temp.c1_error(format('DELETE FROM public.%I WHERE id=%L',c.native_table,c.id),'55000','evidence_member_pinned',role_name||' pinned DELETE '||c.kind);
   RESET ROLE;
   EXECUTE format('SELECT to_jsonb(t) FROM public.%I t WHERE id=$1',c.native_table) INTO after_row USING c.id;
   PERFORM pg_temp.c1_assert(before_row IS NOT DISTINCT FROM after_row,role_name||' zero writes '||c.kind);
  END LOOP;
 END LOOP;
END $$;
SELECT pg_temp.c1_error($q$DELETE FROM public.purchase_orders WHERE id='f8770000-0000-4000-8000-000000000054'$q$,'55000','evidence_member_pinned','PO parent cascade retains snapshot');
-- Enter the native draft-delete boundary; the parent guard otherwise refuses before cascading.
SELECT set_config('app.client_decision_write_id','f8770000-0000-4000-8000-000000000052',true);
SELECT pg_temp.c1_error($q$DELETE FROM public.client_decisions WHERE id='f8770000-0000-4000-8000-000000000052'$q$,'55000','evidence_member_pinned','decision parent cascade retains evidence');
SELECT set_config('app.client_decision_write_id','',true);
SELECT pg_temp.c1_assert((SELECT count(*)=27 FROM public.evidence_manifest_members),'nine relational pins per distinct manifest; replay adds none');
SELECT pg_temp.c1_assert((SELECT count(*)=9 AND bool_and(confdeltype='r') FROM pg_constraint WHERE conrelid='public.evidence_manifest_members'::regclass AND contype='f' AND confrelid<>'public.evidence_manifests'::regclass),'all nine native member FKs RESTRICT');
SELECT pg_temp.c1_error($q$INSERT INTO public.evidence_manifest_members(manifest_id) SELECT id FROM public.evidence_manifests LIMIT 1$q$,'23514',NULL,'exactly one native member required');
SELECT pg_temp.c1_error($q$INSERT INTO public.evidence_manifest_members(manifest_id,po_spec_snapshot_id,coordination_item_revision_id) SELECT id,'f8770000-0000-4000-8000-000000000055','f8770000-0000-4000-8000-000000000056' FROM public.evidence_manifests LIMIT 1$q$,'23514',NULL,'two native members refuse');
UPDATE public.coordination_item_revisions SET note='still mutable' WHERE id='f8770000-0000-4000-8000-000000000057';
SELECT pg_temp.c1_assert((SELECT note='still mutable' FROM public.coordination_item_revisions WHERE id='f8770000-0000-4000-8000-000000000057'),'unpinned coordination keeps native UPDATE');
