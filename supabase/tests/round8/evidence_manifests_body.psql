 ('coordination_item_revision',jsonb_build_object('kind','coordination_item_revision','id','f8770000-0000-4000-8000-000000000056','rev',1,'sha256',encode(extensions.digest(public._plan_room_canonical_json(jsonb_build_object('decisionId','f8770000-0000-4000-8000-000000000052','rev',1,'attachments','[]'::jsonb,'note','frozen')),'sha256'),'hex')));
CREATE TEMP TABLE expected AS SELECT encode(extensions.digest(public._plan_room_canonical_json(jsonb_agg(member ORDER BY kind,member->>'id')),'sha256'),'hex') hash FROM members;
CREATE TEMP TABLE results(key text PRIMARY KEY,result jsonb);
CREATE FUNCTION pg_temp.mint(key text,pkg uuid DEFAULT 'f8770000-0000-4000-8000-000000000030',purpose text DEFAULT 'fabrication_instruction',items jsonb DEFAULT NULL) RETURNS jsonb LANGUAGE sql AS $$
 SELECT public.create_evidence_manifest('f8770000-0000-4000-8000-000000000020',pkg,purpose,coalesce(items,(SELECT jsonb_agg(member ORDER BY kind DESC) FROM members)),key);
$$;
DO $$ DECLARE role text; t text; BEGIN
 FOREACH role IN ARRAY ARRAY['anon','authenticated'] LOOP
  PERFORM pg_temp.c1_assert(NOT has_function_privilege(role,'public.create_evidence_manifest(uuid,uuid,text,jsonb,text)','EXECUTE'),role||' mint inactive');
 END LOOP;
 PERFORM pg_temp.c1_assert(has_function_privilege('service_role','public.create_evidence_manifest(uuid,uuid,text,jsonb,text)','EXECUTE'),'only service mint grant');
 FOREACH t IN ARRAY ARRAY['evidence_manifests','evidence_manifest_requests'] LOOP
  PERFORM pg_temp.c1_assert(NOT has_table_privilege('authenticated','public.'||t,'INSERT,UPDATE,DELETE,TRUNCATE'),'authenticated no direct write '||t);
  PERFORM pg_temp.c1_assert(NOT has_table_privilege('anon','public.'||t,'SELECT'),'anon no read '||t);
 END LOOP;
END $$;
SELECT pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM pg_proc p CROSS JOIN LATERAL aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid='public.create_evidence_manifest(uuid,uuid,text,jsonb,text)'::regprocedure AND a.grantee=0 AND a.privilege_type='EXECUTE'),'PUBLIC mint inactive');
SELECT pg_temp.c1_assert((SELECT count(*)=2 AND bool_and(confdeltype='r') FROM pg_constraint WHERE contype='f' AND conname IN ('evidence_manifests_created_by_fkey','evidence_manifest_requests_created_by_fkey')),'both immutable actor FKs RESTRICT');
-- Test-only activation, always rolled back with the wrapper.
GRANT EXECUTE ON FUNCTION public.create_evidence_manifest(uuid,uuid,text,jsonb,text) TO authenticated;
GRANT ALL ON members,results,expected TO authenticated;
GRANT EXECUTE ON FUNCTION pg_temp.mint(text,uuid,text,jsonb),pg_temp.c1_assert(boolean,text),pg_temp.c1_error(text,text,text,text) TO authenticated;
SELECT set_config('request.jwt.claim.sub','f8770000-0000-4000-8000-000000000002',true);
SET LOCAL ROLE authenticated;
INSERT INTO results VALUES('original',pg_temp.mint('original'));
SELECT pg_temp.c1_assert(NOT (result->>'replayed')::boolean,'nine native member kinds mint') FROM results WHERE key='original';
INSERT INTO results VALUES('same',pg_temp.mint('original')),('alias',pg_temp.mint('alias')),('package-b',pg_temp.mint('package-b','f8770000-0000-4000-8000-000000000031')),('purpose',pg_temp.mint('purpose','f8770000-0000-4000-8000-000000000030','package_issue'));
SELECT pg_temp.c1_assert((SELECT result->>'manifestId' FROM results WHERE key='original')=(SELECT result->>'manifestId' FROM results WHERE key='alias') AND (SELECT (result->>'replayed')::boolean FROM results WHERE key='alias'),'new alias persists and replays exact binding');
SELECT pg_temp.c1_assert((SELECT result->>'manifestId' FROM results WHERE key='original')<>(SELECT result->>'manifestId' FROM results WHERE key='package-b'),'same members separate by package');
SELECT pg_temp.c1_assert((SELECT result->>'manifestId' FROM results WHERE key='original')<>(SELECT result->>'manifestId' FROM results WHERE key='purpose'),'same members separate by purpose');
SELECT pg_temp.c1_assert((SELECT (result->>'replayed')::boolean FROM results WHERE key='same'),'original key replays');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('alias','f8770000-0000-4000-8000-000000000030','fabrication_instruction',(SELECT jsonb_agg(member) FROM members WHERE kind='plan_issue'))$q$,'23505','idempotency_key_reused','alias cannot change members');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('dupe','f8770000-0000-4000-8000-000000000030','package_issue',(SELECT jsonb_build_array(member,member) FROM members WHERE kind='plan_issue'))$q$,'23514','manifest_member_duplicate','duplicate members refuse');
SELECT pg_temp.c1_assert((SELECT count(*)=4 FROM public.evidence_manifest_requests),'every accepted key has one receipt');
SELECT pg_temp.c1_assert((SELECT manifest_hash=(SELECT hash FROM expected) AND members=(SELECT jsonb_agg(member ORDER BY kind,member->>'id') FROM pg_temp.members) FROM public.evidence_manifests WHERE id=(SELECT (result->>'manifestId')::uuid FROM results WHERE key='original')),'server canonical sorted hash matches exact members');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('alias','f8770000-0000-4000-8000-000000000031')$q$,'23505','idempotency_key_reused','alias cannot be reused for another package');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('alias','f8770000-0000-4000-8000-000000000030','package_issue')$q$,'23505','idempotency_key_reused','alias cannot change purpose');
