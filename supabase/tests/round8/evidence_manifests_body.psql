SELECT pg_temp.c1_assert(public._subject_project_id('project_package','f8770000-0000-4000-8000-000000000030')='f8770000-0000-4000-8000-000000000020','package subject project helper');
DO $$ DECLARE n integer; BEGIN
 FOR n IN 3..5 LOOP
  PERFORM set_config('request.jwt.claim.sub',('f8770000-0000-4000-8000-'||lpad(n::text,12,'0')),true);
  SET LOCAL ROLE authenticated;
  PERFORM pg_temp.c1_error('SELECT pg_temp.mint(''denied'')','42501','manifest_access_denied','foreign-studio, guest and client denied '||n);
  PERFORM pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM public.evidence_manifests),'RLS hides manifest from denied actor '||n);
  RESET ROLE;
 END LOOP;
END $$;
REVOKE EXECUTE ON FUNCTION public.create_evidence_manifest(uuid,uuid,text,jsonb,text) FROM authenticated;
SELECT pg_temp.c1_assert(NOT has_function_privilege('authenticated','public.create_evidence_manifest(uuid,uuid,text,jsonb,text)','EXECUTE') AND NOT has_function_privilege('anon','public.create_evidence_manifest(uuid,uuid,text,jsonb,text)','EXECUTE'),'activation rollback closes authenticated; anon never opens');

-- Recorded-tenant matrix: owner belongs to A+B; members belong to only A or B.
SET LOCAL session_replication_role=replica;
INSERT INTO public.margin_notes(id,project_id,designer_id,body,subject_kind,subject_id)
 SELECT ('f8770000-0000-4000-8000-'||lpad((100+j*10+n)::text,12,'0'))::uuid,
 ('f8770000-0000-4000-8000-'||lpad((20+j)::text,12,'0'))::uuid,
 ('f8770000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid,'private','project_package',
 ('f8770000-0000-4000-8000-'||lpad((30+j*2)::text,12,'0'))::uuid
 FROM generate_series(0,1)j CROSS JOIN generate_series(1,5)n;
SET LOCAL session_replication_role=origin;
UPDATE public.server_capabilities SET enabled=true WHERE key='margin_note_escalation';
GRANT EXECUTE ON FUNCTION public.escalate_margin_note(uuid,uuid) TO authenticated;
DO $$ DECLARE n integer; j integer; admitted boolean; note_id uuid; actor_id uuid; project_id uuid; package_id uuid; decision_id uuid; changed integer; cmd text; BEGIN
 FOR j IN 0..1 LOOP
  FOR n IN 1..5 LOOP
   actor_id:=('f8770000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid;
   project_id:=('f8770000-0000-4000-8000-'||lpad((20+j)::text,12,'0'))::uuid;
   package_id:=('f8770000-0000-4000-8000-'||lpad((30+j*2)::text,12,'0'))::uuid;
   note_id:=('f8770000-0000-4000-8000-'||lpad((100+j*10+n)::text,12,'0'))::uuid;
   decision_id:=('f8770000-0000-4000-8000-'||lpad((300+j*10+n)::text,12,'0'))::uuid;
   admitted:=n=1 OR (j=0 AND n=2) OR (j=1 AND n=3);
   PERFORM set_config('request.jwt.claim.sub',actor_id::text,true);
   SET LOCAL ROLE authenticated;
   cmd:=format('INSERT INTO public.margin_notes(project_id,designer_id,body,subject_kind,subject_id) VALUES(%L,%L,''private'',''project_package'',%L)',project_id,actor_id,package_id);
   IF admitted THEN
    EXECUTE cmd;
    PERFORM pg_temp.c1_assert(true,format('package note INSERT allowed studio %s actor %s',j,n));
   ELSE
    PERFORM pg_temp.c1_error(cmd,'42501',NULL,format('package note INSERT denied studio %s actor %s',j,n));
   END IF;
   UPDATE public.margin_notes SET body='updated private' WHERE id=note_id;
   GET DIAGNOSTICS changed=ROW_COUNT;
   PERFORM pg_temp.c1_assert(changed=CASE WHEN admitted THEN 1 ELSE 0 END,format('package note UPDATE tenant matrix studio %s actor %s',j,n));
   IF admitted THEN
    PERFORM public.escalate_margin_note(note_id,decision_id);
    PERFORM pg_temp.c1_assert((SELECT title='Decision from a studio note' AND context IS NULL FROM public.client_decisions WHERE id=decision_id),format('package note escalation neutral studio %s actor %s',j,n));
   ELSE
    PERFORM pg_temp.c1_error(format('SELECT public.escalate_margin_note(%L,%L)',note_id,decision_id),'42501','note access denied',format('package note escalation denied studio %s actor %s',j,n));
   END IF;
   RESET ROLE;
  END LOOP;
 END LOOP;
END $$;
SELECT set_config('request.jwt.claim.sub','f8770000-0000-4000-8000-000000000001',true);
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_error($q$INSERT INTO public.margin_notes(project_id,designer_id,body,subject_kind,subject_id) VALUES('f8770000-0000-4000-8000-000000000020','f8770000-0000-4000-8000-000000000001','private','project_package','f8770000-0000-4000-8000-000000000032')$q$,'23514','subject_off_project','INSERT real studio-B package refuses');
SELECT pg_temp.c1_error($q$UPDATE public.margin_notes SET subject_id='f8770000-0000-4000-8000-000000000032' WHERE id='f8770000-0000-4000-8000-000000000101'$q$,'23514','subject_off_project','UPDATE real studio-B package refuses');
SELECT pg_temp.c1_error($q$UPDATE public.margin_notes SET subject_id='f8770000-0000-4000-8000-000000000999' WHERE id='f8770000-0000-4000-8000-000000000101'$q$,'23514','subject_off_project','absent package fails closed');
RESET ROLE;
SAVEPOINT null_subject_helper;
CREATE OR REPLACE FUNCTION public._subject_project_id(p_kind text,p_id uuid) RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER SET search_path=public,pg_temp AS $$ SELECT NULL::uuid $$;
SET LOCAL ROLE authenticated;
SELECT pg_temp.c1_error($q$INSERT INTO public.margin_notes(project_id,designer_id,body,subject_kind,subject_id) VALUES('f8770000-0000-4000-8000-000000000020','f8770000-0000-4000-8000-000000000001','private','project_package','f8770000-0000-4000-8000-000000000030')$q$,'23514','subject_off_project','NULL helper INSERT fails closed');
SELECT pg_temp.c1_error($q$UPDATE public.margin_notes SET body='bad' WHERE id='f8770000-0000-4000-8000-000000000101'$q$,'23514','subject_off_project','NULL helper UPDATE fails closed');
SELECT pg_temp.c1_error($q$SELECT public.escalate_margin_note('f8770000-0000-4000-8000-000000000101','f8770000-0000-4000-8000-000000000301')$q$,'23514','subject_off_project','NULL helper escalation fails closed');
RESET ROLE;
ROLLBACK TO null_subject_helper;
REVOKE EXECUTE ON FUNCTION public.escalate_margin_note(uuid,uuid) FROM authenticated;
UPDATE public.server_capabilities SET enabled=false WHERE key='margin_note_escalation';
