SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('mutable','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='product_configuration'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000046'::text))))$q$,'23514','manifest_member_not_frozen','saved configuration refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('foreign','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='product_configuration'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000045'::text))))$q$,'23514','manifest_member_off_project','foreign member refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('draft','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='review_item'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000051'::text))))$q$,'23514','manifest_member_not_frozen','draft review refuses');
SELECT pg_temp.c1_error($q$SELECT pg_temp.mint('submitted','f8770000-0000-4000-8000-000000000030','package_issue',jsonb_build_array(jsonb_set((SELECT member FROM members WHERE kind='coordination_item_revision'),'{id}',to_jsonb('f8770000-0000-4000-8000-000000000057'::text))))$q$,'23514','manifest_member_not_frozen','unapproved submittal refuses');
