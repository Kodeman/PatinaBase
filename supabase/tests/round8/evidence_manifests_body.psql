SELECT pg_temp.c1_assert(NOT EXISTS(SELECT 1 FROM public.po_spec_snapshots WHERE id='f8770000-0000-4000-8000-000000000078') AND NOT EXISTS(SELECT 1 FROM public.coordination_item_revisions WHERE id='f8770000-0000-4000-8000-000000000057'),'unpinned mutable evidence keeps native DELETE');
