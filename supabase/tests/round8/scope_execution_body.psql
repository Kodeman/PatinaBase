SELECT pg_temp.assert_true((SELECT count(*)=1 AND bool_and(o.execution_seq=1 AND d.document_kind='design_build')
 FROM public.project_scope_editions e JOIN public.project_commercial_documents d ON d.id=e.commercial_document_id
 JOIN public.project_commercial_execution_order o ON o.commercial_document_id=d.id
 WHERE e.source_proposal_id='f8693000-0000-4000-8000-000000000004'),'design_build native countersign records order and baseline');

CREATE FUNCTION pg_temp.amend(job uuid, title text, installer text) RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE p uuid; parts jsonb;
BEGIN
 p:=(public.create_service_addendum(job,title)->>'proposalId')::uuid;
 PERFORM public.copy_agreement_parts_from_authority(p,'Copy frozen scope');
 SELECT jsonb_agg(CASE WHEN part->>'kind'='scope_package' THEN
  jsonb_set(part,'{payload,responsibilities,installation}',to_jsonb(installer)) ELSE part END ORDER BY ord)
 INTO parts FROM jsonb_array_elements(pg_temp.parts(p)) WITH ORDINALITY e(part,ord);
 PERFORM public.upsert_agreement_parts(p,parts,title);
 PERFORM pg_temp.send_and_sign(p);
 RETURN p;
END $$;
DO $$ DECLARE job uuid; p uuid; stale uuid; BEGIN
 SELECT (value->>'projectId')::uuid INTO job FROM scope_execution_results WHERE key='build';
 p:=pg_temp.amend(job,'Start installation','studio');
 PERFORM public.countersign_design_services_agreement(p,'Execution Designer');
 stale:=pg_temp.amend(job,'Concurrent stale draft','studio');
 p:=pg_temp.amend(job,'Release installation','gc');
 PERFORM public.countersign_design_services_agreement(p,'Execution Designer');
 PERFORM pg_temp.assert_true((SELECT design_owed_since=1 AND installation_owed_since IS NULL
  FROM public.project_scope_edition_packages pk JOIN public.project_scope_editions e ON e.id=pk.edition_id
  WHERE e.project_id=job AND e.status='active'),'released installation clears owed-since without restarting design');
 PERFORM pg_temp.expect_error(format('SELECT public.countersign_design_services_agreement(%L,''Execution Designer'')',stale),
  'PT409','scope_edition_stale','stale addendum execution refuses under project lock');
 PERFORM pg_temp.expect_error(format('SELECT public.countersign_design_services_agreement(%L,''Execution Designer'')',stale),
  'PT409','scope_edition_stale','stale addendum retry also refuses');
 PERFORM pg_temp.assert_true((SELECT count(*)=3 FROM public.project_commercial_execution_order WHERE project_id=job)
  AND NOT EXISTS(SELECT 1 FROM public.commercial_document_signatures WHERE proposal_id=stale AND party_role='studio')
  AND (SELECT commercial_state='client_signed' FROM public.proposals WHERE id=stale),
  'stale execution and retry leave no order signature or commercial-state partial writes');
 p:=pg_temp.amend(job,'Restart installation','studio');
 PERFORM public.countersign_design_services_agreement(p,'Execution Designer');
 PERFORM pg_temp.assert_true((SELECT design_owed_since=1 AND installation_owed_since=4
  FROM public.project_scope_edition_packages pk JOIN public.project_scope_editions e ON e.id=pk.edition_id
  WHERE e.project_id=job AND e.status='active'),'restarted installation starts new edition run while design continues');
END $$;

-- Every content collection matches canonical child rows; all frozen rows reject update/delete.
DO $$ DECLARE e record; t text; expr text; BEGIN
 FOR e IN SELECT * FROM public.project_scope_editions LOOP
  SELECT COALESCE(jsonb_agg(to_jsonb(p)-'edition_id' ORDER BY package_key),'[]') INTO e.content_hash
   FROM public.project_scope_edition_packages p WHERE edition_id=e.id;
  PERFORM pg_temp.assert_true(e.content->'packages'=e.content_hash::jsonb,'frozen package content/child parity edition '||e.edition_number);
  PERFORM pg_temp.assert_true(e.content->'phases'=(SELECT COALESCE(jsonb_agg(to_jsonb(p)-'edition_id'
   ORDER BY source_proposal_phase_id),'[]') FROM public.project_scope_edition_phases p WHERE edition_id=e.id),
   'frozen phase content/child parity edition '||e.edition_number);
  PERFORM pg_temp.assert_true(COALESCE(e.content#>'{signerPolicy,signers}','[]')=(SELECT COALESCE(jsonb_agg(
   jsonb_build_object('slot',s.slot,'required',s.required)||CASE WHEN s.profile_id IS NOT NULL THEN
    jsonb_build_object('profileId',s.profile_id) ELSE jsonb_build_object('householdPersonId',s.household_person_id) END
   ORDER BY s.slot),'[]') FROM public.project_scope_edition_signers s WHERE edition_id=e.id),
   'frozen signer content/child parity edition '||e.edition_number);
 END LOOP;
 FOREACH t IN ARRAY ARRAY['project_scope_editions','project_scope_edition_packages','project_scope_edition_phases','project_scope_edition_signers'] LOOP
  expr:=CASE WHEN t='project_scope_editions' THEN 'id=id' ELSE 'edition_id=edition_id' END;
  PERFORM pg_temp.expect_error(format('UPDATE public.%I SET %s',t,expr),'23514','scope_record_immutable',t||' rejects update');
  PERFORM pg_temp.expect_error(format('DELETE FROM public.%I',t),'23514','scope_record_immutable',t||' rejects delete');
 END LOOP;
END $$;

-- An amendment executed while paused changes billing natively, but freezes scope stale.
SET LOCAL ROLE authenticated;
INSERT INTO scope_execution_results VALUES('paused',public.create_service_addendum(
 (SELECT (value->>'projectId')::uuid FROM scope_execution_results WHERE key='origin'),'Paused amendment'));
SELECT public.copy_agreement_parts_from_authority((SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='paused'),'copy before pause');
SELECT pg_temp.send_and_sign((SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='paused'));
RESET ROLE;
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
SET LOCAL ROLE authenticated;
SELECT public.countersign_design_services_agreement((SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='paused'),'Execution Designer');
RESET ROLE;
SELECT pg_temp.assert_true((SELECT count(*)=2 AND count(*) FILTER(WHERE status='stale' AND stale_reason='amended_while_inactive' AND stale_execution_seq=3)=1
 FROM public.project_scope_editions WHERE project_id=(SELECT (value->>'projectId')::uuid FROM scope_execution_results WHERE key='origin')),
 'paused amendment makes active edition stale without minting');
SELECT pg_temp.assert_true((SELECT count(*)=3 AND max(execution_seq)=3 FROM public.project_commercial_execution_order WHERE project_id=
 (SELECT (value->>'projectId')::uuid FROM scope_execution_results WHERE key='origin')),'paused amendment still assigns execution sequence');
SELECT pg_temp.assert_true((SELECT count(*)=1 FROM public.project_billing_authorities WHERE status='active' AND source_proposal_id=
 (SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='paused')),'paused amendment preserves native active billing authority');

-- SQ-2088: the draft predecessor is a server-owned, project-bound reference.
SELECT pg_temp.assert_true((SELECT NOT prosecdef AND proowner=(SELECT proowner FROM pg_proc
 WHERE oid='public.create_service_addendum(uuid,text)'::regprocedure)
 FROM pg_proc WHERE oid=to_regprocedure('public._guard_proposal_scope_edition()')),
 'pointer guard is invoker and shares native addendum owner');
UPDATE public.server_capabilities SET enabled=true WHERE key='scope_editions';
SET LOCAL ROLE authenticated;
INSERT INTO scope_execution_results VALUES('pointer_guard',public.create_service_addendum(
 (SELECT (value->>'projectId')::uuid FROM scope_execution_results WHERE key='build'),'Pointer guard draft'));
SELECT public.copy_agreement_parts_from_authority((SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='pointer_guard'),'Copy native fee parts before send');
RESET ROLE;
SELECT pg_temp.assert_true((SELECT p.drafted_against_scope_edition_id=e.id FROM public.proposals p
 JOIN public.project_scope_editions e ON e.project_id=(SELECT (value->>'projectId')::uuid
 FROM scope_execution_results WHERE key='build') AND e.status='active'
 WHERE p.id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')),
 'native addendum sets project-bound pointer');
SELECT pg_temp.assert_true(current_setting('app.scope_edition_writer',true)='',
 'native addendum clears pointer writer marker');
SELECT pg_temp.actor(2);
SET LOCAL ROLE authenticated;
WITH changed AS (UPDATE public.proposals SET title='Member edits ordinary draft text'
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard') RETURNING id)
SELECT pg_temp.assert_true((SELECT count(*)=1 FROM changed),'studio member can update guarded draft ordinary fields');
SELECT pg_temp.expect_error($q$UPDATE public.proposals SET drafted_against_scope_edition_id=(
 SELECT drafted_against_scope_edition_id FROM public.proposals WHERE id=(SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='pointer_guard')) WHERE id='f8693000-0000-4000-8000-000000000005'$q$,
 '23514','scope_edition_sanctioned_writer_required','studio member cannot set draft pointer');
SELECT pg_temp.expect_error($q$UPDATE public.proposals SET drafted_against_scope_edition_id=NULL
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')$q$,
 '23514','scope_edition_sanctioned_writer_required','studio member cannot clear draft pointer');
SELECT set_config('app.scope_edition_writer',(SELECT value->>'proposalId' FROM scope_execution_results WHERE key='pointer_guard'),true);
SELECT pg_temp.expect_error($q$UPDATE public.proposals SET drafted_against_scope_edition_id=NULL
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')$q$,
 '23514','scope_edition_sanctioned_writer_required','caller-set marker cannot authorize pointer change');
SELECT set_config('app.scope_edition_writer','',true);
SELECT pg_temp.expect_error($q$INSERT INTO public.proposals(id,designer_id,designer_client_id,client_id,title,total_amount,status,drafted_against_scope_edition_id)
 SELECT 'f8693000-0000-4000-8000-000000000099','f8690000-0000-4000-8000-000000000001',
 'f8692000-0000-4000-8000-000000000001','f8690000-0000-4000-8000-000000000005','Caller pointer insert',0,'draft',drafted_against_scope_edition_id
 FROM public.proposals WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')$q$,
 '23514','scope_edition_sanctioned_writer_required','studio member cannot insert nonnull pointer');
RESET ROLE;
-- An authentic owner/marker pair still cannot bind a foreign project's edition.
SELECT set_config('app.scope_edition_writer',(SELECT value->>'proposalId' FROM scope_execution_results WHERE key='pointer_guard'),true);
SELECT pg_temp.expect_error($q$UPDATE public.proposals SET drafted_against_scope_edition_id=(SELECT id
 FROM public.project_scope_editions WHERE source_proposal_id='f8693000-0000-4000-8000-000000000003')
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')$q$,
 '23514','scope_edition_project_mismatch','server marker cannot bind foreign project edition');
SELECT set_config('app.scope_edition_writer','',true);
-- Corrupt storage only inside the exception subtransaction; copy must defend itself.
SELECT pg_temp.expect_error($q$DO $x$ BEGIN
 SET LOCAL session_replication_role=replica;
 UPDATE public.proposals SET drafted_against_scope_edition_id=(SELECT id FROM public.project_scope_editions
 WHERE source_proposal_id='f8693000-0000-4000-8000-000000000003')
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard');
 SET LOCAL session_replication_role=origin;
 PERFORM public.copy_agreement_parts_from_authority((SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='pointer_guard'),'foreign pointer control');
 END $x$;$q$,'23514','scope_edition_project_mismatch','copy independently refuses replica-planted foreign pointer');
SELECT pg_temp.actor(1);
SET LOCAL ROLE authenticated;
SELECT public.send_commercial_document((SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard'),
 public.get_commercial_document_send_snapshot((SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='pointer_guard'))->>'documentFingerprint',NULL,now()+interval '30 days');
SELECT pg_temp.assert_true((SELECT commercial_state='sent' FROM public.proposals WHERE id=(
 SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')),'pointer refusal exercises sent proposal');
SELECT pg_temp.actor(2);
SELECT pg_temp.expect_error($q$UPDATE public.proposals SET drafted_against_scope_edition_id=NULL
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')$q$,
 '23514','scope_edition_sanctioned_writer_required','studio member cannot change sent pointer');
SELECT pg_temp.actor(5);
SELECT public.sign_design_services_agreement((SELECT (value->>'proposalId')::uuid
 FROM scope_execution_results WHERE key='pointer_guard'),'Execution Client');
SELECT pg_temp.actor(2);
SELECT pg_temp.assert_true((SELECT commercial_state='client_signed' FROM public.proposals WHERE id=(
 SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')),'pointer refusal exercises client-signed proposal');
SELECT pg_temp.expect_error($q$UPDATE public.proposals SET drafted_against_scope_edition_id=NULL
 WHERE id=(SELECT (value->>'proposalId')::uuid FROM scope_execution_results WHERE key='pointer_guard')$q$,
 '23514','scope_edition_sanctioned_writer_required','studio member cannot change signed pointer');
RESET ROLE;
SELECT pg_temp.actor(1);
UPDATE public.server_capabilities SET enabled=false WHERE key='scope_editions';
