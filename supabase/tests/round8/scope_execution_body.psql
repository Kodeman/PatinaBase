-- B02a real PostgreSQL oracle. Enclosing runner owns BEGIN/ROLLBACK.
CREATE FUNCTION pg_temp.assert_true(ok boolean, name text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  IF ok IS DISTINCT FROM true THEN RAISE EXCEPTION 'ASSERTION FAILED: %',name; END IF;
  RAISE NOTICE 'PASS: %',name;
END $$;
CREATE FUNCTION pg_temp.expect_error(command text, state text, message text, name text)
RETURNS void LANGUAGE plpgsql AS $$
DECLARE actual_state text; actual_message text;
BEGIN
  BEGIN EXECUTE command;
  EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS actual_state=RETURNED_SQLSTATE,actual_message=MESSAGE_TEXT;
  END;
  PERFORM pg_temp.assert_true(actual_state=state AND (message IS NULL OR strpos(actual_message,message)>0),
    name||format(' [expected %s/%s, got %s/%s]',state,message,actual_state,actual_message));
END $$;
CREATE FUNCTION pg_temp.actor(n integer) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claim.sub','f8690000-0000-4000-8000-'||lpad(n::text,12,'0'),true);
  PERFORM set_config('request.jwt.claims',jsonb_build_object('sub',
    'f8690000-0000-4000-8000-'||lpad(n::text,12,'0'),'role','authenticated')::text,true);
END $$;

-- Inspect shipped ACLs before any test-only grant or capability change.
DO $$ DECLARE f record; r text; BEGIN
  FOR f IN SELECT p.oid::regprocedure signature FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
    WHERE n.nspname='public' AND p.proname IN ('_validate_scope_signer_parts','_validate_scope_retained_parts',
      '_scope_parts_from_edition','_record_scope_execution','_mint_scope_edition','_scope_after_execution') LOOP
    FOREACH r IN ARRAY ARRAY['anon','authenticated'] LOOP
      PERFORM pg_temp.assert_true(NOT has_function_privilege(r,f.signature,'EXECUTE'),r||' no execute '||f.signature);
    END LOOP;
    PERFORM pg_temp.assert_true(NOT EXISTS (SELECT 1 FROM pg_proc p,
      aclexplode(COALESCE(p.proacl,acldefault('f',p.proowner))) acl
      WHERE p.oid=f.signature::oid AND acl.grantee=0 AND acl.privilege_type='EXECUTE'),'PUBLIC no execute '||f.signature);
  END LOOP;
END $$;
SELECT pg_temp.assert_true((SELECT NOT enabled FROM public.server_capabilities WHERE key='scope_editions'),'capability ships false');
SELECT pg_temp.assert_true(NOT EXISTS(SELECT 1 FROM auth.users WHERE id::text LIKE 'f8690000-%'),'fixture starts absent');
SET LOCAL session_replication_role=replica;
INSERT INTO auth.users(id,email,encrypted_password,email_confirmed_at,created_at,updated_at,aud,role)
SELECT ('f8690000-0000-4000-8000-'||lpad(n::text,12,'0'))::uuid,
  'scope-execution-'||n||'@test.invalid','',now(),now(),now(),'authenticated','authenticated' FROM generate_series(1,5)n;
INSERT INTO public.profiles(id,email,full_name,is_designer)
SELECT id,email,'Scope execution fixture',true FROM auth.users WHERE id::text LIKE 'f8690000-%';
