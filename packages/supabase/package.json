{
  "name": "@patina/supabase",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./hooks": "./src/hooks/index.ts",
    "./auth": "./src/auth/index.ts"
  },
  "scripts": {
    "generate": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > src/database.types.ts",
    "push": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "studio": "supabase studio",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@patina/shared": "workspace:*",
    "@patina/types": "workspace:*",
    "@patina/utils": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.43.0",
    "@supabase/storage-js": "2.98.0",
    "@tanstack/react-query": "^5.40.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "msw": "^2.3.0",
    "supabase": "^2.67.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "_versionLocks": {
    "@supabase/storage-js": "Exact-pinned (not ^). Must stay version-locked to whatever @supabase/storage-js version @supabase/supabase-js bundles internally — src/client.ts's pinStorageDirect() (D-B2/F2 storage-direct ruling) constructs a StorageClient directly from this package and reaches into the SupabaseClient instance's protected `headers`/`fetch`/`storage` fields, which rely on the two packages' shapes staying identical. Bump both together, never just one."
  }
}
