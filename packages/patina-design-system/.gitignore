# Build outputs — tsup/tsc emit these; the design system's sources are all
# .tsx/.ts. Compiled JS + declaration/source maps must never be committed into
# src/ (they flaked whole-repo type-check — Wave 5A cleanup, delivery-log G4).
dist/
src/**/*.jsx
src/**/*.js
src/**/*.jsx.map
src/**/*.js.map
src/**/*.d.ts.map

# Root-level *.config.ts / vitest.setup.ts also get accidentally tsc-compiled
# in place (same failure mode as above, just outside src/) — strip the stray
# siblings, keep only the .ts sources (phase1-close artifact-gc cleanup).
/tailwind.config.js
/tailwind.config.d.ts
/tailwind.config.js.map
/tailwind.config.d.ts.map
/tsup.config.js
/tsup.config.d.ts
/tsup.config.js.map
/tsup.config.d.ts.map
/vitest.config.js
/vitest.config.d.ts
/vitest.config.js.map
/vitest.config.d.ts.map
/vitest.setup.js
/vitest.setup.d.ts
/vitest.setup.js.map
/vitest.setup.d.ts.map
