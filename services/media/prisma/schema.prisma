// Patina Media & 3D Pipeline - Prisma Schema
// Database: PostgreSQL 16 on OCI Database
// Last updated: 2025-10-03

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Main media asset entity - images and 3D models
model MediaAsset {
  id        String     @id @default(uuid())
  kind      AssetKind // image | model3d
  productId String?    @map("product_id")
  variantId String?    @map("variant_id")
  projectId String?    @map("project_id")
  role      AssetRole? // hero | angle | lifestyle | detail | ar-preview

  // Storage paths
  rawKey    String      @unique @map("raw_key")
  processed Boolean     @default(false)
  status    AssetStatus @default(PENDING)

  // Image metadata
  width     Int?
  height    Int?
  format    String?
  sizeBytes Int?    @map("size_bytes")
  mimeType  String? @map("mime_type")

  // Image analysis
  phash    String? @db.VarChar(64)
  palette  Json? // Color palette from k-means
  blurhash String? @db.VarChar(100)
  lqipKey  String? @map("lqip_key") // Low quality image placeholder

  // Licensing & rights
  license Json? // {licenseType, attribution, expiresAt, usageScope, sourceVendorId}

  // Quality control
  qcIssues Json?  @map("qc_issues") // [{code, severity, message, autoFlag}]
  qcScore  Float? @default(0) @map("qc_score")

  // Virus scanning
  scanStatus ScanStatus @default(PENDING) @map("scan_status")
  scanResult Json?      @map("scan_result")

  // Access control
  isPublic    Boolean @default(false) @map("is_public")
  permissions Json? // {users: string[], roles: string[]}

  // Usage tracking
  viewCount     Int @default(0) @map("view_count")
  downloadCount Int @default(0) @map("download_count")

  // Tags for categorization
  tags String[] @default([])

  // Sort order for display
  sortOrder Int @default(0) @map("sort_order")

  // Metadata
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  renditions AssetRendition[]
  threeD     ThreeDAsset?
  jobs       ProcessJob[]

  @@index([productId])
  @@index([variantId])
  @@index([kind, status])
  @@index([phash])
  @@index([createdAt])
  @@index([uploadedBy])
  @@index([projectId, createdAt(sort: Desc)], map: "idx_media_assets_project_created")
  @@map("media_assets")
}

// Image renditions - different sizes and formats
model AssetRendition {
  id      String     @id @default(uuid())
  assetId String     @map("asset_id")
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Rendition details
  key       String           @unique
  width     Int?
  height    Int?
  format    RenditionFormat
  sizeBytes Int?             @map("size_bytes")
  purpose   RenditionPurpose

  // Transformation metadata
  transform Json? // {resize, quality, filters, etc}

  createdAt DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@index([purpose])
  @@map("asset_renditions")
}

// 3D asset metadata - GLB/USDZ processing results
model ThreeDAsset {
  id      String     @id @default(uuid())
  assetId String     @unique @map("asset_id")
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Output files
  glbKey  String? @map("glb_key")
  usdzKey String? @map("usdz_key")

  // Geometry stats
  triCount      Int? @map("tri_count")
  nodeCount     Int? @map("node_count")
  materialCount Int? @map("material_count")
  textureCount  Int? @map("texture_count")

  // Physical dimensions (meters)
  widthM   Float? @map("width_m")
  heightM  Float? @map("height_m")
  depthM   Float? @map("depth_m")
  volumeM3 Float? @map("volume_m3")

  // Optimization levels
  lods Json? // [{lod:0, triCount:..., key:...}, ...]

  // Materials & textures
  materials Json? // [{name, type, textures:[...]}]
  textures  Json? // [{name, width, height, format, key}]

  // AR readiness
  arReady  Boolean @default(false) @map("ar_ready")
  arChecks Json?   @map("ar_checks") // Validation results for AR Quick Look

  // Preview snapshots
  snapshots Json? // {front, iso, top} -> keys

  // Quality control
  qcIssues Json? @map("qc_issues")

  // Performance metrics
  drawCalls  Int?  @map("draw_calls")
  perfBudget Json? @map("perf_budget") // Estimated performance metrics

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("three_d_assets")
}

// Background job processing
model ProcessJob {
  id      String     @id @default(uuid())
  assetId String     @map("asset_id")
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  type     JobType
  state    JobState @default(QUEUED)
  priority Int      @default(0)

  // Execution tracking
  attempts   Int @default(0)
  maxRetries Int @default(3) @map("max_retries")

  // Error handling
  error     String? @db.Text
  errorCode String? @map("error_code")

  // Timing
  queuedAt   DateTime  @default(now()) @map("queued_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  // Job metadata
  meta   Json? // Job-specific configuration
  result Json? // Job output data

  // Worker tracking
  workerId String? @map("worker_id")

  @@index([assetId, state])
  @@index([type, state])
  @@index([state, queuedAt])
  @@index([workerId])
  @@map("process_jobs")
}

// Upload sessions for tracking PAR-based uploads
model UploadSession {
  id      String  @id @default(uuid())
  assetId String? @map("asset_id")

  // Upload intent
  filename String
  fileSize Int?      @map("file_size")
  mimeType String    @map("mime_type")
  kind     AssetKind

  // PAR details
  parUrl    String   @map("par_url") @db.Text
  targetKey String   @unique @map("target_key")
  expiresAt DateTime @map("expires_at")

  // Upload tracking
  status     UploadStatus @default(PENDING)
  uploadedAt DateTime?    @map("uploaded_at")

  // User context
  userId    String     @map("user_id")
  productId String?    @map("product_id")
  variantId String?    @map("variant_id")
  role      AssetRole?

  // Idempotency
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("upload_sessions")
}

// License metadata and rights management
model LicenseRecord {
  id String @id @default(uuid())

  // Asset association
  assetIds String[] @map("asset_ids") // Can apply to multiple assets

  // License details
  licenseType    String  @map("license_type") // stock | custom | royalty-free | rights-managed
  sourceVendor   String? @map("source_vendor")
  sourceVendorId String? @map("source_vendor_id")

  // Terms
  attribution String?   @db.Text
  usageScope  String[]  @map("usage_scope") // web | ar | print | ads
  territory   String? // Geographic restrictions
  expiresAt   DateTime? @map("expires_at")

  // Rights documents
  proofDocKey String? @map("proof_doc_key") // Link to rights proof in Object Storage

  // Alerts
  alertsSent Json? @map("alerts_sent") // Track expiry notifications

  // Audit
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([licenseType])
  @@map("license_records")
}

// Enums
enum AssetKind {
  IMAGE
  MODEL3D
  DOCUMENT

  @@map("asset_kind")
}

enum AssetRole {
  HERO
  ANGLE
  LIFESTYLE
  DETAIL
  AR_PREVIEW
  TEXTURE
  OTHER

  @@map("asset_role")
}

enum AssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  BLOCKED
  QUARANTINED

  @@map("asset_status")
}

enum ScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  ERROR

  @@map("scan_status")
}

enum RenditionFormat {
  JPEG
  PNG
  WEBP
  AVIF

  @@map("rendition_format")
}

enum RenditionPurpose {
  THUMB // Small thumbnail
  WEB // Web display
  RETINA // High DPI
  PREVIEW // LQIP/blurhash
  ORIGINAL // Original format

  @@map("rendition_purpose")
}

enum JobType {
  IMAGE_PROCESS
  IMAGE_TRANSFORM
  MODEL3D_CONVERT
  MODEL3D_OPTIMIZE
  SNAPSHOT_GENERATE
  VIRUS_SCAN
  METADATA_EXTRACT
  ASSET_DELETE
  BULK_DELETE
  BULK_COPY
  CLEANUP_ORPHANED

  @@map("job_type")
}

enum JobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRY
  CANCELED

  @@map("job_state")
}

enum UploadStatus {
  PENDING
  UPLOADED
  FAILED
  EXPIRED

  @@map("upload_status")
}

// Outbox Pattern for Event Publishing (Transactional Outbox)
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String // e.g., "catalog.media.processed", "catalog.media.failed"
  payload     Json // Event payload
  headers     Json? // Additional headers (traceId, etc.)
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")

  @@index([type, published])
  @@index([createdAt])
  @@map("outbox_events")
}

model BackgroundRemovalRequest {
  id                   String                    @id @default(uuid()) @db.Uuid
  quotaOwnerId         String                    @map("quota_owner_id") @db.Uuid
  studioId             String?                   @map("studio_id") @db.Uuid
  requestedBy          String                    @map("requested_by") @db.Uuid
  boardId              String                    @map("board_id") @db.Uuid
  itemId               String                    @map("item_id") @db.Uuid
  idempotencyKey       String                    @map("idempotency_key") @db.VarChar(128)
  status               BackgroundRemovalStatus   @default(RESERVED)
  outcome              BackgroundRemovalOutcome?
  studioPeriodStart    DateTime                  @map("studio_period_start") @db.Date
  globalPeriodStart    DateTime                  @map("global_period_start") @db.Date
  studioLimit          Int                       @map("studio_limit")
  globalLimit          Int                       @map("global_limit")
  reservationExpiresAt DateTime                  @map("reservation_expires_at")
  originalUrl          String?                   @map("original_url") @db.Text
  cutoutUrl            String?                   @map("cutout_url") @db.Text
  creditsUsed          Decimal                   @default(0) @map("credits_used") @db.Decimal(10, 4)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  completedAt          DateTime?                 @map("completed_at")

  @@unique([quotaOwnerId, idempotencyKey], map: "background_removal_requests_quota_owner_idempotency_key")
  @@index([quotaOwnerId, studioPeriodStart, status], map: "background_removal_requests_studio_quota_idx")
  @@index([globalPeriodStart, status], map: "background_removal_requests_global_quota_idx")
  @@index([boardId, itemId], map: "background_removal_requests_target_idx")
  @@map("background_removal_requests")
}

enum BackgroundRemovalStatus {
  RESERVED
  SUCCEEDED
  FAILED_RELEASED
  FAILED_CHARGED
  FAILED_COUNTED

  @@map("background_removal_status")
}

enum BackgroundRemovalOutcome {
  SUCCEEDED
  SOURCE_REJECTED
  VENDOR_FAILED
  STORAGE_FAILED
  INTERNAL_FAILED

  @@map("background_removal_outcome")
}
