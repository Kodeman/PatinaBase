# =============================================================================
# PATINA MEDIA SERVICE — CLOUDFLARE CONTAINER DOCKERFILE
# SERVICE_NAME is defaulted to `media` because Wrangler cannot pass
# --build-arg through its `containers[].image`
# pointer) builds the right service. Build context MUST be the monorepo root
# (see infra/media-svc-worker/wrangler.jsonc `image_build_context: "../../"`).
# =============================================================================

# Which service to build — defaulted for the Cloudflare Container build path.
ARG SERVICE_NAME=media

# =============================================================================
# STAGE 1: Dependencies
# =============================================================================
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++
RUN corepack enable pnpm

WORKDIR /app

# Copy workspace config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# Copy package.json for all workspace packages the service depends on
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/cache/package.json ./packages/cache/
COPY packages/auth/package.json ./packages/auth/
COPY packages/agent-queue/package.json ./packages/agent-queue/

ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/package.json ./services/${SERVICE_NAME}/

# Copy Prisma schema so postinstall `prisma generate` succeeds
COPY services/${SERVICE_NAME}/prisma ./services/${SERVICE_NAME}/prisma

# Install build-time dependencies (Prisma and TypeScript) in the dependency stage.
ENV NODE_ENV=development
RUN pnpm install --frozen-lockfile --filter @patina/${SERVICE_NAME}...

# =============================================================================
# STAGE 2: Builder
# =============================================================================
FROM node:20-alpine AS builder
RUN corepack enable pnpm

WORKDIR /app

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/types/node_modules ./packages/types/node_modules
COPY --from=deps /app/packages/utils/node_modules ./packages/utils/node_modules
COPY --from=deps /app/packages/cache/node_modules ./packages/cache/node_modules
COPY --from=deps /app/packages/auth/node_modules ./packages/auth/node_modules
COPY --from=deps /app/packages/agent-queue/node_modules ./packages/agent-queue/node_modules

ARG SERVICE_NAME
COPY --from=deps /app/services/${SERVICE_NAME}/node_modules ./services/${SERVICE_NAME}/node_modules

# Copy workspace config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.json ./

# Copy shared packages source
COPY packages/types/ ./packages/types/
COPY packages/utils/ ./packages/utils/
COPY packages/cache/ ./packages/cache/
COPY packages/auth/ ./packages/auth/
COPY packages/agent-queue/ ./packages/agent-queue/

# Copy service source
COPY services/${SERVICE_NAME}/ ./services/${SERVICE_NAME}/

# Build shared packages first
RUN pnpm --filter @patina/types build 2>/dev/null || true
RUN pnpm --filter @patina/utils build 2>/dev/null || true
RUN pnpm --filter @patina/cache build 2>/dev/null || true
RUN pnpm --filter @patina/auth build 2>/dev/null || true

# Generate Prisma client
RUN cd services/${SERVICE_NAME} && npx prisma generate

# Build the service
RUN pnpm --filter @patina/${SERVICE_NAME} build

# Use pnpm deploy to create a self-contained production directory
# This resolves all pnpm symlinks into a flat node_modules that survives Docker COPY
RUN pnpm --filter @patina/${SERVICE_NAME} deploy /app/deployed --prod

# Copy built shared packages into deployed node_modules
RUN cp -r packages/types/dist deployed/node_modules/@patina/types/dist 2>/dev/null || true && \
    cp -r packages/utils/dist deployed/node_modules/@patina/utils/dist 2>/dev/null || true && \
    cp -r packages/cache/dist deployed/node_modules/@patina/cache/dist 2>/dev/null || true && \
    cp -r packages/auth/dist deployed/node_modules/@patina/auth/dist 2>/dev/null || true

# =============================================================================
# STAGE 3: Production
# =============================================================================
FROM node:20-alpine AS runner

RUN apk add --no-cache tini openssl
WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nestjs && \
    adduser --system --uid 1001 nestjs

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

# Build version stamping (read at runtime by the /version endpoint).
# Runner stage only — keeps the per-commit SHA out of the cacheable build layers.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG APP_VERSION=1.0.0
ENV BUILD_SHA=${GIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}
ENV APP_VERSION=${APP_VERSION}

# Create writable logs directory for Winston file transports
RUN mkdir -p /app/logs && chown nestjs:nestjs /app/logs

# Copy the self-contained deployment (flat node_modules, no symlinks)
COPY --from=builder --chown=nestjs:nestjs /app/deployed/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nestjs /app/deployed/package.json ./package.json

# Copy built dist from the service directory (pnpm deploy doesn't copy build output)
COPY --from=builder --chown=nestjs:nestjs /app/services/${SERVICE_NAME}/dist ./dist

# Copy Prisma generated client into dist (imports resolve to dist/generated/prisma-client)
COPY --from=builder --chown=nestjs:nestjs /app/services/${SERVICE_NAME}/src/generated ./dist/generated

# Copy Prisma schema
COPY --from=builder --chown=nestjs:nestjs /app/services/${SERVICE_NAME}/prisma ./prisma

# Copy entrypoint script (creates Prisma schema before starting app)
COPY --chown=nestjs:nestjs infra/nestjs-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER nestjs

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/entrypoint.sh"]
