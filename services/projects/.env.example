# Application
NODE_ENV=development
PORT=3016
SERVICE_NAME=projects

# Database — Unified Supabase PostgreSQL
# All services share the same Supabase Postgres, isolated by search_path schema
DATABASE_URL="postgresql://postgres:your-super-secret-password@localhost:54322/postgres?schema=svc_projects&connection_limit=20&pool_timeout=20"
DIRECT_URL="postgresql://postgres:your-super-secret-password@localhost:54322/postgres?schema=svc_projects"

# Production Cloudflare Container: use the Strata Supavisor pooler
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SUPABASE_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?schema=svc_projects&pgbouncer=true&connection_limit=10
# DIRECT_URL=postgresql://postgres:SUPABASE_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=svc_projects

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Local dev default matches docker-compose.yml: patina_redis_password
REDIS_PASSWORD=patina_redis_password

# Production Redis is configured out of band for the Cloudflare Container.

# Inter-service communication (retained NestJS services only)
ORDERS_SERVICE_URL=http://localhost:3015
MEDIA_SERVICE_URL=http://localhost:3014

# Production service bindings are configured in the Cloudflare Worker unit.

# CORS Configuration
# SECURITY: Restrict CORS to trusted domains only in production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Production:
# CORS_ORIGINS=https://app.patina.cloud,https://admin.patina.cloud,https://client.patina.cloud

# Security - Supabase JWT Authentication
# The JWT secret from your Supabase instance (found in supabase/config.toml or dashboard)
# For local dev with `supabase start`, this is the default:
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Legacy alias (will fall back to this if SUPABASE_JWT_SECRET is not set)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Supabase Realtime — server-side broadcast of project events.
# RealtimeBroadcasterService POSTs to <SUPABASE_URL>/realtime/v1/api/broadcast
# with the service-role key. Without both, realtime events are dropped (logged).
# Also required by @patina/auth to scope every token issuer. Supabase Cloud
# derives the JWKS endpoint from `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`
# unless SUPABASE_JWKS_URL is set directly.
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Production: SUPABASE_URL=https://<project-ref>.supabase.co
# If Realtime traffic uses a proxy URL, set the real JWT issuer separately:
# Production: SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Logging
LOG_LEVEL=debug
