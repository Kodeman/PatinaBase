# Patina scan-pipeline worker — environment file.
# Copy to /etc/patina/scan-worker.env (mode 0600, owned by the `patina` user).
# Everything about a worker comes from this file: identity, stages, cadence,
# concurrency, GPU posture, and its one credential. A cloud burst worker is the
# SAME package with a different env file (design §3, R108.4/R109.1).

# ── Required (no default — the worker refuses to start without these) ─────────
WORKER_ID=homelab-1
SUPABASE_URL=https://bkvcixdmuyejfzcijpdg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service-role JWT — server-side only, never a client

# ── Stages this worker claims ─────────────────────────────────────────────────
# Subset of: ingest,solve,drawings (CPU, live) + refine,fuse,splat,present (P2;
# refine/fuse/splat are GPU). A CPU box runs the CPU stages; a P2 GPU box built
# with `install.sh --gpu` lists the GPU stages, e.g.:
#   STAGES=ingest,refine,fuse,splat,present
# claim_agent_tasks filters by exactly this.
STAGES=ingest,solve,drawings

# ── Cadence / concurrency ─────────────────────────────────────────────────────
POLL_SECONDS=5
MAX_CONCURRENT=2
# 60 min: a 500 MB bundle on a slow link can outrun a shorter lease and get
# re-claimed mid-download. The worker's lost-race guard covers the rare overrun.
VISIBILITY_TIMEOUT=60 minutes
MAX_ATTEMPTS=5

# ── GPU posture ───────────────────────────────────────────────────────────────
# auto = detect + report a CUDA device; off = never touch it. When STAGES lists a
# GPU stage (refine/fuse/splat), `doctor`'s gpu (+ torch-cuda for splat) checks
# become REQUIRED — a missing GPU is then a failure, not a warning. GPU=off while
# a GPU stage is listed is a contradiction doctor flags.
GPU=auto

# ── Storage / scratch ─────────────────────────────────────────────────────────
ROOM_SCANS_BUCKET=room-scans
WORK_DIR=/var/lib/patina/scan-work
RETENTION_HOURS=48

# ── HTTP / logging ────────────────────────────────────────────────────────────
HTTP_TIMEOUT_S=30
LOG_LEVEL=info
