# Patina scan-pipeline worker — environment file.
# Copy to /etc/patina/scan-worker.env (mode 0600, owned by root:root). The system
# manager (PID 1) reads EnvironmentFile before starting the unprivileged worker;
# the `patina` process does not need direct access to the service-role key.
# Everything about a worker comes from this file: readable identity prefix,
# stages, cadence, concurrency, GPU posture, and its one credential. Runtime
# claim identities append a fresh UUID to WORKER_ID for lease isolation. A
# cloud burst worker is the SAME package with a different env file (design §3,
# R108.4/R109.1).

# ── Required (no default — the worker refuses to start without these) ─────────
# Readable prefix only; the worker appends a UUID to every claim batch.
WORKER_ID=homelab-1
SUPABASE_URL=https://bkvcixdmuyejfzcijpdg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service-role JWT — server-side only, never a client

# ── Stages this worker claims ─────────────────────────────────────────────────
# Subset of: ingest,solve,drawings (CPU, live) + refine,fuse,splat,present (P2;
# refine/fuse/splat are GPU). A CPU box runs the CPU stages. Keep this worker's
# live claim set limited to registered handlers. For item-3 GPU preflight, use
# the README's /run-only doctor-only `patina-scan-worker-doctor` procedure while
# stopped. The persistent env is never edited; never start the queue worker with
# temporary GPU stage names. Do not enable them until items 4–7 land.
# claim_agent_tasks filters by exactly this.
STAGES=ingest,solve,drawings

# ── Cadence / concurrency ─────────────────────────────────────────────────────
POLL_SECONDS=5
MAX_CONCURRENT=2
# 60 min: a 500 MB bundle on a slow link can outrun a shorter lease and get
# re-claimed mid-download. The worker's lost-race guard covers the rare overrun.
# Use one positive seconds/minutes/hours value only. The worker converts this
# exact interval into a conservative monotonic expiry at claim-request start.
VISIBILITY_TIMEOUT=60 minutes
MAX_ATTEMPTS=5

# ── GPU posture ───────────────────────────────────────────────────────────────
# auto = detect + report a CUDA device; off = never touch it. When STAGES lists a
# GPU stage (refine/fuse/splat), `doctor`'s stage-scoped checks become REQUIRED:
# refine = COLMAP command set + pycolmap; fuse = Open3D CUDA availability +
# trimesh; splat = nvcc + torch cu118/sm_75 CUDA operation + a public gsplat
# rasterization. A missing GPU is then a failure, not a warning. GPU=off while a
# GPU stage is listed is a contradiction doctor flags.
GPU=auto

# ── Storage / scratch ─────────────────────────────────────────────────────────
ROOM_SCANS_BUCKET=room-scans
WORK_DIR=/var/lib/patina/scan-work
RETENTION_HOURS=48

# ── HTTP / logging ────────────────────────────────────────────────────────────
HTTP_TIMEOUT_S=30
LOG_LEVEL=info

# ── Storage backend / cutover (W3-C, storage_backend.py) ───────────────────────
# All commented out: the default (supabase, no shadow) is today's live behavior
# and this section has no effect on the worker until the originals-cutover wave
# wires build_storage_backend into Context.storage. Uncommenting SCAN_STORAGE_*
# here only affects code that explicitly calls build_storage_backend() directly.
# SCAN_STORAGE_BACKEND=supabase          # supabase | r2 (r2 needs the `r2` extra)
# SCAN_STORAGE_SHADOW=r2                 # unset | r2 — must differ from the backend above
# SCAN_STORAGE_SHADOW_LEDGER_PATH=/var/lib/patina/scan-work/shadow-storage-ledger.jsonl
# SCAN_STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SCAN_STORAGE_R2_BUCKET=patina-staging-media-artifacts-us
# SCAN_STORAGE_R2_ACCESS_KEY_ID=
# SCAN_STORAGE_R2_SECRET_ACCESS_KEY=
# SCAN_WORKER_STORAGE_TOKEN=             # optional narrower Storage credential; falls back to SUPABASE_SERVICE_ROLE_KEY
