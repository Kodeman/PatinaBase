// Patina Orders & Payments - Prisma Schema
// Database: PostgreSQL 16 on OCI

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cart {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @map("user_id")
  sessionToken   String?   @map("session_token") // for anonymous carts
  status         String    @default("active") // active|expired|converted|abandoned
  currency       String    @default("USD")
  discountCode   String?   @map("discount_code")
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  subtotal       Decimal   @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal   @default(0) @map("tax_total") @db.Decimal(10, 2)
  shippingTotal  Decimal   @default(0) @map("shipping_total") @db.Decimal(10, 2)
  total          Decimal   @default(0) @db.Decimal(10, 2)
  metadata       Json?
  expiresAt      DateTime? @map("expires_at")
  convertedAt    DateTime? @map("converted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Address references
  shippingAddressId String? @map("shipping_address_id") @db.Uuid
  billingAddressId  String? @map("billing_address_id") @db.Uuid

  items           CartItem[]
  discount        Discount?  @relation(fields: [discountCode], references: [code])
  shippingAddress Address?   @relation("CartShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?   @relation("CartBillingAddress", fields: [billingAddressId], references: [id])

  @@index([userId, status])
  @@index([sessionToken])
  @@index([status, expiresAt])
  @@index([discountCode])
  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  name          String
  sku           String?
  qty           Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  currency      String   @default("USD")
  discountAlloc Decimal? @map("discount_alloc") @db.Decimal(10, 2) // per-line discount allocation
  taxAmount     Decimal? @map("tax_amount") @db.Decimal(10, 2)
  snapshot      Json? // product/variant snapshot at add time
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Discount {
  id                 String    @id @default(uuid()) @db.Uuid
  code               String    @unique
  name               String
  description        String?
  kind               String // percent|fixed|bogo
  value              Decimal   @db.Decimal(10, 2) // percent e.g. 10.00; fixed e.g. 25.00
  currency           String?   @default("USD")
  minPurchase        Decimal?  @map("min_purchase") @db.Decimal(10, 2)
  maxDiscount        Decimal?  @map("max_discount") @db.Decimal(10, 2)
  usageLimit         Int?      @map("usage_limit") // total usage limit
  usageCount         Int       @default(0) @map("usage_count")
  perUserLimit       Int?      @map("per_user_limit") // per-user limit
  eligibleProducts   String[]  @map("eligible_products") // product IDs
  eligibleCategories String[]  @map("eligible_categories") // category IDs
  startsAt           DateTime? @map("starts_at")
  endsAt             DateTime? @map("ends_at")
  rules              Json? // additional eligibility rules
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by")

  carts Cart[]

  @@index([code, active])
  @@index([startsAt, endsAt])
  @@map("discounts")
}

model Order {
  id                String  @id @default(uuid()) @db.Uuid
  orderNumber       String  @unique @map("order_number")
  userId            String  @map("user_id")
  organizationId    String? @map("organization_id") @db.Uuid
  cartId            String? @map("cart_id")
  status            String  @default("created") // created|paid|processing|fulfilled|closed|refunded|canceled
  paymentStatus     String  @default("pending") @map("payment_status") // pending|authorized|captured|refunded|failed|canceled|partially_refunded
  fulfillmentStatus String  @default("unfulfilled") @map("fulfillment_status") // unfulfilled|partial|fulfilled
  currency          String  @default("USD")
  subtotal          Decimal @db.Decimal(10, 2)
  discountTotal     Decimal @default(0) @map("discount_total") @db.Decimal(10, 2)
  taxTotal          Decimal @default(0) @map("tax_total") @db.Decimal(10, 2)
  shippingTotal     Decimal @default(0) @map("shipping_total") @db.Decimal(10, 2)
  total             Decimal @db.Decimal(10, 2)

  // Stripe references
  paymentIntentId   String? @unique @map("payment_intent_id")
  checkoutSessionId String? @unique @map("checkout_session_id")
  customerId        String? @map("customer_id") // Stripe customer ID

  // Addresses
  shippingAddressId String? @map("shipping_address_id") @db.Uuid
  billingAddressId  String? @map("billing_address_id") @db.Uuid

  // Shipping
  shippingMethod String? @map("shipping_method") // standard|express|overnight

  // Tax
  taxLines Json? @map("tax_lines") // [{jurisdiction, rate, amount}]

  // Immutable snapshot
  snapshot Json // complete order snapshot

  // Notes and metadata
  customerNotes String? @map("customer_notes")
  internalNotes String? @map("internal_notes")
  metadata      Json?

  // Timestamps
  paidAt      DateTime? @map("paid_at")
  fulfilledAt DateTime? @map("fulfilled_at")
  closedAt    DateTime? @map("closed_at")
  canceledAt  DateTime? @map("canceled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  shipments       Shipment[]
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])

  @@index([userId, status])
  @@index([organizationId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
  @@index([paymentIntentId])
  @@index([checkoutSessionId])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  name          String
  sku           String?
  qty           Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  currency      String   @default("USD")
  taxLines      Json?    @map("tax_lines") // [{jurisdiction, rate, amount}]
  discountAlloc Decimal? @map("discount_alloc") @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  snapshot      Json? // product/variant snapshot
  metadata      Json?

  // Fulfillment tracking
  qtyFulfilled Int @default(0) @map("qty_fulfilled")
  qtyRefunded  Int @default(0) @map("qty_refunded")

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id       String  @id @default(uuid()) @db.Uuid
  orderId  String  @map("order_id") @db.Uuid
  provider String  @default("stripe")
  status   String  @default("pending") // pending|succeeded|failed|canceled|refunded
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Stripe references
  paymentIntentId String? @map("payment_intent_id")
  chargeId        String? @unique @map("charge_id")
  paymentMethodId String? @map("payment_method_id")

  // Details
  last4   String?
  brand   String? // visa|mastercard|amex|etc
  country String?

  // Risk & Fraud
  riskScore Int?    @map("risk_score")
  riskLevel String? @map("risk_level") // normal|elevated|highest

  // Metadata
  raw            Json? // full Stripe response
  metadata       Json?
  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentIntentId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id       String  @id @default(uuid()) @db.Uuid
  orderId  String  @map("order_id") @db.Uuid
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")
  reason   String? // duplicate|fraudulent|requested_by_customer
  status   String  @default("pending") // pending|succeeded|failed|canceled
  provider String  @default("stripe")

  // Stripe references
  providerRefundId String? @unique @map("provider_refund_id")
  chargeId         String? @map("charge_id")
  paymentIntentId  String? @map("payment_intent_id")

  // Details
  description String?
  metadata    Json?
  raw         Json? // full Stripe response

  // Timestamps
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") // admin user who initiated

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRefundId])
  @@index([status])
  @@map("refunds")
}

model Shipment {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  shipmentNumber String? @unique @map("shipment_number")
  carrier        String? // USPS|FedEx|UPS
  service        String? // Priority|Ground|Express
  trackingNumber String? @map("tracking_number")
  trackingUrl    String? @map("tracking_url")
  status         String  @default("pending") // pending|in_transit|out_for_delivery|delivered|exception|returned
  method         String? // standard|express|overnight

  // Items in this shipment
  items Json // [{orderItemId, qty}]

  // Carrier Integration
  carrierShipmentId    String? @map("carrier_shipment_id") // EasyPost shipment ID
  labelUrl             String? @map("label_url") // URL to shipping label PDF/PNG
  labelFormat          String? @map("label_format") // PDF|PNG|ZPL
  labelSize            String? @map("label_size") // 4x6|4x8
  commercialInvoiceUrl String? @map("commercial_invoice_url") // For international shipments
  rateId               String? @map("rate_id") // Carrier rate ID used for purchase

  // Tracking
  trackingStatus    String? @map("tracking_status") // Carrier-specific status
  trackingEvents    Json?   @map("tracking_events") // Array of tracking events
  publicTrackingUrl String? @map("public_tracking_url") // Public tracking URL

  // Addresses (stored as JSON for historical record)
  fromAddress Json?   @map("from_address") // Address snapshot
  toAddress   Json?   @map("to_address") // Address snapshot
  addressId   String? @map("address_id") @db.Uuid // Reference to Address table

  // Parcel details
  parcel Json? // {length, width, height, weight, predefinedPackage}

  // Costs
  cost     Decimal? @db.Decimal(10, 2)
  currency String?  @default("USD")

  // Timestamps
  estimatedDelivery DateTime? @map("estimated_delivery")
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")

  // Notes and metadata
  notes    String?
  metadata Json? // Additional carrier-specific data

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@index([carrier])
  @@index([carrierShipmentId])
  @@map("shipments")
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @map("user_id")
  kind      String // shipping|billing
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  company   String?
  line1     String
  line2     String?
  city      String
  region    String? // state/province
  postal    String
  country   String // ISO-3166-1 alpha-2
  phone     String?

  // Validation
  verified Boolean @default(false)

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ordersShipping Order[]    @relation("ShippingAddress")
  ordersBilling  Order[]    @relation("BillingAddress")
  cartsShipping  Cart[]     @relation("CartShippingAddress")
  cartsBilling   Cart[]     @relation("CartBillingAddress")
  shipments      Shipment[]

  @@index([userId])
  @@map("addresses")
}

model Reconciliation {
  id     String @id @default(uuid()) @db.Uuid
  jobId  String @unique @map("job_id")
  status String @default("running") // running|completed|failed
  window Json // {start, end} timestamps

  // Statistics
  stripeCount   Int @default(0) @map("stripe_count")
  patinaCount   Int @default(0) @map("patina_count")
  matchedCount  Int @default(0) @map("matched_count")
  discrepancies Int @default(0)

  // Results
  orphanStripe Json? @map("orphan_stripe") // Stripe payments not in Patina
  orphanPatina Json? @map("orphan_patina") // Patina orders not in Stripe
  mismatches   Json? // Amount/status mismatches

  // Resolution
  resolutionNotes String?   @map("resolution_notes")
  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([status])
  @@index([startedAt])
  @@map("reconciliations")
}

model IdempotencyKey {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  endpoint   String
  statusCode Int?     @map("status_code")
  response   Json?
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") // cart|order|payment|refund|shipment
  entityId   String   @map("entity_id")
  action     String // created|updated|deleted|status_changed|etc
  actor      String? // user ID or system
  actorType  String?  @map("actor_type") // user|system|admin|webhook
  changes    Json? // diff of changes
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Outbox Pattern for Event Publishing (Transactional Outbox)
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String // e.g., "order.created", "order.paid", "order.fulfilled"
  payload     Json // Event payload
  headers     Json? // Additional headers (traceId, etc.)
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")

  @@index([type, published])
  @@index([createdAt])
  @@map("outbox_events")
}
